{
  "name": "kirtan-next",
  "version": "2.3.0",
  "private": true,
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3333",
    "build": "next build --webpack",
    "build:prod": "env-cmd -f env/.env.prod pnpm run build",
    "build:test": "env-cmd -f env/.env.dev pnpm run build",
    "build:all": "pnpm run install:fetch && pnpm run install:post-fetch && pnpm run validation && next build --webpack",
    "start": "serve out -p 3334",
    "postbuild": "node scripts/postbuild.js",
    "install:fetch": "node scripts/shared/installShared.js && node scripts/shared/fetchTelegraphPages.js",
    "install:post-fetch": "node scripts/processSrc.js",
    "validation": "node scripts/validate.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit --pretty true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "classnames": "^2.3.1",
    "next": "^16.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-loading-skeleton": "^3.5.0",
    "react-qr-code": "^2.0.18",
    "react-responsive-modal": "^7.1.0",
    "schema-dts": "^1.1.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "baseline-browser-mapping": "^2.10.33",
    "chalk": "^4.1.2",
    "env-cmd": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "lodash.deburr": "^4.1.0",
    "prettier": "^2.8.8",
    "sass": "^1.93.2",
    "serve": "^14.2.5",
    "typescript": "^5"
  }
}
