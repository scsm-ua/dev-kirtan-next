der":9,"songsCount":23}],"nav":{"55":{"prev":{"path":"/en-2022/udilo-aruna-puraba-bhage/","title":"Aruṇodoya-kīrtan 1"},"next":{"path":"/en-2022/samsara-davanala-lidha-loka/","title":"Śrī Śrī Gurvāṣṭaka"}}},"song":{"meta":{"page":55,"first_line":"jīv jāgo, jīv jāgo, gaurāchā̐da bole","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Aruṇodoya-kīrtan"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Part 2"],"verses":[{"number":"1","text":["jīv jāgo, jīv jāgo, gaurāchā̐da bole","kota nidrā jāo māyā-piśāchīra kole"],"translation":["Lord Gaurāṅga calls, “Wake up, sleeping souls! Wake up, sleeping souls! You have slept so long in the lap of the witch Māyā.”"],"isLong":false},{"number":"2","text":["bhajibo boliyā ese saṁsāra-bhitore","bhuliyā rohile tumi avidyāra bhore"],"translation":["“You came into this world saying, ‘O my Lord, I will certainly worship You’, but having forgotten this promise, you have remained in great ignorance.”"],"isLong":false},{"number":"3","text":["tomāre loite āmi hoinu avatāra","āmi vinā bandhu āra ke āche tomāra"],"translation":["“I have descended just to save you. Other than Myself, who else is your friend?”"],"isLong":false},{"number":"4","text":["enechi auṣadhi māyā nāśibāro lāgi’","hari-nāma mahā-mantra lao tumi māgi’"],"translation":["“I have brought the medicine for destroying the illusion of *māyā*. Now pray for this Hari-nāma-mahāmantra and take it.”"],"isLong":false},{"number":"5","text":["bhakativinoda prabhura-charaṇe poḍiyā","sei hari-nāma-mantra loilo māgiyā"],"translation":["Ṭhākur Bhakti Vinod fell at the lotus feet of Lord Gaurāṅga, and after begging for the Holy Name he received that *mahāmantra*."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/jiv-jago-jiv-jago-gaurachanda-bole/","description":"Aruṇodoya-kīrtan — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Aruṇodoya-kīrtan. Part 2 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"jiv-jago-jiv-jago-gaurachanda-bole"}}