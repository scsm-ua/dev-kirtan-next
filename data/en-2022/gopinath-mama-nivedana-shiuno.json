{"build":"4b9ed06@15/11/2026, 10:40:41","data":{"book":{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":8,"hidden":true,"songsCount":166},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":71},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":7,"songsCount":80},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":8,"hidden":true,"songsCount":166}],"nav":{"200":{"prev":{"path":"/en-2022/kobe-hobe-bolo-se-dina-amar/","title":"Kobe ho’be bolo"},"next":{"path":"/en-2022/gopinath-ghuchao-samsara-jvala/","title":"Nivedana 2"}}},"song":{"meta":{"page":200,"first_line":"gopīnāth, mama nivedana śuno","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Nivedana"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Part 1"],"verses":[{"number":"1","text":["gopīnāth,    mama nivedana śuno","viṣoyī durjana,    sadā kāma-rata,","    kichu nāhi mora guṇa"],"translation":["Oh Gopīnāth, Lord of the gopīs, please hear my submission. I am a wicked materialist, always addicted to worldly desires, and no good qualities do I possess."],"isLong":false},{"number":"2","text":["gopīnāth,    āmāra bharasā tumi","tomāra charaṇe,    loinu śaraṇa,","    tomāra kiṅkara āmi"],"translation":["Oh Gopīnāth, You are my only hope, and therefore I have taken shelter at Your lotus feet. I am now Your eternal servant."],"isLong":false},{"number":"3","text":["gopīnāth,    kemone śodhive more","nā jāni bhakati,    karme jaḍamati,","    poḍechi saṁsāra ghore"],"translation":["Oh Gopīnāth, how will You purify me? I do not know what devotion is, and my materialistic mind is absorbed in fruitive work. I have fallen into this dark and perilous worldly existence."],"isLong":false},{"number":"4","text":["gopīnāth,    sakali tomāra māyā","nāhi mama bala,    jñāna sunirmala,","    svādhīna nahe e kāyā"],"translation":["Oh Gopīnāth, everything here is Your illusory energy. I have no strength or transcendental knowledge, and this body of mine is not independent and free from the control of material nature."],"isLong":false},{"number":"5","text":["gopīnāth,    niyata charaṇe sthāna","māge e pāmara,    kā̐diyā kā̐diyā,","    karahe karuṇā dāna"],"translation":["Oh Gopīnāth, this sinner, who is weeping and weeping, begs for an eternal place at Your divine feet. Please give him Your mercy."],"isLong":false},{"number":"6","text":["gopīnāth,    tumi to sakali pāro","durjane tārite,    tomāra śakati,","    ke āche pāpīra āro"],"translation":["Oh Gopīnāth, You are able to do anything, and therefore You have the power to deliver all sinners. Who is there that is more of a sinner than myself?"],"isLong":false},{"number":"7","text":["gopīnāth,    tumi kṛpā-pārābāra","jīvera kāraṇe,    āsiyā prapañche,","    līlā koile subistāra"],"translation":["Oh Gopīnāth, You are the ocean of mercy. Having come into this phenomenal world, You expand Your divine Pastimes for the sake of the fallen souls."],"isLong":false},{"number":"8","text":["gopīnāth,    āmi ki doṣera doṣī","asura sakala,    pāilo charaṇa,","    vinoda thākilo bosi"],"translation":["Oh Gopīnāth, I am so sinful that although all the demons attained Your lotus feet, Bhakti Vinod has remained in worldly existence."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/krsnachaitanya-das/37-gopinath-mama-nivedana-suna-4","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.R. Madhusudan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-gopinath-1","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Srila B.R. Madhusudan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-gopinath","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/gopinath-mama-nivedana-suno","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/gopinath-mama-nivedana-shiuno/","description":"Nivedana — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Nivedana. by Śrīla Bhakti Vinod Ṭhākur. Part 1 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"gopinath-mama-nivedana-shiuno"}}