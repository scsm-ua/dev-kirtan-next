itle":"He deva bhavantaṁ vande"}}},"song":{"meta":{"page":241,"first_line":"rādhe jaya jaya mādhava-dayite","author":"Śrīla Rūpa Goswāmī"},"title":["Śrī Rādhikā-stava"],"author":["by Śrīla Rūpa Goswāmī"],"verses":[{"number":"1","text":["rādhe jaya jaya mādhava-dayite","gokula-taruṇī-maṇḍala-mahite"],"translation":["O Rādhā! O beloved of Mādhava! O You who are worshiped by all the young girls of Gokula! All glories unto You! All glories unto You!"],"isLong":false},{"number":"2","text":["dāmodara-rati-vardhana-veśe","hari-niṣkuṭa-vṛndā-vipineśe"],"translation":["You who dress Yourself in such a way as to increase Lord Dāmodar’s love and attachment for You! O Queen of Vṛndāvan, which is the pleasure grove of Lord Hari!"],"isLong":false},{"number":"3","text":["vṛṣabhānūdadhi-nava-śaśi-lekhe","lalitā-sakhi guṇa-ramita-viśākhe"],"translation":["O new moon who has arisen from the ocean of King Vṛṣabhānu! O friend of Lalitā! O You who make Viśākhā loyal to You due to Your wonderful qualities of friendliness, kindness, and faithfulness to Krishna!"],"isLong":false},{"number":"4","text":["karuṇāṁ kuru moyi karuṇā-bhorite","sanaka-sanātana-varṇita-charite"],"translation":["O You who are filled with compassion! O You whose divine characteristics are described by the great sages Sanaka and Sanātan! O Rādhā, please be merciful to me!"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.R. Sridhar Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-radhe-jaya","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/acharyamaharaj/sri-radhika-stava","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Srila B.P. Janardan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/janardan-maharaj-radhe-jaya","personSlug":"srila-b-p-janardan-maharaj"},{"title":"Srila B.S. Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/goswami-maharaj-radhe-jaya","personSlug":"srila-b-s-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/radhe-jaya-jaya","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-sri-radhika-stava","personSlug":"bhakti-lalita-devi"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/radhe-jaya-jaya-madhava-dayite/","description":"Śrī Rādhikā-stava — a Vaiṣṇava song by Śrīla Rūpa Goswāmī with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Śrī Rādhikā-stava. by Śrīla Rūpa Goswāmī | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"radhe-jaya-jaya-madhava-dayite"}}