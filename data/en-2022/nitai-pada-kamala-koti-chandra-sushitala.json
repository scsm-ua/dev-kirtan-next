le":"Sva-Niṣṭha"}}},"song":{"meta":{"page":128,"first_line":"nitāi-pada-kamala, koṭī-chandra-suśītala","author":"Śrīla Narottam Dās Ṭhākur"},"title":["Manaḥ-Śikṣā"],"author":["by Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["nitāi-pada-kamala,    koṭī-chandra-suśītala,","    je chāyāya jagata juḍāy","heno nitāi bine bhāi,    rādhā-kṛṣṇa pāite nāi,","    dṛḍha kori dharo nitāira pāya"],"translation":["The holy lotus feet of Nitāi,\\","&nbsp;&nbsp;&nbsp;&nbsp;cooling like ten million moons —\\","In the shade of which\\","&nbsp;&nbsp;&nbsp;&nbsp;the world gains soothing relief;\\","Without that Nitāi, O brother,\\","&nbsp;&nbsp;&nbsp;&nbsp;No one can reach Rādhā and Krishna —\\","Clasp His lotus feet with full conviction."],"isLong":false},{"number":"2","text":["se sambandha nāhi jāra,    vṛthā janma gelo tāra,","    sei paśu boḍo durāchāra","nitāi nā bolilo mukhe,    majilo saṁsāra-sukhe,","    vidyā-kule ki koribe tāra"],"translation":["One who never got His connection,\\","&nbsp;&nbsp;&nbsp;&nbsp;passed his life in vain —\\","Such an animal is so very wicked;\\","He whose mouth never uttered ‘Nitāi,’\\","&nbsp;&nbsp;&nbsp;&nbsp;merged in mundane pleasures —\\","How can his aristocratic lineage save him?"],"isLong":false},{"number":"3","text":["ahaṅkāre matta hoiyā, nitāi-pada pāsariyā,","    asatyere satya kori māni","nitāiyer karuṇā habe, vraje rādhā-kṛṣṇa pābe,","    dharo nitāiyer charaṇ du’ khāni"],"translation":["Maddened with pride,\\","&nbsp;&nbsp;&nbsp;&nbsp;forgetting the lotus feet of Nitāi —\\","I embrace untruth as truth;\\","But when Nitāi gives His Grace\\","&nbsp;&nbsp;&nbsp;&nbsp;you’ll reach Rādhā and Krishna in Vraja —\\","O embrace the lotus feet of Nitāi!"],"isLong":false},{"number":"4","text":["nitāiyer charaṇa satya, tā̐hāra sevaka nitya,","    nitāi-pada sadā kara āśa","narottama boḍo duḥkhī, nitāi more kara sukhī","    rākho rāṅgā-charaṇera pāśa"],"translation":["The lotus feet of Nitāi are truth,\\","&nbsp;&nbsp;&nbsp;&nbsp;His servitors are eternal —\\","Ever aspire for the shelter of His feet;\\","Narottam is very sad — O Nitāi make me happy —\\","Please keep me at Your lovely lotus feet!"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-nitai-pada-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-nitai-pada","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/acharya-maharaj-nitay-pada","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/nitai-pada-kamala","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/nitai-pada-kamala-koti-chandra-sushitala/","description":"Manaḥ-Śikṣā — a Vaiṣṇava song by Śrīla Narottam Dās Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Manaḥ-Śikṣā. by Śrīla Narottam Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"nitai-pada-kamala-koti-chandra-sushitala"}}