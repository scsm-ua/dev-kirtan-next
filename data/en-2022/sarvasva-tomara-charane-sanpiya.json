hor":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Sarvasva tomāra"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["sarvasva tomāra,    charaṇe sa̐piyā,","    poḍechi tomāra ghore","tumi to’ ṭhākur,    tomāra kukkur,","    boliyā jānaho more"],"translation":["Now taking all that I possess and surrendering it unto Your lotus feet, O Lord, I throw myself down before Your house. You are the master of the house; kindly consider me Your own dog."],"isLong":false},{"number":"2","text":["bā̐dhiyā nikaṭe,    āmāre pālibe,","    rohibo tomāra dvāre","pratīpa-jonere,    āsite nā dibo,","    rākhibo goḍera pāre"],"translation":["Chaining me nearby, You will maintain me, and I shall lie at Your doorstep. I will not allow Your enemies to enter, but will keep them outside the bounds of the surrounding moat."],"isLong":false},{"number":"3","text":["tava nija-jana,    prasād seviyā,","    uchiṣṭa rākhibe jāhā","āmāra bhojana,    parama-ānande,","    prati-dina hobe tāhā"],"translation":["Whatever food remnants Your devotees leave behind after honouring Your prasād will be my daily sustenance. I will feast on those remnants in great bliss."],"isLong":false},{"number":"4","text":["bosiyā śuiyā,    tomāra charaṇa,","    chintibo satata āmi","nāchite nāchite,    nikaṭe jāibo,","    jokhona ḍākibe tumi"],"translation":["While sitting up or lying down, I will constantly meditate on Your lotus feet. Whenever You call me, I will immediately run to You and dance in rapture."],"isLong":false},{"number":"5","text":["nijera poṣaṇa,    kobhu nā bhāvibo,","    rohibo bhāvera bhore","bhakativinoda,    tomāra pālaka,","    boliyā varaṇa kore"],"translation":["I will never even think about arranging for my own nourishment, and will remain absorbed in ever cherishing love for my master. Bhakti Vinod now accepts You as his only maintainer."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.R. Sridhar Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-4","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Kamal Krishna Prabhu","embed_url":"https://soundcloud.com/jayasri-sound/19-sarvvasva-tomara","personSlug":"kamal-krishna-prabhu"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/sarvasva-tomara","personSlug":"manasa-krishna-prabhu"},{"title":"Sudarshan Prabhu","embed_url":"https://soundcloud.com/bharatimaharaj/sudarshan-prabhu-sarvasva","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/sarvasva-tomara-charane-sanpiya/","description":"Sarvasva tomāra — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Sarvasva tomāra. by Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"sarvasva-tomara-charane-sanpiya"}}