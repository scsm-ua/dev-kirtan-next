tmikā"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["(prabhu he!)","emona durmati,    saṁsāra bhitore,","    poḍiyā āchinu āmi","tava nija-jana,    kono mahājane,","    pāṭhāiyā dile tumi"],"translation":["A wicked mind brought me into this world, O Lord, but one of Your pure and elevated devotees has come to bring me out."],"isLong":false},{"number":"2","text":["dayā kori more,    patita dekhiyā,","    kohilo āmāre giyā","ohe dīna-jon,    śuno bhālo kathā","    ullasita ho’be hiyā"],"translation":["He saw me so fallen and wretched, took pity, and came to me saying, “O humbled soul, please listen to this good tiding, for it will gladden your heart.”"],"isLong":false},{"number":"3","text":["tomāre tārite,    śrī-kṛṣṇa-chaitanya,","    nabadvīpe avatār","tomā heno koto,    dīna hīna jone,","    korilena bhava-pār"],"translation":["“Śrī Krishna Chaitanya has appeared in the land of Nabadwīp to deliver you. He has safely conducted many miserable souls such as you across the sea of worldly existence.”"],"isLong":false},{"number":"4","text":["vedera pratijñā,    rākhibāra tore,","    rukma-varṇa vipra-suta","mahāprabhu nāme,    nadīyā mātāya,","    soṅge bhāi avadhūta"],"translation":["“To fulfil the promise of the Vedas, the son of a *brāhmaṇ*, bearing the Name Mahāprabhu of golden complexion, has descended with His brother, the avadhūt Nityānanda. Together They have overwhelmed all of Nadia with divine ecstasy."],"isLong":false},{"number":"5","text":["nanda suta jini,    chaitanya gosāi,","    nija-nāma kori’ dāna","tārilo jagat,    tumi-o jāiyā,","    loho nija-paritrāṇa"],"translation":["“Śrī Chaitanya, who is Krishna Himself, the son of Nanda, has saved the world by freely distributing His own Holy Name. Go also and receive your deliverance.”"],"isLong":false},{"number":"6","text":["se kathā śuniyā,    āsiyāchi, nātha!","    tomāra charaṇa-tole","bhakativinoda,    kā̐diyā kā̐diyā,","    āpana-kāhinī bole"],"translation":["O Lord, hearing those words, Bhakti Vinod has come weeping to the soles of Your lotus feet and tells the story of his life."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.R. Sridhar Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-7","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-emona-durmati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-emona-durmati","personSlug":"nabadwip-temple"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-emona","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-emona-1","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/acharya-maharaj-emona-durmati","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Srila B.S. Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/goswami-maharaj-emona-durmati","personSlug":"srila-b-s-goswami-maharaj"},{"title":"Kamal Krishna Prabhu","embed_url":"https://soundcloud.com/jayasri-sound/08-emana-durmati","personSlug":"kamal-krishna-prabhu"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/emona-durmati","personSlug":"manasa-krishna-prabhu"},{"title":"Caracas temple","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-emona-durmati","personSlug":"caracas-temple"},{"title":"Sudarshan Prabhu","embed_url":"https://soundcloud.com/bharatimaharaj/sudarshan-prabhu-dainyatmika","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/e