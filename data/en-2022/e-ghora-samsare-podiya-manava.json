or":["by Kālidās"],"verses":[{"number":"1","text":["e ghora saṁsāre,    poḍiyā mānava","    na pāya duḥkhera śeṣa","sādhu-saṅga kori,    hari bhaja jodi,","    tobe anta hoy kleśa"],"translation":["Fallen into this material world of birth and death, there is no end to a person’s unhappiness. Still, if they associate with devotees and worship Lord Hari, then all their sadness and suffering will come to an end."],"isLong":false},{"number":"2","text":["biṣoya anale,    jvaliche hṛdaya,","    anale boḍe anal","aparādha chāḍi’    loy kṛṣṇa-nāma,","    anale paḍaye jola"],"translation":["The heart burns in the fire of sense gratification and the fire burns more and more. Avoiding offences, chant the Holy Names of Lord Krishna, for that will pour water on the fire."],"isLong":false},{"number":"3","text":["nitāi chaitanya,    charaṇa-kamale,","    āśroya loilo jei","kālidās bole    jīvane maraṇe,","    āmāra āśroya sei"],"translation":["Kālidās says, “Anyone who has taken shelter of the lotus feet of Lord Chaitanya and Lord Nityānanda is my shelter in life and death.”"],"isLong":false}],"resources":{"audio":[{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/e-ghora-samsare","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/e-ghora-samsare-podiya-manava/","description":"E ghora saṁsare — a Vaiṣṇava song by Kālidās with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"E ghora saṁsare. by Kālidās | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"e-ghora-samsare-podiya-manava"}}