der":9,"songsCount":23}],"nav":{"45":{"prev":{"path":"/en-2022/jaya-jaya-gurudever-arati-ujjvala/","title":"Śrī Guru Ārati"},"next":{"path":"/en-2022/kali-kukkura-kadana-jadi-chao-he/","title":"Prabhāti Gīti"}}},"song":{"meta":{"page":45,"first_line":"jaya ‘guru-mahārāja’ jati-rājeśvara","author":"Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj"},"title":["Śrī Guru Ārati-stuti"],"author":["by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj"],"verses":[{"number":"1","text":["jaya ‘guru-mahārāja’ jati-rājeśvara","śrī-bhakti-rakṣaka deva-gosvāmī śrīdhara"],"translation":["All glory to you, ‘Guru Maharaj,’\\","&nbsp;&nbsp;&nbsp;&nbsp;Of sannyāsī kings, the Emperor:\\","The glorious Śrīla Bhakti Rakṣak\\","&nbsp;&nbsp;&nbsp;&nbsp;Dev-Goswami Śrīdhar."],"isLong":false},{"number":"2","text":["patita-pāvana-līlā vistāri’ bhuvane","nistārilā dīna-hīna āpāmara jane"],"translation":["Extending in this world your\\","&nbsp;&nbsp;&nbsp;&nbsp;Pastimes as saviour of the fallen,\\","You delivered all the suffering souls,\\","&nbsp;&nbsp;&nbsp;&nbsp;including the most forsaken."],"isLong":false},{"number":"3","text":["tomāra karuṇāghana murati heriyā","preme bhāgyavāna jīva poḍe murachiyā"],"translation":["Beholding your holy form\\","&nbsp;&nbsp;&nbsp;&nbsp;of concentrated mercy\\","The fortunate souls fall in a swoon\\","&nbsp;&nbsp;&nbsp;&nbsp;of divine love’s ecstasy."],"isLong":false},{"number":"4","text":["sudīrgha supībya deho divya-bhāvāśray","divya-jñāna dīpta-netra divya-jyotirmoy"],"translation":["Your lofty form full of divine emotion\\","&nbsp;&nbsp;&nbsp;&nbsp;is nectar for our eyes;\\","With divine knowledge and shining eyes,\\","&nbsp;&nbsp;&nbsp;&nbsp;your effulgence fills the skies."],"isLong":false},{"number":"5","text":["suvarṇa-sūraja-kānti aruṇa-vasana","tilaka, tulasī-mālā, chandana-bhūṣaṇa"],"translation":["A golden Sun resplendent,\\","&nbsp;&nbsp;&nbsp;&nbsp;in robes of saffron dressed;\\","Adorned with tilak, Tulasī beads,\\","&nbsp;&nbsp;&nbsp;&nbsp;and with sandal fragrance blessed."],"isLong":false},{"number":"6","text":["apūrva śrī-aṅga-śobhā kore jhalamala","audārya-unnata-bhāva mādhurya-ujjvala"],"translation":["The matchless beauty of your holy form,\\","&nbsp;&nbsp;&nbsp;&nbsp;dazzling in its brightness;\\","Your benevolence of most noble heart,\\","&nbsp;&nbsp;&nbsp;&nbsp;in the moonglow of love’s sweetness."],"isLong":false},{"number":"7","text":["achintya-pratibhā, snigdha, gambhīra, udāra","jaḍa-jñāna-giri-vajra divya-dīkṣādhāra"],"translation":["Inconceivable genius, affection,\\","&nbsp;&nbsp;&nbsp;&nbsp;gravity, magnanimity —\\","A thunderbolt crushing mundane knowledge,\\","&nbsp;&nbsp;&nbsp;&nbsp;the reservoir bestowing divinity."],"isLong":false},{"number":"8","text":["gaura-saṅkīrtana-rāsa-rasera āśray","“dayāla nitāi” nāme nitya premamoy"],"translation":["In the Golden Lord’s Saṅkīrtan Dance,\\","&nbsp;&nbsp;&nbsp;&nbsp;you revel ecstatically;\\","“Dayāl Nitāi, Dayāl Nitāi!”\\","&nbsp;&nbsp;&nbsp;&nbsp;you ever call so lovingly."],"isLong":false},{"number":"9","text":["sāṅgopāṅge gaura-dhāme nitya-parakāśa","gupta-govardhane divya-līlāra-vilāsa"],"translation":["Eternally present in Nabadwīp Dhām\\","&nbsp;&nbsp;&nbsp;&nbsp;with your associates, by your sweet will,\\","You enjoy your holy Pastimes\\","&nbsp;&nbsp;&nbsp;&nbsp;on hidden Govardhan Hill."],"isLong":false},{"number":"10","text":["gauḍīya-āchārya-goṣṭhī-gaurava-bhājana","gauḍīya-siddhāntamaṇi kaṇṭha-vibhuṣaṇa"],"translation":["You’re the fit recipient of your dignity\\","&nbsp;&nbsp;&nbsp;&nbsp;In the Gauḍīya Āchārya assembly,\\","The jewel of the Gauḍīya-*siddhānta*\\","&nbsp;&nbsp;&nbsp;&nbsp;adorning your chest so nobly."],"isLong":false},{"number":"11","text":["gaura-sarasvatī-sphūrta siddhāntera khani","āviṣkṛta gāyatrīra artha-chintāmaṇi"],"translation":["You’re the living message of Śrī Gaura,\\","&nbsp;&nbsp;&nbsp;&nbsp;you’re the mine of perfect conclusions;\\","You revealed the Gāyatrī’s inner purport:\\","&nbsp;&nbsp;&nbsp;&nbsp;the gem fulfilling all aspirations."],"isLong":false},{"number":"12","text":["eka-tattva varṇanete nitya-nava-bhāva","susaṅgati, sāmañjasya, e saba prabhāva"],"translation":["When you speak, one subject alone\\","&nbsp;&nbsp;&nbsp;&nbsp;is revealed in ever-new light;\\","Proper adjustment, and harmony —\\","&nbsp;&nbsp;&nbsp;&nbsp;All these are your spiritual might."],"isLong":false},{"number":"13","text":["tomāra satīrtha-varga sabe eka-mate","rūpa-sarasvatī-dhārā dekhena tomāte"],"translation":["All your dear Godbrothers\\","&nbsp;&nbsp;&nbsp;&nbsp;declare unanimously\\","They see within your Holiness\\","&nbsp;&nbsp;&nbsp;&nbsp;the line of Rūpa-Saraswatī."],"isLong":false},{"number":"14","text":["tulasī-mālikā-haste śrī-nāma-grahaṇa","dekhi’ sakalera hoy ‘prabhu’ uddīpana"],"translation":["Seeing you take the Holy Name,\\","&nbsp;&nbsp;&nbsp;&nbsp;with Tulasī beads in hand,\\","Awakens the thought of Saraswatī Ṭhākur\\","&nbsp;&nbsp;&nbsp;&nbsp;in everybody’s mind."],"isLong":false},{"number":"15","text":["koṭī-chandra-suśītala o pada bharasā","gāndharvā-govinda-līlāmṛta-lābha-āśā"],"translation":["Your feet, cooling like ten million moons —\\","&nbsp;&nbsp;&nbsp;&nbsp;In their service all faith do I place;\\","The nectar of Rādhā-Govinda’s Pastimes\\","&nbsp;&nbsp;&nbsp;&nbsp;one day we may drink, by your grace."],"isLong":false},{"number":"16","text":["avichintya-bhedābheda-siddhānta-prakāśa","sānande ārati stuti kore dīna-dāsa"],"translation":["O personification of perfect conclusions\\","&nbsp;&nbsp;&nbsp;&nbsp;inconceivably one, yet different!\\","I sing this prayer at your *ārati*,\\","&nbsp;&nbsp;&nbsp;&nbsp;with joy — your humble servant."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-jaya-guru","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-sri-guru-arati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-jaya-guru","personSlug":"nabadwip-temple"},{"title":"Srila B.K. Ashram Maharaj","embed_url":"https://soundcloud.com/scsmathcolombia/4-sri-guru-arati-stuti","personSlug":"srila-b-k-ashram-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/jaya-guru-maharaja-jati","personSlug":"manasa-krishna-prabhu"},{"title":"Caracas temple","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-dzhaya-guru-1","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":null},"head":{"canonical":"/en-2022/jaya-guru-maharaja-jati-rajeshvara/","description":"Śrī Guru Ārati-stuti — a Vaiṣṇava song by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Śrī Guru Ārati-stuti. by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-2022","slug":"jaya-guru-maharaja-jati-rajeshvara"}}