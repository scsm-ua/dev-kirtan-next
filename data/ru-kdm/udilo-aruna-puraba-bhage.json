rder":9,"songsCount":23}],"nav":{"42":{"prev":{"path":"/ru-kdm/gurudeva-kripa-bindu-diya-kara-ei-dase/","title":"Гурудев"},"next":{"path":"/ru-kdm/jiv-jago-jiv-jago-gaurachanda-bole/","title":"Арунодойа-киртан (часть 2)"}}},"song":{"meta":{"page":42,"first_line":"удило арун̣а пӯраба-бха̄ге"},"title":["Арунодойа-киртан"],"author":["Ш́рӣла Бхактивинод Т̣ха̄кур"],"subtitle":[" Часть 1"],"verses":[{"number":"1","text":["удило арун̣а пӯраба-бха̄ге,","двиджа-ман̣и гора̄ амони джа̄ге,","бхаката-самӯха лоийа̄ са̄тхе,","гела̄ нагара-бра̄дже"],"translation":["Перед самым восходом солнца, когда небо на востоке начинает алеть, Шри Гаурахари, жемчужина среди дваждырожденных, пробуждается ото сна. Вместе со Своими преданными Он начинает *киртан*, странствуя по городам и деревням."],"isLong":false},{"number":"2","text":["‘татхаи татхаи’ ба̄джало кхол,","гхана гхана та̄хе джха̄н̇джера рол,","преме д̣хала д̣хала сона̄ра ан̇га,","чаран̣е нӯпура ба̄дже"],"translation":["*Мриданги* выбивают «*татхаи татхаи*» в ритм звенящим *караталам*, а золотистое тело Господа трепещет в экстазе, и позванивают Его ножные колокольчики."],"isLong":false},{"number":"3","text":["мукунда ма̄дхава джа̄дава хари,","болоре болоре вадана бхори’,","мичхе нида-баш́е гело ре ра̄ти,","диваса ш́орӣра са̄дже"],"translation":["Махапрабху взывает к спящим людям: «Не тратьте ночи на бесполезный сон, а дни на украшение тела! Взывайте к именам Мукунды, Мадхавы, Ядавы и Хари!»"],"isLong":false},{"number":"4","text":["эмана дурлабха ма̄нава-дехо,","па̄ийа̄ ки коро бха̄ва на̄ кехо,","эбэ на̄ бхаджиле джаш́ода̄-сута,","чараме под̣ибе ла̄дже"],"translation":["«Вы обрели столь редкое человеческое рождение! Но что вы делаете? Дорожите ли вы этим даром? Если вы не будете поклоняться любимому сыну матери Яшоды, великое горе будет ждать вас в момент смерти»."],"isLong":false},{"number":"5","text":["удита тапана хоиле аста,","дина гело-боли’ хоибе бйаста,","табе кено эбэ аласа хой,","на̄ бхаджа хр̣дойа-ра̄дже"],"translation":["«С каждым восходом и заходом солнца проходит день, и его уже не вернуть. Почему же вы так ленивы и отказываетесь служить Господу своего сердца?»"],"isLong":false},{"number":"6","text":["джӣвана анитйа джа̄наха са̄р,","та̄хе на̄на̄-видха випада-бха̄р,","на̄ма̄ш́райа кори’ джатане туми,","тха̄каха а̄пана ка̄дже"],"translation":["«Вы знаете, что жизнь исполнена страданий! Примите прибежище у Святого Имени — пусть призыв к Нему станет единственным вашим занятием»."],"isLong":false},{"number":"7","text":["кр̣ш̣н̣а-на̄ма-судха̄ корийа̄ па̄н","джуд̣а̄о бхакативинода-пра̄н̣,","на̄ма бина̄ кичхӯ на̄хико а̄ро,","чаудда-бхувана-ма̄джхе"],"translation":["Вкусите чистый нектар Святого Имени Кришны и доставьте этим радость душе Тхакура Бхактивинода. Нет ничего, к чему стоило бы стремиться во всех четырнадцати мирах, кроме Святого Имени!"],"isLong":false},{"number":"8","text":["джӣвера калйа̄н̣а-са̄дхана-ка̄м,","джагате а̄си’ э мадхура на̄м,","авидйа̄-тимира-тапана-рӯпе,","хр̣д-гагане бира̄дже"],"translation":["Чтобы рассеять тьму невежества и благословить все души Вселенной, прекрасное Имя Кришны взошло, словно сияющее солнце!"],"isLong":false}],"resources":{"audio":[{"title":"Навадвипский храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-udilo-aruna-jiv","personSlug":"nabadwip-temple"},{"title":"Шрила Б.Б. Авадхут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-1","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Манаса Кришна Прабху","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Arunodoja-kirtan-02-23-2"},"head":{"canonical":"/ru-kdm/udilo-aruna-puraba-bhage/","description":"Арунодойа-киртан — вайшнавская песня с текстом, русским переводом и пословным разбором. Автор — Ш́рӣла Бхактивинод Т̣ха̄кур. Из сборника «Колесница Джаганнатха».","title":"Арунодойа-киртан.  Часть 1 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ru-kdm","slug":"udilo-aruna-puraba-bhage"}}