rder":9,"songsCount":23}],"nav":{"39":{"prev":{"path":"/ru-kdm/kali-kukkura-kadana-jadi-chao-he/","title":"Прабхати Гити"},"next":{"path":"/ru-kdm/jaya-shiachinandana-sura-muni-vandana/","title":"Шри Шачинандана-вандана"}}},"song":{"meta":{"page":[39,60],"first_line":"джаш́оматӣ-нандана браджа-баро на̄гара"},"title":["Шри Нама-киртан"],"author":["Ш́рӣла Бхактивинод Т̣ха̄кур"],"verses":[{"number":"1","text":["джаш́оматӣ-нандана    браджа-баро на̄гара","    гокула-ран̃джана ка̄на","гопӣ-пара̄н̣а-дхана    мадана манохара","    ка̄лӣйа-дамана-видха̄на"],"translation":["Шри Кришна — любимый сын матери Яшоды, трансцендентный возлюбленный земли Враджа! Он Тот, Кто приводит в восхищение Гокулу! Одно из Его имен — Кана. Он жизнь и душа *гопи*. Он очаровывает самого Купидона и побеждает змея Калию!"],"isLong":false},{"number":"2","text":["    амала харина̄м амийа-вила̄са̄","випина-пурандара    навӣна на̄гара-бара","    бам̇ш́ӣ-бадана сува̄са̄"],"translation":["Святые имена Кришны безупречны, исполнены сладости и красоты! Кришна — царь лесов Вриндавана! Он вечно юн и великолепен! Он — достойнейший из всех возлюбленных! Он играет сладостные мелодии на Своей флейте."],"isLong":false},{"number":"3","text":["браджа-джана-па̄лана    асура-кула-на̄ш́ана","    нанда-годхана ра̄кхойа̄ла̄","говинда ма̄дхава    наванӣта-таш̣кара","    сундара нанда-гопа̄ла̄"],"translation":["Кришна заботится о жителях Вриндавана и побеждает демонов. Он пасет коров и известен как Говинда — Тот, Кто приносит радость коровам и удовлетворяет чувства! Он известен как Мадхава, супруг богини удачи. Кришна, прекрасный пастушок, сын Нанды Махараджа, очень любит воровать масло у *гопи*!"],"isLong":false},{"number":"4","text":["джа̄муна-тат̣а-чара    гопӣ-басана-хара","    ра̄са-расика кр̣па̄мойа","ш́рӣ-ра̄дха̄-валлабха    вр̣нда̄вана-нат̣абара","    бхакативинода-а̄ш̣райа"],"translation":["Гуляя по берегам реки Ямуны, Кришна похищает одежды купающихся юных *гопи*. Он наслаждается сладостью танца *расы*. Он очень милостив! Кришна — единственный возлюбленный Шримати Радхарани! Он самый лучший танцор Вриндавана и высочайшее прибежище Шрилы Бхактивинода Тхакура!"],"isLong":false}],"resources":{"audio":[{"title":"Шрила Б.С. Говинда Дев-Госвами Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-jasomati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Шрила Б.С. Говинда Дев-Госвами Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati-2","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Шрила Б.С. Говинда Дев-Госвами Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Шрила Б.С. Говинда Дев-Госвами Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Навадвипский храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-jasomati-nandana","personSlug":"nabadwip-temple"},{"title":"Шрила Б.Б. Авадхут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-5","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Шрила Б.Б. Авадхут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-shri-nama","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Шрила Б.Р. Мадхусудан Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-day-programm-kisel","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Шрила Б.С. Госвами Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/goswami-maharaj-yasomati","personSlug":"srila-b-s-goswami-maharaj"},{"title":"Манаса Кришна Прабху","embed_url":"https://soundcloud.com/huron/yasomati-nandana","personSlug":"manasa-krishna-prabhu"},{"title":"Храм г.Каракас","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-dzhashomati","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHri-Nama-kirtan-02-23"},"head":{"canonical":"/ru-kdm/jashomati-nandana-vraja-vara-nagara/","description":"Шри Нама-киртан — вайшнавская песня с текстом, русским переводом и пословным разбором. Автор — Ш́рӣла Бхактивинод Т̣ха̄кур. Из сборника «Колесница Джаганнатха».","title":"Шри Нама-киртан. Ш́рӣла Бхактивинод Т̣ха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ru-kdm","slug":"jashomati-nandana-vraja-vara-nagara"}}