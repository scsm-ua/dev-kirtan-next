{"build":"49908b2@26/11/2026, 08:56:03","data":{"book":{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"256":{"prev":{"path":"/en/gopinath-mama-nivedana-shiuno/","title":"Nivedana – Part One"},"next":{"path":"/en/gopinath-amara-upaya-nai/","title":"Nivedana – Part Three"}}},"song":{"meta":{"page":256,"author":"Śrīla Bhakti Vinod Ṭhākur","first_line":"gopīnāth, ghuchāo saṁsāra-jvālā"},"title":["Nivedana"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Part Two"],"verses":[{"number":"1","text":["    gopīnāth, ghuchāo saṁsāra-jvālā","avidyā-yātanā    āra nāhi sahe","    janama-maraṇa-mālā"],"translation":["O Gopīnāth, please remove the torment of worldly existence. I can no longer tolerate the pain of ignorance and the repeated succession of rebirth and death."],"isLong":false},{"number":"2","text":["    gopīnāth, āmi ta kāmera dāsa","viṣaya-vāsanā    jāgichhe hṛdaye","    phā̐dichhe karama phā̐sa"],"translation":["O Gopīnāth, indeed I am a servant of lust. Worldly desires are awakening in my heart, and thus the noose of fruitive work is beginning to tighten."],"isLong":false},{"number":"3","text":["    gopīnāth, kabe vā jāgiba āmi","kāma-rūpa ari    dūre teyāgiba","    hṛdaye sphuribe tumi"],"translation":["O Gopīnāth, when will I wake up and abandon afar this enemy of lust, and when will You manifest Yourself in my heart?"],"isLong":false},{"number":"4","text":["    gopīnāth, āmi ta tomāra jana","tomāre chhāḍiyā    saṁsāra bhajinu","    bhuliyā āpana-dhana"],"translation":["O Gopīnāth, I am Your devotee, but having abandoned You and thus having forgotten my real treasure, I have worshipped this mundane world."],"isLong":false},{"number":"5","text":["    gopīnāth, tumi ta sakali jāna","āpanāra jane    daṇḍiyā ekhana","    śrī-charaṇe deha sthāna"],"translation":["O Gopīnāth, You know everything. Now, having punished Your servant, please give him a place at Your lotus feet."],"isLong":false},{"number":"6","text":["    gopīnāth, ei ki vichāra tava","vimukha dekhiyā    chhāḍa nija-jane","    nā kara karuṇā-lava"],"translation":["O Gopīnāth, is this Your judgement, that seeing me averse to You, You abandon Your servant and don’t bestow even a particle of mercy upon him?"],"isLong":false},{"number":"7","text":["    gopīnāth, āmi ta mūrakha ati","kise bhāla haya    kabhu nā bujhinu","    tāi hena mama gati"],"translation":["O Gopīnāth, I am certainly very foolish, and I have never known what is good for me. Therefore such is my condition."],"isLong":false},{"number":"8","text":["    gopīnāth, tumi ta paṇḍita-vara","mūḍhera maṅgala    sadā anveṣibe","    e dāse nā bhāva para"],"translation":["O Gopīnāth, You are indeed the wisest person. Please look for a way to bring about auspiciousness for this fool, and please do not consider this servant as an outsider."],"isLong":false}],"resources":{"audio":[{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/gopinath-ghuchao-samsara-jvala","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Nivedana-02-22-5"},"head":{"canonical":"/en/gopinath-ghuchao-samsara-jvala/","description":"Nivedana — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Nivedana. Part Two | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"gopinath-ghuchao-samsara-jvala"}}