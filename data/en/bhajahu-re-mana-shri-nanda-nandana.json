r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"167":{"prev":{"path":"/en/bhagavad-bhaktitah-sarvam/","title":"You Will Receive Everything"},"next":{"path":"/en/manasa-deho-geho-jo-kichu-mora/","title":"Mānasa Deha Geha"}}},"song":{"meta":{"page":167,"author":"Śrīla Govinda Dās Kavirāj","first_line":"bhajahu̐ re mana śrī-nanda-nandana"},"title":["Bhajahu̐ Re Mana"],"author":["by Śrīla Govinda Dās Kavirāj"],"verses":[{"number":"1","text":["bhajahu̐ re mana    śrī-nanda-nandana","    abhaya-charaṇāravinda re","durlabha mānava    janama sat-saṅge","    taraha e bhava-sindhu re"],"translation":["O mind, just worship the lotus feet of the son of Nanda, which make one fearless. Having obtained this rare human birth, cross over this ocean of worldly existence through the association of saintly persons."],"isLong":false},{"number":"2","text":["śīta ātapa    vāta variṣaṇa","    e dina yāminī jāgi re","viphale sevinu    kṛpaṇa durajana","    chapala sukha-lava lāgi’ re"],"translation":["Both in the day and at night I remain sleepless, suffering the pains of the heat and cold, the wind and the rain. For a fraction of flickering happiness I have uselessly served wicked and miserly men."],"isLong":false},{"number":"3","text":["e dhana, yauvana,    putra, parijana","    ithe ki āchhe paratīti re","kamala-dala-jala    jīvana ṭalamala","    (ei āchhe ei nāi jīvana ṭalamala)","    bhajahu̐ hari-pada niti re"],"translation":["What assurance of real happiness is there in all of one’s wealth, youthfulness, sons, and family members? This life is tottering like a drop of water on a lotus petal (it is here, and then it is gone); therefore, you should always serve and worship the divine feet of Lord Hari."],"isLong":false},{"number":"4","text":["śravaṇa, kīrtana,    smaraṇa, vandana","    pāda-sevana, dāsya re","pūjana, sakhī-jana,    ātma-nivedana","    govinda-dāsa-abhilāṣa re"],"translation":["It is the desire and great longing of Govinda Dās to engage himself in the nine processes of bhakti, namely: hearing the glories of Lord Hari and chanting those glories, constantly remembering Him and offering prayers to Him, serving the Lord’s lotus feet, serving the Supreme Lord as a servant, worshiping Him with flowers and incense and so forth, serving Him as a friend, and completely offering the Lord one’s very self."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-bhajahu-re-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-bhajahu-re","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/bhajahu-re-mana","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Bhajahu-Re-Mana-02-22-2"},"head":{"canonical":"/en/bhajahu-re-mana-shri-nanda-nandana/","description":"Bhajahu̐ Re Mana — a Vaiṣṇava song by Śrīla Govinda Dās Kavirāj with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Bhajahu̐ Re Mana. by Śrīla Govinda Dās Kavirāj | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"bhajahu-re-mana-shri-nanda-nandana"}}