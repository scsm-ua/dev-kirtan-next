{"build":"d2d3291@22/11/2026, 17:23:59","data":{"book":{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},"nav":{"13":{"prev":{"path":"/en/011-elixir/","title":"The Elixir of Life"},"next":{"path":"/en/014-my-advice/","title":"My Advice"}}},"page":{"bodyHtml":"<div style=\"text-align: center;\"><h1>Handwritten Advice</h1>\n<p><em>by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj</em></p>\n<img src=\"/images/resources/en/2.jpg\" alt=\"Handwritten advice photo\" width=\"529\" height=\"513\" loading=\"lazy\" decoding=\"async\" fetchpriority=\"low\"></div><ol>\n<li>Read Śrī Gītā and Holy Books regularly</li>\n<li>Congregational chanting arrangement</li>\n<li>Not to criticise anyone</li>\n<li>Think seriously for spiritual life</li>\n<li>Avoid Vaiṣṇava aparādh</li>\n<li>Follow 4 directives</li>\n<li>Be humble<br>be tolerant<br>give honour to others</li>\n</ol>\n<p>Try to increase faith of others in the line of\nMahāprabhu as directed by Śrīla Guru Mahārāj</p>\n","meta":{"page":13,"title":"Handwritten Advice"}}},"head":{"canonical":"/en/013-handwritten-advice/","description":"Handwritten Advice","title":"Handwritten Advice"},"kind":"page","route":{"kind":"item","bookId":"en","slug":"013-handwritten-advice"}}