r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"271":{"prev":{"path":"/en/radha-madhava-kunja-bihari/","title":"Jaya Rādhā-Mādhava"},"next":{"path":"/en/namamishvaram-sachchidananda-rupam/","title":"Śrī Śrī Dāmodarāṣṭakam"}}},"song":{"meta":{"page":271,"author":"Śrīla Rūpa Goswāmī Prabhu","first_line":"he deva bhavantaṁ vande"},"title":["Śrī Kṛṣṇa-vandanā"],"author":["Sanskrit composition by Śrīla Rūpa Goswāmī Prabhu"],"verses":[{"number":"1","text":["    he deva bhavantaṁ vande","man-mānasa-madhukara marpaya nija-pada-","    paṅkaja-makarande"],"translation":["O Lord, I offer my respectful obeisances to You. May you place the bumblebee of my mind in the honey of Your lotus feet."],"isLong":false},{"number":"2","text":["yady api samādhiṣu vidhir api paśyati","    na tava nakhāgra-marīchim","idam ichchhāmi niśamya tavāchyuta","    tad api kṛpādbhuta-vīchim"],"translation":["Although Brahmā in his samādhi cannot obtain a glimpse of even a ray of the tips of the nails of Your feet, still, O Achyuta, having heard of the waves of Your astonishing mercy, I yearn to see You."],"isLong":false},{"number":"3","text":["bhaktir udañchati yady api mādhava","    na tvayi mama tila-mātrī","parameśvaratā tad api tavādhika-","    durghaṭa-ghaṭana-vidhātrī"],"translation":["O Mādhava, although I do not have even a sesame seed of devotion for You, Your supreme power can make even the impossible become possible."],"isLong":false},{"number":"4","text":["ayam avilolatayādya sanātana","    kalitādbhuta-rasa-bhāram","nivasatu nityam ihāmṛta-nindini","    vindan madhurima-sāram"],"translation":["O eternal Lord, may the bumblebee of my mind, finding there the most wonderful sweetness, eternally stay in the honey of Your lotus feet, which rebuke the sweetest nectar."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-he-deva","