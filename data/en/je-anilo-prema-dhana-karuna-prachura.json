r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"119":{"prev":{"path":"/en/thakura-vaishnava-pada-avanira/","title":"Ṭhākura Vaiṣṇava-pada"},"next":{"path":"/en/ei-vara-karuna-kara-vaishnava-gosani/","title":"Vaiṣṇava Vijñāpti"}}},"song":{"meta":{"page":119,"author":"Śrīla Narottam Dās Ṭhākur","first_line":"ye ānila prema-dhana karuṇā prachura"},"title":["Viraha-gīti"],"author":["by Śrīla Narottam Dās Ṭhākur"],"subtitle":["Song of Separation"],"verses":[{"number":"1","text":["ye ānila prema-dhana karuṇā prachura","hena prabhu kothā gelā āchārya ṭhākura"],"translation":["That personality who delivered the treasure of prema-bhakti, who was so intense with compassion – where is such a personality to be found as Śrī Āchārya Ṭhākur (Śrīnivās Āchārya)?"],"isLong":false},{"number":"2","text":["kā̐hā mora svarūpa rūpa kā̐hā sanātana","kā̐hā dāsa raghunātha patita-pāvana"],"translation":["Where are the saviours of the fallen souls? Where is my Svarūp Dāmodar, and where are Rūpa Goswāmī and Sanātan Goswāmī? Where is Raghunāth Dās to be found?"],"isLong":false},{"number":"3","text":["kā̐hā mora bhaṭṭa-yuga kā̐hā kavirāja","eka-kāle kothā gelā gorā naṭa-rāja"],"translation":["Where are my Raghunāth Bhaṭṭa and Gopāl Bhaṭṭa Goswāmīs? Where am I to find Śrī Kṛṣṇadās Kavirāj now? All at once they have gone to join Lord Gaurāṅga, the great dancer."],"isLong":false},{"number":"4","text":["pāṣāṇe kuṭiba māthā anale paśiba","gaurāṅga guṇera nidhi kothā gele pāba"],"translation":["To reach such a perfect personality as Lord Chaitanya, I can only break my head against a stone in the anguish of separation."],"isLong":false},{"number":"5","text":["se saba saṅgīra saṅge ye kaila vilāsa","se saṅga nā pāñā kānde narottama dāsa"],"translation":["They have all gone off together in their own Pastimes. Narottam Dās Ṭhākur says: “Unable to obtain their association, I must simply weep.”"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/krsnachaitanya-das/49-ye-anilo-prema-dhana-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/je-anilo-prema-dhana","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Viraha-gīti-02-22-2"},"head":{"canonical":"/en/je-anilo-prema-dhana-karuna-prachura/","description":"Viraha-gīti — a Vaiṣṇava song by Śrīla Narottam Dās Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Viraha-gīti. Song of Separation | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"je-anilo-prema-dhana-karuna-prachura"}}