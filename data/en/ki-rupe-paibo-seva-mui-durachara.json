r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"158":{"prev":{"path":"/en/krishnotkirtana-gana-nartana-parau/","title":"Śrī Śrī Ṣaḍ Goswāmī-aṣṭakam"},"next":{"path":"/en/e-ghora-samsare-podiya-manava/","title":"E Ghora-saṁsāre"}}},"song":{"meta":{"page":158,"author":"Śrīla Narottam Dās Ṭhākur","first_line":"ki-rūpe pāiba sevā muñi durāchāra"},"title":["Ki-rūpe Pāiba Sevā"],"author":["by Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["ki-rūpe pāiba sevā muñi durāchāra","śrī-guru-vaiṣṇave rati nā haila āmāra"],"translation":["I have no devotional attachment for either the Vaiṣṇavas or my Spiritual Master. How is it possible for a rascal like me to attain devotional service?"],"isLong":false},{"number":"2","text":["aśeṣa māyāte mana magana ha-ila","vaiṣṇavete leśa-mātra rati nā janmila"],"translation":["My mind is always drowning in illusion. I have not even the smallest fragment of devotion for the Vaiṣṇavas."],"isLong":false},{"number":"3","text":["viṣaye bhuliyā andha ha-inu divā-niśi","gale phā̐sa dite phere māyā se piśāchī"],"translation":["I have become blind by constantly meditating on the objects of the senses. The witch Māyā Devī has placed a hangman’s noose around my neck."],"isLong":false},{"number":"4","text":["māyāre kariyā jaya chhāḍāna nā yāya","sādhu-kṛpā vinā āra nāhika upāya"],"translation":["Even if I can cure my blindness and defeat Māyā in the form of this hangman, I cannot become free from material illusion without the mercy of the saintly devotees."],"isLong":false},{"number":"5","text":["adoṣa-daraśi-prabhu patita-uddhāra","ei-bāra narottame karaha nistāra"],"translation":["O master! O purifier of the sinful! O saviour of the fallen souls, you do not see the faults of others; please rescue this Narottam Dās."],"isLong":false}],"resources":{"audio":[{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/ki-rupe-paibo-seva","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Ki-rūpe-pāibo-sevā-02-22"},"head":{"canonical":"/en/ki-rupe-paibo-seva-mui-durachara/","description":"Ki-rūpe Pāiba Sevā — a Vaiṣṇava song by Śrīla Narottam Dās Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Ki-rūpe Pāiba Sevā. by Śrīla Narottam Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"ki-rupe-paibo-seva-mui-durachara"}}