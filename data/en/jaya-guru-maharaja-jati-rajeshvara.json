r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80},{"title":"Колесница Джаганнатха","subtitle":"Утренняя программа","slug":"ru-kdm","language":"ru","hidden":true,"render":{"tg.contents.page_number":false},"sort_order":9,"songsCount":23}],"nav":{"46":{"prev":{"path":"/en/jaya-jaya-gurudever-arati-ujjvala/","title":"Śrī Guru Ārati"},"next":{"path":"/en/kali-kukkura-kadana-jadi-chao-he/","title":"Prabhāti Gīti"}}},"song":{"meta":{"page":46,"author":"Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj","first_line":"jaya ‘guru-mahārāja’ yati-rājeśvara","styles":{"verses":{"align":"left"}}},"title":["Śrī Guru-ārati-stuti"],"author":["by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj","in glorification of Śrīla Bhakti Rakṣak Śrīdhar Dev-Goswāmī Mahārāj"],"verses":[{"number":"1","text":["jaya ‘guru-mahārāja’ yati-rājeśvara","śrī-bhakti-rakṣaka deva-gosvāmī śrīdhara"],"translation":["All glories to you, ‘Guru Mahārāj,’\\","&nbsp;&nbsp;&nbsp;&nbsp;of sannyāsī kings, the Emperor:\\","the glorious Śrīla Bhakti Rakṣak\\","&nbsp;&nbsp;&nbsp;&nbsp;Dev-Goswāmī Śrīdhar."],"isLong":true},{"number":"2","text":["patita-pāvana-līlā vistāri’ bhuvane","nistārilā dīna-hīna āpāmara jane"],"translation":["Extending in this world your\\","&nbsp;&nbsp;&nbsp;&nbsp;Pastimes as saviour of the fallen,\\","you delivered all the suffering souls,\\","&nbsp;&nbsp;&nbsp;&nbsp;including the most forsaken."],"isLong":true},{"number":"3","text":["tomāra karuṇā-ghana murati heriyā","preme bhāgyavāna jīva paḍe murachiyā"],"translation":["Beholding your holy form\\","&nbsp;&nbsp;&nbsp;&nbsp;of concentrated mercy\\","the fortunate souls fall in a swoon\\","&nbsp;&nbsp;&nbsp;&nbsp;of divine love’s ecstasy."],"isLong":true},{"number":"4","text":["sudīrgha supībya deha divya-bhāvāśraya","divya-jñāna-dīpta-netra divya-jyotirmaya"],"translation":["Your lofty form full of divine emotion\\","&nbsp;&nbsp;&nbsp;&nbsp;is nectar for our eyes;\\","with divine knowledge and shining eyes,\\","&nbsp;&nbsp;&nbsp;&nbsp;your effulgence fills the skies."],"isLong":true},{"number":"5","text":["suvarṇa-sūraja-kānti aruṇa-vasana","tilaka, tulasī-mālā, chandana-bhūṣaṇa"],"translation":["A golden Sun resplendent,\\","&nbsp;&nbsp;&nbsp;&nbsp;in robes of saffron dressed;\\","adorned with tilak, Tulasī beads,\\","&nbsp;&nbsp;&nbsp;&nbsp;and with sandal fragrance blessed."],"isLong":true},{"number":"6","text":["apūrva śrī-aṅga-śobhā kare jhalamala","audārya-unnata-bhāva mādhurya-ujjvala"],"translation":["The matchless beauty of your holy form,\\","&nbsp;&nbsp;&nbsp;&nbsp;dazzling in its brightness;\\","your benevolence of most noble heart,\\","&nbsp;&nbsp;&nbsp;&nbsp;in the moonglow of love’s sweetness."],"isLong":true},{"number":"7","text":["achintya pratibhā, snigdha, gambhīra, udāra","jaḍa-jñāna-giri-vajra divya-dīkṣādhāra"],"translation":["Inconceivable genius, affection,\\","&nbsp;&nbsp;&nbsp;&nbsp;gravity, magnanimity – \\","a thunderbolt crushing mundane knowledge,\\","&nbsp;&nbsp;&nbsp;&nbsp;the reservoir bestowing divinity."],"isLong":true},{"number":"8","text":["gaura-saṅkīrtana-rāsa-rasera āśraya","“dayāla nitāi” nāme nitya premamaya"],"translation":["In the Golden Lord’s saṅkīrtan dance,\\","&nbsp;&nbsp;&nbsp;&nbsp;you revel ecstatically;\\","“Dayāl Nitāi, Dayāl Nitāi!”\\","&nbsp;&nbsp;&nbsp;&nbsp;you ever call so lovingly."],"isLong":true},{"number":"9","text":["sāṅgopāṅge gaura-dhāme nitya-parakāśa","gupta-govardhane divya-līlāra-vilāsa"],"translation":["Eternally present in Nabadwīp Dhām\\","&nbsp;&nbsp;&nbsp;&nbsp;with your associates, by your sweet will,\\","you enjoy your holy Pastimes\\","&nbsp;&nbsp;&nbsp;&nbsp;on hidden Govardhan Hill."],"isLong":true},{"number":"10","text":["gauḍīya-āchārya-goṣṭhī-gaurava-bhājana","gauḍīya-siddhānta-maṇi kaṇṭha-vibhūṣaṇa"],"translation":["You’re the fit recipient of your dignity\\","&nbsp;&nbsp;&nbsp;&nbsp;in the Gauḍīya Āchārya assembly,\\","the jewel of the Gauḍīya-siddhānta\\","&nbsp;&nbsp;&nbsp;&nbsp;adorning your chest so nobly."],"isLong":true},{"number":"11","text":["gaura-sarasvatī-sphūrta siddhāntera khani","āviṣkṛta gāyatrīra artha-chintāmaṇi"],"translation":["You’re the living message of Śrī Gaura,\\","&nbsp;&nbsp;&nbsp;&nbsp;you’re the mine of perfect conclusions;\\","you revealed the Gāyatrī’s inner purport:\\","&nbsp;&nbsp;&nbsp;&nbsp;the gem fulfilling all aspirations."],"isLong":true},{"number":"12","text":["eka-tattva varṇanete nitya-nava-bhāva","susaṅgati, sāmañjasya, e-saba prabhāva"],"translation":["When you speak, one subject alone\\","&nbsp;&nbsp;&nbsp;&nbsp;is revealed in ever-new light;\\","proper adjustment, and harmony – \\","&nbsp;&nbsp;&nbsp;&nbsp;all these are your spiritual might."],"isLong":true},{"number":"13","text":["tomāra satīrtha-varga sabe eka-mate","rūpa-sarasvatī-dhārā dekhena tomāte"],"translation":["All your dear Godbrothers\\","&nbsp;&nbsp;&nbsp;&nbsp;declare unanimously\\","they see within your Holiness\\","&nbsp;&nbsp;&nbsp;&nbsp;the line of Rūpa-Saraswatī."],"isLong":true},{"number":"14","text":["tulasī-mālikā-haste śrī-nāma-grahaṇa","dekhi’ sakalera haya ‘prabhu’ uddīpana"],"translation":["Seeing you take the Holy Name,\\","&nbsp;&nbsp;&nbsp;&nbsp;with Tulasī beads in hand,\\","awakens the thought of Saraswatī Ṭhākur\\","&nbsp;&nbsp;&nbsp;&nbsp;in everybody’s mind."],"isLong":true},{"number":"15","text":["koṭī-chandra-suśītala o-pada bharasā","gāndharvā-govinda-līlāmṛta-lābha-āśā"],"translation":["Your feet, cooling like ten million moons – \\","&nbsp;&nbsp;&nbsp;&nbsp;in their service all faith do I place;\\","the nectar of Rādhā-Govinda’s Pastimes\\","&nbsp;&nbsp;&nbsp;&nbsp;one day we may drink, by your grace."],"isLong":true},{"number":"16","text":["avichintya-bhedābheda-siddhānta-prakāśa","sānande ārati stuti kare dīna-dāsa"],"translation":["O personification of perfect conclusions\\","&nbsp;&nbsp;&nbsp;&nbsp;inconceivably one, yet different!\\","I sing this prayer at your ārati,\\","&nbsp;&nbsp;&nbsp;&nbsp;with joy – your humble servant."],"isLong":true}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-jaya-guru","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-sri-guru-arati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-jaya-guru","personSlug":"nabadwip-temple"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/jaya-guru-maharaja-jati","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Guru-Ārati-stuti-02-22-2"},"head":{"canonical":"/en/jaya-guru-maharaja-jati-rajeshvara/","description":"Śrī Guru-ārati-stuti — a Vaiṣṇava song by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Śrī Guru-ārati-stuti. by Śrīla Bhakti Sundar Govinda Dev-Goswāmī Mahārāj | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"jaya-guru-maharaja-jati-rajeshvara"}}