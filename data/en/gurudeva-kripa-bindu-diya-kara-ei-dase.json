r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80},{"title":"Колесница Джаганнатха","subtitle":"Утренняя программа","slug":"ru-kdm","language":"ru","hidden":true,"render":{"tg.contents.page_number":false},"sort_order":9,"songsCount":23}],"nav":{"52":{"prev":{"path":"/en/jayare-jayare-jaya-gaura-sarasvati/","title":"Śrī Sāraswat Ārati"},"next":{"path":"/en/udilo-aruna-puraba-bhage/","title":"Aruṇodaya-kīrtan – Part One"}}},"song":{"meta":{"page":52,"author":"Śrīla Bhakti Vinod Ṭhākur","first_line":"gurudeva! kṛpā-bindu diyā kara’ ei dāse"},"title":["Gurudeva!"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["gurudeva!","kṛpā-bindu diyā    kara’ ei dāse","    tṛṇāpekṣā ati dīna","sakala-sahane    bala diyā kara","    nija-māne spṛhā-hīna"],"translation":["Gurudev, please give to this servant just one drop of mercy, and make me more humble than a blade of grass. Grant me the strength to endure all things, and make me free from personal honour."],"isLong":false},{"number":"2","text":["sakale sammāna    karite śakati","    deha’ nātha! yathā yatha","tabe ta’ gāiba    hari-nāma sukhe","    aparādha habe hata"],"translation":["Give me energy so that I can properly give respect and honour to all. Then I shall be able to happily chant the Holy Name, and my offences will go away."],"isLong":false},{"number":"3","text":["kabe hena kṛpā    labhiyā e jana","    kṛtārtha ha-ibe nātha!","śakti-buddhi-hīna    āmi ati dīna","    kara more ātma-sātha"],"translation":["O my Lord! When will such mercy fall to this person. I am weak, bereft, and devoid of intelligence. Please allow me to be with you."],"isLong":false},{"number":"4","text":["yogyatā-vichāre    kichhu nāhi pāi","    tomāra karuṇā sāra","karuṇā nā haile    kā̐diyā kā̐diyā","    prāṇa nā rākhiba āra"],"translation":["If you examine me, you will find no qualities. Your mercy is everything to me. If you are not merciful unto me, I can only weep, and I will not be able to maintai