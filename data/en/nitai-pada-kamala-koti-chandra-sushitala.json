r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"123":{"prev":{"path":"/en/nadiya-godrume-nityananda-mahajana/","title":"Ājñā Ṭahal"},"next":{"path":"/en/dhana-mora-nityananda-pati-mora/","title":"Sva-niṣṭha"}}},"song":{"meta":{"page":123,"author":"Śrīla Narottam Dās Ṭhākur","first_line":"nitāi-pada-kamala koṭī-chandra-suśītala"},"title":["Manaḥ Śikṣā"],"author":["by Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["nitāi-pada-kamala    koṭī-chandra-suśītala","    ye chhāyāya jagata juḍāya","hena nitāi vine bhāi    rādhā-kṛṣṇa pāite nāi","    dṛḍha kari’ dhara nitāira pāya"],"translation":["The holy lotus feet of Nitāi, cooling like ten million moons – in the shade of which the world gains soothing relief. Without that Nitāi, O brother, no one can reach Rādhā and Kṛṣṇa – clasp His lotus feet with full conviction."],"isLong":false},{"number":"2","text":["se sambandha nāhi yāra    vṛthā janma gela tāra","    sei paśu baḍa durāchāra","nitāi nā balila mukhe    majila saṁsāra-sukhe","    vidyā-kule ki karibe tāra"],"translation":["One who never got His connection, passed his life in vain – such an animal is so very wicked. He whose mouth never uttered ‘Nitāi,’ merged in mundane pleasures – how can his aristocratic lineage save him?"],"isLong":false},{"number":"3","text":["ahaṅkāre matta haiñā    nitāi-pada pāsariyā","    asatyere satya kari’ māni","nitāiyer karuṇā habe    vraje rādhā-kṛṣṇa pābe","    dhara nitāiyer charaṇa du’khāni"],"translation":["Maddened with pride, forgetting the lotus feet of Nitāi – I embrace untruth as truth; but when Nitāi gives His grace you’ll reach Rādhā and Kṛṣṇa in Vraja – O embrace the lotus feet of Nitāi!"],"isLong":false},{"number":"4","text":["nitāiyer charaṇa satya    tā̐hāra sevaka nitya","    nitāi-pada sadā kara āśa","narottama baḍa duḥkhī    nitāi more kara sukhī","    rākha rāṅgā-charaṇera pāśa"],"translation":["The lotus feet of Nitāi are truth, His servitors are eternal – ever aspire for the shelter of His feet. Narottam is very sad – O Nitāi make me happy – please keep me at Your lovely lotus feet!"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-nitai-pada-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-nitai-pada","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/nitai-pada-kamala","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Manaḥ-Śikṣā-02-22-2"},"head":{"canonical":"/en/nitai-pada-kamala-koti-chandra-sushitala/","description":"Manaḥ Śikṣā — a Vaiṣṇava song by Śrīla Narottam Dās Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Manaḥ Śikṣā. by Śrīla Narottam Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"nitai-pada-kamala-koti-chandra-sushitala"}}