{"build":"d2d3291@22/11/2026, 17:23:59","data":{"book":{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166}],"nav":{"284":{"prev":{"path":"/en/virajar-pare-shiuddha-paravyoma-dham/","title":"Śrī Rādhāṣṭaka – Kīrtan Two"},"next":{"path":"/en/radhakundatata-kunjakutira/","title":"Rādhā-kuṇḍataṭa-kuñja-kuṭīra"}}},"song":{"meta":{"page":284,"author":"Śrīla Bhakti Vinod Ṭhākur","first_line":"rādha-bhajane yadi mati nāhi bhelā"},"title":["Śrī Rādhāṣṭaka"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Kīrtan Eight"],"verses":[{"number":"1","text":["rādha-bhajane yadi mati nāhi bhelā","kṛṣṇa-bhajana tava akāraṇa gelā"],"translation":["If one does not develop within his heart the desire for Rādhā-bhajan, then his Kṛṣṇa-bhajan is worthless."],"isLong":false},{"number":"2","text":["ātapa-rahita sūraya nāhi jāni","rādhā-virahita mādhava nāhi māni"],"translation":["Without sunlight the sun cannot be seen. Similarly I don’t pay any mind to Kṛṣṇa without Rādhā."],"isLong":false},{"number":"3","text":["kevala mādhava pūjaye so ajñānī","rādhā anādara kara-i abhimānī"],"translation":["One who worships Kṛṣṇa alone is ignorant. Who does not adore Śrī Rādhā is an egotist."],"isLong":false},{"number":"4","text":["kabahi nāhi karabi tā̐kara saṅga","chitte ichchhasi yadi vraja-rasa-raṅga"],"translation":["Never keep company with those who envy Rādhā if within your heart you at all aspire to the loving Pastimes of Vraja."],"isLong":false},{"number":"5","text":["rādhikā-dāsī yadi hoya abhimāna","śīghra-i mila-i tava gokula-kāna"],"translation":["Those who consider themselves maidservants of Śrī Rādhā will quickly meet Gokul-Kṛṣṇa."],"isLong":false},{"number":"6","text":["brahmā, śiva, nārada, śruti, nārāyaṇī","rādhikā-pada-raja pūjaye māni’"],"translation":["Brahmā, Śiva, Nārada, the śrutis, and Nārāyaṇī (Lakṣmī) worship with regard the holy feet of Śrī Rādhā."],"isLong":false},{"number":"7","text":["umā, ramā, satyā, śachī, chandrā, rukminī","rādha-avatāra sabe āmnāya-vāṇī"],"translation":["Umā, Ramā, Satyā, Śachī, Chandrāvālī, and Rukminī are all personal expansions of Śrīmatī Rādhārāṇī – this is the self-evident verdict of the Vedas."],"isLong":false},{"number":"8","text":["hena rādhā-paricharyā yā̐kara dhana","bhakati-vinoda tā̐ra māgaye charaṇa"],"translation":["Bhakti Vinod, whose only wealth is the service of Śrī Rādhā, humbly prays to be a serving maid at Her lotus feet."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/krsnachaitanya-das/31-radha-bhajane-yadi-8","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/radha-bhajane-jodi","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Rādhāṣṭaka-02-22"},"head":{"canonical":"/en/radha-bhajane-jodi-moti-nahi-bhela/","description":"Śrī Rādhāṣṭaka — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Śrī Rādhāṣṭaka. Kīrtan Eight | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"radha-bhajane-jodi-moti-nahi-bhela"}}