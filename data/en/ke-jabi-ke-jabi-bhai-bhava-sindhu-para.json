r":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"138":{"prev":{"path":"/en/emona-gauranga-bine-nahi-ara/","title":"Emana Gaurāṅga Vine Nāhi Āra"},"next":{"path":"/en/vimala-hemajin-tanu-anupama-re/","title":"Vimala Hema Jini"}}},"song":{"meta":{"page":138,"author":"Śrīla Lochan Dās Ṭhākur","first_line":"ke yābi ke yābi bhāi bhava-sindhu pāra"},"title":["Ke Yābi Ke Yābi Bhāi?"],"author":["by Śrīla Lochan Dās Ṭhākur"],"verses":[{"number":"1","text":["ke yābi ke yābi bhāi bhava-sindhu pāra","dhanya kali-yuge re chaitanya-avatāra"],"translation":["Who will go, oh brother, who will go to cross the ocean of material existence? The wealth and great fortune of this age of Kali is the incarnation of Lord Chaitanya."],"isLong":false},{"number":"2","text":["āmāra gaurāṅger ghāṭe ujānakheyā vaya","kaḍipāti nāhi lāge amani pāra haya"],"translation":["My Lord Gaurāṅga stands at the jetty ready to ferry his servants upstream across this material existence. For no charge He is immediately taking them."],"isLong":false},{"number":"3","text":["hari-nāmera tarīkhāni śrī-guru-kāṇḍārī","saṅkīrtana-keroyāla du’bāhu pasāri"],"translation":["The ferry-boat is the Holy Names of the Lord and the spiritual master is the captain. The oars are the outstretched arms in the saṅkīrtan."],"isLong":false},{"number":"4","text":["sarva-jīva uddhāra haila premera vātāse","lochana paḍiyā raila karamera doṣe"],"translation":["The favourable wind is divine love for Lord Kṛṣṇa, and all the fallen souls have been rescued on this boat. Only Lochan Dās is left behind due to the faults of his own misdeeds."],"isLong":false}],"resources":{"audio":[{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/ke-jabi","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Ke-jabi-ke-jabi-02-22"},"head":{"canonical":"/en/ke-jabi-ke-jabi-bhai-bhava-sindhu-para/","description":"Ke Yābi Ke Yābi Bhāi? — a Vaiṣṇava song by Śrīla Lochan Dās Ṭhākur with lyrics, English translation and word-by-word meaning. From Kirtan Guide.","title":"Ke Yābi Ke Yābi Bhāi?. by Śrīla Lochan Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en","slug":"ke-jabi-ke-jabi-bhai-bhava-sindhu-para"}}