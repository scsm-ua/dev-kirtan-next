,"isWbwInlineModeAvailable":false,"inline_word_by_word":[[{"text":"śrī","trans":"Se","sep":"-","error":"mismatch"},{"text":"kṛṣṇa-kīrtane","trans":"você tem","sep":" ","error":"mismatch"},{"text":"yadi","trans":"uma mente","sep":" ","error":"mismatch"},{"text":"mānasa","trans":"para cantar","sep":" ","error":"mismatch"},{"text":"tohāra","trans":"o Nome de Śrī Kṛṣṇa, [então com]","sep":"","error":"mismatch"}],[{"text":"parama","trans":"grande","sep":" "},{"text":"yatane","trans":"cuidado","sep":" "},{"text":"ta̐hi","trans":"obtenha","sep":" ","error":"mismatch"},{"text":"labha","trans":"a qualificação","sep":" ","error":"mismatch"},{"text":"adhikāra","trans":"para isso","sep":"","error":"mismatch"}]]},{"number":"2","text":["tṛṇādhika hīna, dīna, akiñchana, chhāra","āpane mānabi sadā chhāḍi’ ahaṅkāra"],"word_by_word":["**chhāḍi’**–Abandone [seu] **ahaṅkāra**–falso ego, [e] **sadā**–sempre **mānabi**–considere **āpane**–se [a si] **hīna**–mais baixo **adhika**–do que [uma folha de] **tṛṇa**–grama, **dīna**–pobre, **akiñchana**–necessitado, [e] **chhāra**–mesquinho."],"translation":["Abandone seu falso ego, e sempre se considere mais baixo que uma folha de grama, pobre, necessitado, e mesquinho."],"isLong":false,"isWbwInlineModeAvailable":false,"inline_word_by_word":[[{"text":"tṛṇādhika","trans":"Abandone [seu]","sep":" ","error":"mismatch"},{"text":"hīna","trans":"falso ego, [e]","sep":", ","error":"mismatch"},{"text":"dīna","trans":"sempre","sep":", ","error":"mismatch"},{"text":"akiñchana","trans":"considere","sep":", ","error":"mismatch"},{"text":"chhāra","trans":"se [a si]","sep":"","error":"mismatch"}],[{"text":"āpane","trans":"mais baixo","sep":" ","error":"mismatch"},{"text":"mānabi","trans":"do que [uma folha de]","sep":" ","error":"mismatch"},{"text":"sadā","trans":"grama","sep":" ","error":"mismatch"},{"text":"chhāḍi","trans":"pobre","sep":"’ ","error":"mismatch"},{"text":"ahaṅkāra","trans":"necessitado, [e]","sep":"","error":"mismatch"}]]},{"number":"3","tex