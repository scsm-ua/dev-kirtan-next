verses":[{"number":"1","text":["akrodha paramānanda nityānanda rāya","abhimāna-śūnya nitāi nagare beḍāya"],"translation":["O sem ira, sem orgulho, supremamente feliz Nityānanda Rāy vagueia por todas as cidades."],"isLong":false},{"number":"2","text":["adhama patita jīver dvāre dvāre giyā","hari-nāma mahāmantra dena bilāiyā"],"translation":["Indo de porta em porta às casas das almas baixas e caídas, Ele distribui o mahāmantra Hare Kṛṣṇa."],"isLong":false},{"number":"3","text":["yāre dekhe tāre kahe dante tṛṇa dhari’","āmāre kiniyā laha bhaja gaurahari"],"translation":["Com uma palha entre Seus dentes, Ele diz a quem quer que Ele veja: “Compre-me: simplesmente sirva Gaurahari.”"],"isLong":false},{"number":"4","text":["eta bali’ nityānanda bhūme gaḍi yāya","sonāra parvata yena dhūlāte loṭāya"],"translation":["Dizendo isso, Nityānanda rola no chão como uma montanha dourada rolando na poeira."],"isLong":false},{"number":"5","text":["hena avatāre yāra rati nā janmila","lochan bale sei pāpī ela āra gela"],"translation":["Lochan Dās diz daquele que não desenvolveu apego a esse Avatār: “Tal pecador simplesmente veio e se foi.”"],"isLong":false},{"text":["(yāoyā āsā sār ha-ila)","(nitāi-charaṇ nā bhajila yāoyā āsā sār ha-ila)"],"translation":["“Eles simplesmente vieram e se foram. Aqueles que não serviram os pés de Nitāi simplesmente vieram e se foram (nasceram e morreram inutilmente).”"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/20-akrodha-paramananda-nityananda-ray-6","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.K. Ashram Maharaj","embed_url":"https://soundcloud.com/scsmathcolombia/11-akrodha-paramananda","personSlug":"srila-b-k-ashram-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/acharya-maharaj-akrodha","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Srila B.R. Madhusudan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-akrodha","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/akrodha-paramananda","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Akrodha-paramānanda-08-30"},"head":{"canonical":"/pt/akrodha-paramananda/","description":"Akrodha paramānanda — uma canção vaiṣṇava de Śrīla Lochan Dās Ṭhākur com letra, tradução em português e significado palavra por palavra. Do livro «Livro de Kirtan».","title":"Akrodha paramānanda. Śrīla Lochan Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"pt","slug":"akrodha-paramananda"}}