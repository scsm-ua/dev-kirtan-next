ng":{"meta":{"page":62,"first_line":"śrī kṛṣṇa chaitanya prabhu dayā kara more"},"title":["Sāvaraṇa-Śrī-Gaura-pāda-padme Prārthanā"],"author":["Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["śrī kṛṣṇa chaitanya prabhu dayā kara more","tomā vinā ke dayālu jagata mājhāre"],"translation":["Ó Śrī Kṛṣṇa Chaitanya Mahāprabhu! Seja misericordioso comigo. A não ser Você, quem é misericordioso neste mundo?"],"isLong":false},{"number":"2","text":["patita-pāvana-hetu tava avatāra","mo sama patita prabhu nā pāibe āra"],"translation":["Você descendeu para salvar as almas caídas. Ó Senhor, Você não vai encontrar outra alma tão caída quanto eu."],"isLong":false},{"number":"3","text":["hā hā prabhu nityānanda premānanda sukhī","kṛpāvalokana kara āmi baḍa duḥkhī"],"translation":["Ó Nityānanda! Você é radiante de amor divino. Me dê Seu olhar misericordioso. Eu estou muito triste."],"isLong":false},{"number":"4","text":["dayā kara sītā-pati advaita gosāñi","tava kṛpā-bale pāi chaitanya-nitāi"],"translation":["Ó Advaita Gosāi, Senhor de Sītā Ṭhākurāṇī! Seja misericordioso comigo. Pela Sua misericórdia alcançarei Śrī Chaitanya e Nitāi."],"isLong":false},{"number":"5","text":["gaura-premamaya-tanu paṇḍit gadādhara","śrīnivāsa haridāsa dayāra sāgara"],"translation":["Ó Gadādhar Paṇḍit, personificação do amor por Śrī Gaura! Ó oceanos de misericórdia, Śrīvās Paṇḍit e Hari Dās Ṭhākur!"],"isLong":false},{"number":"6","text":["hā hā svarūpa sanātana rūpa raghunātha","bhaṭṭa-yuga śrī jīva hā prabhu lokanātha"],"translation":["Ó Svarūp Dāmodar, Sanātan, Rūpa, Raghunāth Dās, Raghunāth Bhaṭṭa, Gopāl Bhaṭṭa e Śrī Jīva! Ó Lokanāth Prabhu!"],"isLong":false},{"number":"7","text":["dayā kara śrī-āchārya prabhu śrīnivāsa","rāmachandra-saṅga māge narottama dāsa"],"translation":["Ó Śrīnivās Āchārya Prabhu! Seja misericordioso! Narottam Dās ora pela associação de Rāmachandra Kavirāj."],"isLong":false},{"number":"8","text":["dayā kara prabhupāda śrī-gaura-prakāśa","tava jana kṛpā māge ei adhama dāsa"],"translation":["Ó Śrīla Prabhupād, manifestação de Śrī Gaura! Seja misericordioso. Este servo caído ora pela misericórdia de seus associados. *(Verso de Śrīla Bhakti Rakṣak Śrīdhar Dev-Goswāmī Mahārāj)*"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-savarana-sri","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-sri-krishna-1","personSlug":"nabadwip-temple"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-sri-krishna","personSlug":"nabadwip-temple"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/acharyamaharaj/2-savarana-sri-gaura-pada","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Srila B.R. Madhusudan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-sri-krishna","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Srila B.S. Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/goswami-maharaj-sri-krsna","personSlug":"srila-b-s-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/sri-krishna-chaitanya-prabhu","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-savarana-sri-gaura-pada-padme-sri-krishna-chaitanya-prabhu-doya-koro-more","personSlug":"bhakti-lalita-devi"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Sāvaraṇa-Śrī-Gaura-pāda-padme-Prārthanā-08-30"},"head":{"canonical":"/pt/shri-krishna-chaitanya-prabhu-daya-kara-more/","description":"Sāvaraṇa-Śrī-Gaura-pāda-padme Prārthanā — uma canção vaiṣṇava de Śrīla Narottam Dās Ṭhākur com letra, tradução em português e significado palavra por palavra. Do 