rst_line":"he deva bhavantaṁ vande"},"title":["He deva bhavantaṁ vande"],"author":["Śrīla Rūpa Goswāmī Prabhu"],"verses":[{"number":"1","text":["he deva bhavantaṁ vande","man-mānasa-madhukaram arpaya nija-pada-","paṅkaja-makarande"],"translation":["Ó Senhor, eu ofereço minha reverência a Você. Por favor, coloque a abelha do meu coração no mel de Seus pés de lótus."],"isLong":false},{"number":"2","text":["yadapi samādhiṣu vidhir api paśyati","na tava nakhā gramarīchim","idam ichāmi niśamya tavāchyuta","tad api kṛpādbhuta vīchim"],"translation":["Ó Achyuta! Mesmo Brahmā, em samādhi, não pode ver o brilho das pontas das unhas de Seus pés, mas eu ouvi falar das ondas da Sua maravilhosa misericórdia, e eu desejo vê-las."],"isLong":false},{"number":"3","text":["bhaktir udañchati yad api mādhava","na tvayi mama tila-mātrī","parameśvaratā tad api tavādhika-","durghaṭa-ghaṭana-vidhātrī"],"translation":["Ó Mādhava! Embora eu não tenha sequer uma semente de gergelim de devoção a Você, seu poder supremo é o criador dos mais improváveis milagres."],"isLong":false},{"number":"4","text":["ayam avilolatayādya sanātana","kalitādbhuta-rasa-bhāram","nivasatu nityam ihāmṛta-nindini","vindan madhurima-sāram"],"translation":["Ó Senhor eterno, que a abelha do meu coração viva estável e eternamente em Seus pés de lótus, onde há abundância do mais maravilhoso mel—que ultrapassa o néctar da imortalidade—e assim atinja a doçura final."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-he-deva","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.P. Janardan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/janardan-maharaj-he-deva","personSlug":"srila-b-p-janardan-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/he-deva-bhavantam","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-kabe-habe-bolo-acapella","personSlug":"bhakti-lalita-devi"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/He-deva-bhavantaṁ-vande-08-30"},"head":{"canonical":"/pt/he-deva-bhavantam-vande/","description":"He deva bhavantaṁ vande — uma canção vaiṣṇava de Śrīla Rūpa Goswāmī Prabhu com letra, tradução em português e significado palavra por palavra. Do livro «Livro de Kirtan».","title":"He deva bhavantaṁ vande. Śrīla Rūpa Goswāmī Prabhu | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"pt","slug":"he-deva-bhavantam-vande"}}