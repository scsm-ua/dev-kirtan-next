h":"/pt/namamishvaram-sachchidananda-rupam/","title":"Śrī Śrī Dāmodarāṣtakam"},"next":{"path":"/pt/mahaprasade-govinde-nama-brahmani/","title":"Mahāprasāda"}}},"song":{"meta":{"page":223,"first_line":"hari haraye namaḥ kṛṣṇa yādavāya namaḥ"},"title":["Nām-saṅkīrtan"],"author":["Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["hari haraye namaḥ kṛṣṇa yādavāya namaḥ","yādavāya mādhavāya keśavāya namaḥ"],"translation":["Ó Senhor, Kṛṣṇa, Yādava, Hari, Mādhava, Keśava, repetidamente ofereço minha reverência a Ti."],"isLong":false},{"number":"2","text":["gopāla govinda rāma śrī madhusūdana","giridhārī gopīnātha madana-mohana"],"translation":["Toda glória a Gopāl, Govinda, Rām, Śrī Madhusūdan, Giridhārī, Gopīnāth, Madan Mohan!"],"isLong":false},{"number":"3","text":["śrī-chaitanya nityānanda śrī advaitachandra","gadādhara śrīvāsādi gaura-bhakta-vṛnda"],"translation":["Toda glória a Śrī Chaitanya, Nityānanda, Advaitachandra, Gadādhar, Śrivās e todos os devotos do Senhor!"],"isLong":false},{"number":"4","text":["jaya rūpa sanātana bhaṭṭa raghunātha","śrī-jīva gopāla-bhaṭṭa dāsa raghunātha"],"translation":["Toda glória a Śrī Rūpa, Sanātan, Raghunāth Bhaṭṭa, Śrī Jīva, Gopāl Bhaṭṭa e Raghunāth Dās!"],"isLong":false},{"number":"5","text":["ei chhaya gosāñi kari charaṇa vandana","yāhā haite vighna-nāśa abhīṣṭa-pūraṇa"],"translation":["Ofereço minha reverência a esses seis goswāmīs. Ao fazê-lo, todos os obstáculos são destruídos e todos os desejos são realizados."],"isLong":false},{"number":"6","text":["ei chhaya gosāñi yā̐ra mu̐i tā̐ra dāsa","tā̐-sabāra pada-reṇu mora pañcha-grāsa"],"translation":["Eu sou um servo desses seis goswāmīs. A poeira de seus pés são minhas cinco formas de alimento."],"isLong":false},{"number":"7","text":["tā̐dera charaṇa sevi bhakta sane vāsa","janame janame mora ei abhilāṣa"],"translation":["Viver com os devotos que servem os pés deles é o meu desejo, nascimento após nascimento."],"isLong":false},{"number":"8","text":["ei chhaya gosāñi yabe vraje kailā vāsa","rādhā-kṛṣṇa-nitya-līlā karilā prakāśa"],"translation":["Quando esses seis goswāmīs viveram em Vraja, eles revelaram os Passatempos eternos de Rādhā–Kṛṣṇa."],"isLong":false},{"number":"9","text":["ānande bala hari bhaja vṛndāvana","śrī-guru-vaiṣṇava-pade majāiyā mana"],"translation":["Cante alegremente: ‘Hari!’, e adore Vṛndāvan, meditando nos pés de Śrī Guru e dos Vaiṣṇavas."],"isLong":false},{"number":"10","text":["śrī-guru-vaiṣṇava-pāda-padma kari āśa","(hari) nāma-saṅkīrtana kahe narottama dāsa"],"translation":["Aspirando aos pés de lótus de Śrī Guru e dos Vaiṣṇavas, Narottam Dās canta o Santo Nome."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-hari-haraye","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-hari-haraye","personSlug":"nabadwip-temple"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-xari-xaraje","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/hari-haraye-namah-krishna","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-nama-sankirttan-hari-haraye-namah-krishna","personSlug":"bhakti-lalita-devi"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Nām-saṅkīrtan-08-30"},"head":{"canonical":"/pt/hari-haraye-namah-krishna-yadavaya-namah/","description":"Nām-saṅkīrtan — uma canção vaiṣṇava de Śrīla Narottam Dās Ṭhākur com letra, tradução em português e significado palavra por palavra. Do livro «Livro de Kirtan».","title":"Nām-saṅkīrtan. Śrīla Narottam Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookI