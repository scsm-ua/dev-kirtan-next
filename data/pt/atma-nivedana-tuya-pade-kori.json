erses":[{"number":"1","text":["ātma-nivedana    tuyā pade kari","    ha-inu parama sukhī","duḥkha dūre gela    chintā nā rahila","    chaudike ānanda dekhi"],"word_by_word":["**ātma-nivedana kari’**–Me entregando [aos] **tuyā**–Seus **pade**–pés **ha-inu**–eu me tornei **parama**–supremamente **sukhī**–feliz. [Todo meu] **duḥkha**–pesar **gela**–foi [para] **dūre**–longe, **nā**–não **rahila**–ficou **chintā**–pensamento, ansiedade. **dekhi**–Eu vejo **ānanda**–êxtase **chaudike**–nas quatro direções."],"translation":["Entregando-me a Seus pés, eu fiquei completamente feliz. Toda minha angústia se foi, não tenho mais ansiedade, e vejo alegria em todas as direções."],"isLong":false,"isWbwInlineModeAvailable":false,"inline_word_by_word":[[{"text":"ātma-nivedana    tuyā","trans":"Me entregando [aos]","sep":" ","error":"multi"},{"text":"pade","trans":"Seus","sep":" ","error":"mismatch"},{"text":"kari","trans":"pés","sep":"","error":"mismatch"}],[{"text":"ha-inu","trans":"eu me tornei","sep":" ","error":"multi"},{"text":"parama","trans":"supremamente","sep":" "},{"text":"sukhī","trans":"feliz. [Todo meu]","sep":""}],[{"text":"duḥkha","trans":"pesar","sep":" "},{"text":"dūre","trans":"foi [para]","sep":" ","error":"mismatch"},{"text":"gela","trans":"longe","sep":"    ","error":"mismatch"},{"text":"chintā","trans":"não","sep":" ","error":"mismatch"},{"text":"nā","trans":"ficou","sep":" ","error":"mismatch"},{"text":"rahila","trans":"pensamento, ansiedade","sep":"","error":"mismatch"}],[{"text":"chaudike","trans":"Eu vejo","sep":" ","error":"mismatch"},{"text":"ānanda","trans":"êxtase","sep":" "},{"text":"dekhi","trans":"nas quatro direções","sep":"","error":"mismatch"}]]},{"number":"2","text":["aśoka-abhaya    amṛta-ādhāra","    tomāra charaṇa-dvaya","tāhāte ekhana    viśrāma labhiyā","    chhāḍinu bhavera bhaya"],"word_by_word":["**tomāra**–Seus **dvaya**–dois **charaṇa**–pés [são] **ādhāra**–reservatórios **aśoka**–de não lamentação **abhaya**–de destemor **amṛta**–de imortalidade. **tāhāte**–Neles **ekhana**–agora **labhiyā**–obtendo **viśrāma**–descanso **chhāḍinu**–eu abandonei [todo] **bhaya**–medo **bhavera**–da existência material, nascimento e morte cíclica."],"translation":["Seus pés são a morada da alegria, do destemor, e do néctar. Recebendo abrigo debaixo deles, eu abandonei todo o medo da existência material."],"isLong":false,"isWbwInlineModeAvailable":true,"inline_word_by_word":[[{"text":"aśoka","trans":"Seus","sep":"-","error":"mismatch"},{"text":"abhaya","trans":"dois","sep":"    ","error":"mismatch"},{"text":"amṛta","trans":"pés [são]","sep":"-","error":"mismatch"},{"text":"ādhāra","trans":"reservatórios","sep":""}],[{"text":"tomāra","trans":"de não lamentação","sep":" ","error":"mismatch"},{"text":"charaṇa","trans":"de destemor","sep":"-","error":"mismatch"},{"text":"dvaya","trans":"de imortalidade","sep":"","error":"mismatch"}],[{"text":"tāhāte","trans":"Neles","sep":" "},{"text":"ekhana","trans":"agora","sep":"    "},{"text":"viśrāma","trans":"obtendo","sep":" ","error":"mismatch"},{"text":"labhiyā","trans":"descanso","sep":"","error":"mismatch"}],[{"text":"chhāḍinu","trans":"eu abandonei [todo]","sep":" "},{"text":"bhavera","trans":"medo","sep":" ","error":"mismatch"},{"text":"bhaya","trans":"da existência material, nascimento e morte cíclica","sep":"","error":"mismatch"}]]},{"number":"3","text":["tomāra saṁsāre    kariba sevana","    nahiba phalera bhāgī","tava sukha yāhe    kariba yatana","    ha’ye pade anurāgī"],"word_by_word":["**kariba sevana**–Eu servirei [em] **tomāra**–Sua **saṁsāre**–casa [e] **nahiba**–não me tornarei **bhāgī**–sócio **phalera**–dos frutos. **ha’ye**–Sendo **anurāgī**–amorosamente apegado **pade**–aos Seus pés [tudo] **kariba**–eu farei [com] **yatana**–esforço cuidadoso **yāhe**–pela **tava**–Sua **sukha**–felicidade."],"translation":["Eu servirei em Sua casa e não me tornarei um desfrutador dos resultados. Amorosamente apegado aos Seus pés, eu farei com cuidado tudo o que lhe agrada."],"isLong":false,"isWbwInlineModeAvailable":false,"inline_word_by_word":[[{"text":"tomāra saṁsāre","trans":"Eu servirei [em]","sep":"    ","error":"mismatch"},{"text":"kariba","trans":"Sua","sep":" ","error":"mismatch"},{"text":"sevana","trans":"casa [e]","sep":"","error":"mismatch"}],[{"text":"nahiba","trans":"não me tornarei","sep":" "},{"text":"phalera","trans":"sócio","sep":" ","error":"mismatch"},{"text":"bhāgī","trans":"dos frutos","sep":"","error":"mismatch"}],[{"text":"tava sukha","trans":"Sendo","sep":" ","error":"mismatch"},{"text":"yāhe","trans":"amorosamente apegado","sep":"    ","error":"mismatch"},{"text":"kariba","trans":"aos Seus pés [tudo]","sep":" ","error":"mismatch"},{"text":"yatana","trans":"eu farei [com]","sep":"","error":"mismatch"}],[{"text":"ha","trans":"esforço cuidadoso","sep":"’","error":"mismatch"},{"text":"ye","trans":"pela","sep":" ","error":"mismatch"},{"text":"pade","trans":"Sua","sep":" ","error":"mismatch"},{"text":"anurāgī","trans":"felicidade","sep":"","error":"mismatch"}]]},{"number":"4","text":["tomāra sevāya    duḥkha haya yata","    seo ta’ parama sukha","sevā-sukha-duḥkha    parama sampada","    nāśaye avidyā-duḥkha"],"word_by_word":["**yata**–Toda **duḥkha**–dificuldade [que] **haya**–acontece [em] **tomāra**–Seu **sevāya**–serviço **se**–que **o**–também **ta’**–certamente [é minha] **parama**–suprema **sukha**–felicidade. [A] **sukha**–felicidade [e a] **duḥkha**–angústia [de Seu] **sevā**–serviço [são minha] **parama**–suprema **sampada**–fortuna [ambos] **nāśaye**–destroem [a] **duḥkha**–tristeza **avidyā**–da ignorância."],"translation":["Tanto a aflição quanto a felicidade que vêm de Seu serviço são minha grande fortuna. Ambos destroem a angústia da ignorância."],"isLong":false,"isWbwInlineModeAvailable":false,"inline_word_by_word":[[{"text":"tomāra","trans":"Toda","sep":" ","error":"mismatch"},{"text":"sevāya","trans":"dificuldade [que]","sep":"    ","error":"mismatch"},{"text":"duḥkha","trans":"acontece [em]","se