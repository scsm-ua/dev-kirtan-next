{"build":"3f725a0@18/11/2026, 19:55:55","data":{"book":{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"77":{"prev":{"path":"/pt/dayal-nitai-chaitanya-bole-nach-re/","title":"Dayāl Nitāi Chaitanya"},"next":{"path":"/pt/emona-durmati-samsara-bhitore/","title":"Dainyātmikā"}}},"song":{"meta":{"page":77,"first_line":"gaurāṅgera duṭi pada"},"title":["Sāvaraṇa-Śrī-Gaura-mahimā"],"author":["Śrīla Narottam Dās Ṭhākur"],"verses":[{"number":"1","text":["gaurāṅgera duṭi pada    yāra dhana sampada","    se jāne bhakati-rasa-sāra","gaurāṅgera madhura-līlā    yāra karṇe praveśilā","    hṛdaya nirmala bhela tāra"],"translation":["Aquele cuja fortuna são os pés de Śrī Gaurāṅga conhece a essência do rasa da devoção. O coração daquele que escuta os doces Passatempos de Śrī Gaurāṅga se torna puro."],"isLong":false},{"number":"2","text":["ye gaurāṅgera nāma laya    tāra haya premodaya","    tāre muñi yāi balihāri","gaurāṅga-guṇete jhure    nitya-līlā tāre sphure","    se jana bhakati-adhikārī"],"translation":["Aquele que canta os nomes de Śrī Gaurāṅga desenvolve amor divino. A ele eu digo: “Bravo!” Os eternos Passatempos são revelados àquele que chora sobre as qualidades de Śrī Gaurāṅga. Tal alma é qualificada para devoção."],"isLong":false},{"number":"3","text":["gaurāṅgera saṅgi-gaṇe    nitya-siddha kari māne","    se yāya vrajendra-suta-pāśa","śrī-gauḍa-maṇḍala-bhūmi    yebā jāne chintāmaṇi","    tāra haya vraja-bhūme vāsa"],"translation":["Aquele que considera que os associados de Śrī Gaurāṅga são eternamente liberados atinge Kṛṣṇa. Aquele que sabe que a terra sagrada de Gauḍa é feita da pedra preciosa que satisfaz os desejos (espirituais), reside na terra de Vraja."],"isLong":false},{"number":"4","text":["gaura-prema-rasārṇave    se taraṅge yebā ḍube","    se rādhā-mādhava-antaraṅga","gṛhe vā vanete thāke    ‘hā gaurāṅga’ bale ḍāke","    narottama māge tāra saṅga"],"translation":["Aquele que nada nas ondas do oceano nectáreo do amor divino por Śrī Gaura é um associado íntimo de Śrī Śrī Rādhā–Mādhava. Se ele vive em uma casa ou na floresta, Narottam Dās implora pela associação daquele que chama: “Gaurāṅga!”"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/25-gaurangera-duti-pada-3","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/acharyamaharaj/5-savarana-sri-gaura-mahima","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/gaurangera-duti-pada","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-savarana-sri-gaura-mahima-gaurangera-duti-pada","personSlug":"bhakti-lalita-devi"},{"title":"Caracas temple","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-gaurangera-duti","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Sāvaraṇa-Śrī-Gaura-mahimā-08-30"},"head":{"canonical":"/pt/gaurangera-duti-pada-jar-dhana-sampada/","description":"Sāvaraṇa-Śrī-Gaura-mahimā — uma canção vaiṣṇava de Śrīla Narottam Dās Ṭhākur com letra, tradução em português e significado palavra por palavra. Do livro «Livro de Kirtan».","title":"Sāvaraṇa-Śrī-Gaura-mahimā. Śrīla Narottam Dās Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"pt","slug":"gaurangera-duti-pada-jar-dhana-sampada"}}