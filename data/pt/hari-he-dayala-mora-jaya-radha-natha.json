umber":"1","text":["hari he dayāla mora jaya rādhā-nātha","bāra bāra ei-bāra laha nija sātha"],"translation":["Ó misericordioso Senhor! Toda glória a Você, o Senhor de Rādhā! De novo e de novo eu oro a Você. Neste momento considere-me Seu."],"isLong":false},{"number":"2","text":["bahu yoni bhrami’ nātha! la-inu śaraṇa","nija-guṇe kṛpā kara adhama tāraṇa"],"translation":["Ó Senhor! Depois de vagar por tantos ventres, eu tomei o Seu abrigo. Seja misericordioso e liberte esta alma caída através de Seu poder divino."],"isLong":false},{"number":"3","text":["jagata-kāraṇa tumi jagata-jīvana","toma chhāḍā kāro na’hi he rādhā-ramaṇa"],"translation":["Você é a causa e a vida do mundo. Sem Você, ninguém tem nada, Ó amante de Rādhā!"],"isLong":false},{"number":"4","text":["bhuvana-maṅgala tumi bhuvanera pati","tumi upekṣile nātha! ki ha-ibe gati"],"translation":["Você é a auspiciosidade e o mestre do universo. Ó Senhor! Se Você me negligenciar, qual será meu destino?"],"isLong":false},{"number":"5","text":["bhāviyā dekhinu ei jagata mājhāre","tomā vinā keha nāhi e dāse uddhāre"],"translation":["Eu compreendi que neste mundo não há ninguém a não ser Você para libertar este servo."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-hari-he-doyala","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/hari-he-doyala-mora","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Dainya-O-Prapatti-08-30"},"head":{"canonical":"/pt/hari-he-dayala-mora-jaya-radha-natha/","description":"Dainya O Prapatti — uma canção vaiṣṇava de Śrīla Bhakti Vinod Ṭhākur com letra, tradução em português e significado palavra por palavra. Do livro «Livro de Kirtan».","title":"Dainya O Prapatti | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"pt","slug":"hari-he-dayala-mora-jaya-radha-natha"}}