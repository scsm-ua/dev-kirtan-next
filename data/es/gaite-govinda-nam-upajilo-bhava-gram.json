d.com/huron/gaite-govinda-nam","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/gaite-govinda-nam","personSlug":"bhakti-lalita-devi"}]},"hasWbw":true,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Śikṣāṣṭakam-02-22-18"},"head":{"canonical":"/es/gaite-govinda-nam-upajilo-bhava-gram/","description":"Śrī Śikṣāṣṭakam — una canción vaiṣṇava de Śrīla Bhakti Vinod Ṭhākur con letra, traducción al español y significado palabra por palabra. Del libro «Guía de Kīrtan».","title":"Śrī Śikṣāṣṭakam. Canción 7 (b) | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"es","slug":"gaite-govinda-nam-upajilo-bhava-gram"}}