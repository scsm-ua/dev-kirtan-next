order":9,"songsCount":23}],"nav":{"11/1":{"prev":{"path":"/ru/gayatri-muralishta-kirtana-dhanam/","title":"Лого Шри Чайтанья Сарасват Матха"},"next":{"path":"/ru/vandana-full/","title":"Вандана (все молитвы на одной странице)"}}},"song":{"meta":{"page":"11/1","author":"Ш́рӣла Кришнада̄с Кавира̄дж Госва̄мӣ","first_line":"ванде ‘хам̇ ш́рӣ-гурох̣ ш́рӣ-йута-пада-камалам̇"},"title":["Вандана"],"verses":[{"text":["ванде ‘хам̇ ш́рӣ-гурох̣ ш́рӣ-йута-пада-камалам̇","    ш́рӣ-гурӯн ваиш̣н̣ава̄м̇ш́ ча","ш́рӣ-рӯпам̇ са̄граджа̄там̇ саха-ган̣а-","    рагхуна̄тха̄нвитам̇-там̇ са-джӣвам","са̄дваитам̇ са̄вадхӯтам̇ париджана-сахитам̇","    кр̣ш̣н̣а-чаитанйа-девам̇","ш́рӣ-ра̄дха̄-кр̣ш̣н̣а-па̄да̄н саха-ган̣а-лалита̄-","    ш́рӣ-виш́а̄кха̄нвита̄м̇ш́ ча"],"word_by_word":["**ванде** — поклоняюсь; **хам̇** — я; **ш́рӣ** — почтенного; **гурох̣** — учителя; **ш́рӣ** — славой; **йута** — украшенным; **пада** — стопам; **камалам̇** — лотосоподобным; **ш́рӣ** — почтенным; **гурӯн** — учителям; **ваиш̣н̣ава̄м̇ш́** — вайшнавам; **ча** — и; **ш́рӣ** — Шриле; **рӯпам̇** — Рупе (Госвами); **са̄граджа̄там̇** — со старшим братом (Санатаной Госвами); **саха** — вместе с; **ган̣а** — спутниками; **рагхуна̄тха̄нвитам̇** — с Рагхунатхой (Госвами); **там̇** — ему; **са** — с; **джӣвам** — Дживой (Госвами); **са̄дваитам̇** — с Адвайтой (Ачарьей); **са̄вадхӯтам̇** — с Авадхутом (Нитьянандой); **париджана** — (они) окружение; **сахитам̇** — сопровождающее; **кр̣ш̣н̣а** — Кришна; **чаитанйа** — Чайтанью (Махапрабху); **девам̇** — Господа; **ш́рӣ** — Шри; **ра̄дха̄** — Радхи; **кр̣ш̣н̣а** — Кришны; **па̄да̄н** — стопам; **саха** — вместе с; **ган̣а** — (их) спутницами; **лалита̄** — Лалитой; **ш́рӣ** — (и) Шри; **виш́а̄кха̄нвита̄м̇ш́** — Вишакхой; **ча** — также."],"translation":["(Шрила Кришнадас Кавирадж Госвами молится): «Я в смирении склоняюсь к лотосоподобным стопам моего духовного учителя, всех духовных наставников и вайшнавов. Я почтительно склоняюсь перед своими *шастра-гуру*: Шрилой Рупой Госвами и его старшим братом Шрилой Санатаной Госвами, а также перед Шрилой Рагхунатхом Дасом Госвами и Шрилой Дживой Госвами. Я выражаю почтение тем, кто еще более возвышен: Шри Чайтанье Махапрабху, нисшедшему со Своими атрибутами и спутниками — такими великими личностями, как Шри Нитьянанда Прабху и Шри Адвайта Ачарья. С великим благоговением я склоняюсь к лотосоподобным стопам Шри Шри Радхи-Говинды и всех *гопи*, возглавляемых Лалитой Деви и Вишакхой Деви»."],"isLong":false,"isWbwInlineModeAvailable":true,"inline_word_by_word":[[{"text":"ванде","trans":"поклоняюсь","sep":" "},{"text":"‘хам̇","trans":"я","sep":" "},{"text":"ш́рӣ","trans":"почтенного","sep":"-"},{"text":"гурох̣","trans":"учителя","sep":" "},{"text":"ш́рӣ","trans":"славой","sep":"-"},{"text":"йута","trans":"украшенным","sep":"-"},{"text":"пада","trans":"стопам","sep":"-"},{"text":"камалам̇","trans":"лотосоподобным","sep":""}],[{"text":"ш́рӣ","trans":"почтенным","sep":"-"},{"text":"гурӯн","trans":"учителям","sep":" "},{"text":"ваиш̣н̣ава̄м̇ш́","trans":"вайшнавам","sep":" "},{"text":"ча","trans":"и","sep":""}],[{"text":"ш́рӣ","trans":"Шриле","sep":"-"},{"text":"рӯпам̇","trans":"Рупе (Госвами)","sep":" "},{"text":"са̄граджа̄там̇","trans":"со старшим братом (Санатаной Госвами)","sep":" "},{"text":"саха","trans":"вместе с","sep":"-"},{"text":"ган̣а","trans":"спутниками","sep":"-"}],[{"text":"рагхуна̄тха̄нвитам̇","trans":"с Рагхунатхой (Госвами)","sep":"-"},{"text":"там̇","trans":"ему","sep":" "},{"text":"са","trans":"с","sep":"-"},{"text":"джӣвам","trans":"Дживой (Госвами)","sep":""}],[{"text":"са̄дваитам̇","trans":"с Адвайтой (Ачарьей)","sep":" "},{"text":"са̄вадхӯтам̇","trans":"с Авадхутом (Нитьянандой)","sep":" "},{"text":"париджана","trans":"(они) окружение","sep":"-"},{"text":"сахитам̇","trans":"сопровождающее","sep":""}],[{"text":"кр̣ш̣н̣а","trans":"Кришна","sep":"-"},{"text":"чаитанйа","trans":"Чайтанью (Махапрабху)","sep":"-"},{"text":"девам̇","trans":"Господа","sep":""}],[{"text":"ш́рӣ","trans":"Шри","sep":"-"},{"text":"ра̄дха̄","trans":"Радхи","sep":"-"},{"text":"кр̣ш̣н̣а","trans":"Кришны","sep":"-"},{"text":"па̄да̄н","trans":"стопам","sep":" "},{"text":"саха","trans":"вместе с","sep":"-"},{"text":"ган̣а","trans":"(их) спутницами","sep":"-"},{"text":"лалита̄","trans":"Лалитой","sep":"-"}],[{"text":"ш́рӣ","trans":"(и) Шри","sep":"-"},{"text":"виш́а̄кха̄нвита̄м̇ш́","trans":"Вишакхой","sep":" "},{"text":"ча","trans":"также","sep":""}]]},{"text":["ом̇ аджн̃а̄на-тимира̄ндхасйа джн̃а̄на̄н̃джана-ш́ала̄кайа̄","чакш̣ур унмилитам̇ йена тасмаи ш́рӣ-гураве намах̣"],"word_by_word":["**ом̇** — (ом); **аджн̃а̄на** — невежества; **тимира̄ндхасйа** — тьмой ослеплённый; **джн̃а̄на̄н̃джана** — знания глазная мазь; **ш́ала̄кайа̄** — (нанесённая) палочкой; **чакш̣ур** — (на) глаза; **унмилитам̇** — (и они) открытылись; **йена** — (благодаря) кому; **тасмаи** — тому; **ш́рӣ** — почтенному; **гураве** — учителю; **намах̣** — поклоняюсь."],"translation":["Умастив мои глаза целительным бальзамом *самбандха-гьяны*, правильного восприятия окружающего мира, духовный учитель пробудил мое внутреннее видение и вывел меня из тьмы невежества, подарив надежду. В глубоком почтении я склоняюсь перед Шри Гурудевом."],"isLong":true,"isWbwInlineModeAvailable":true,"inline_word_by_word":[[{"text":"ом̇","trans":"(ом)","sep":" "},{"text":"аджн̃а̄на","trans":"невежества","sep":"-"},{"text":"тимира̄ндхасйа","trans":"тьмой ослеплённый","sep":" "},{"text":"джн̃а̄на̄н̃джана","trans":"знания глазная мазь","sep":"-"},{"text":"ш́ала̄кайа̄","trans":"(нанесённая) палочкой","sep":""}],[{"text":"чакш̣ур","trans":"(на) глаза","sep":" "},{"text":"унмилитам̇","trans":"(и они) открытылись","sep":" "},{"text":"йена","trans":"(благодаря) кому","sep":" "},{"text":"тасмаи","trans":"тому","sep":" "},{"text":"ш́рӣ","trans":"почтенному","sep":"-"},{"text":"гураве","trans":"учителю","sep":" "},{"text":"намах̣","trans":"поклоняюсь","sep":""}]]}],"resources":{"audio":[{"title":"Шрила Б.С. Говинда Дев-Госвами Махарадж","embed_url":"h