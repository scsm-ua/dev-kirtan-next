{"build":"6c7a310@16/11/2026, 18:43:24","data":{"book":{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":71},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":7,"songsCount":80},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":8,"hidden":true,"songsCount":166}],"nav":{"120":{"prev":{"path":"/ru/gaurangera-duti-pada-jar-dhana-sampada/","title":"Саварана-Шри-Гаура-махима"},"next":{"path":"/ru/avatara-sara-gora-avatara/","title":"Аватара Сара"}}},"song":{"meta":{"page":120,"first_line":"гаура̄ паху̐ на бхаджийа̄ маину"},"title":["Aкшепа"],"author":["Ш́рӣла Нароттам Да̄с Т̣ха̄кур"],"verses":[{"number":"1","text":["гаура̄ паху̐ на бхаджийа̄ маину","према ратана-дхана хела̄йа ха̄ра̄ину"],"translation":["Господь Гаура! Я не поклонялся Тебе и из-за этого лишился жемчужины божественной любви."],"isLong":false},{"number":"2","text":["адхане джатана кори дхана тейа̄-гину","а̄пана карама дош̣е а̄пани д̣убину"],"translation":["Я нуждаюсь в Твоем богатстве, но сделал все, чтобы отвергнуть его, погрузившись в греховную материалистичную жизнь."],"isLong":false},{"number":"3","text":["сат-сан̇га чха̄д̣и коину асате вила̄са","те-ка̄ран̣а ла̄гило дже карма-бандха-пха̄н̇са"],"translation":["Избегая общения со святыми, я наслаждался обществом материалистов, поэтому и угодил в капкан деятельности ради плодов и ее последствий."],"isLong":false},{"number":"4","text":["виш̣ойа-биш̣ама-биш̣а сатата кха̄ину","гаура-кӣрттана расе магана на хоину"],"translation":["Я упивался ядом чувственных мирских наслаждений и отвергал нектар воспевания имен Господа Гауры."],"isLong":false},{"number":"5","text":["кено ба̄ а̄чхайе пра̄н̣а ки сукха ла̄гийа̄","нароттама да̄са кено на̄ гело морийа̄"],"translation":["Почему мое сердце не чувствует счастья? Почему Нароттам Дас не умер?"],"isLong":false},{"text":["(джайа гаурахари)"],"isLong":false}],"resources":{"audio":[{"title":"Манаса Кришна Прабху","embed_url":"https://soundcloud.com/huron/gora-panhu-na-bhajiya-mainu","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Akshepa-02-22"},"head":{"canonical":"/ru/gaura-pahu-na-bhajiya-mainu/","description":"Aкшепа — вайшнавская песня с текстом, русским переводом и пословным разбором. Автор — Ш́рӣла Нароттам Да̄с Т̣ха̄кур. Из сборника «Гаудия Гитанджали».","title":"Aкшепа. Ш́рӣла Нароттам Да̄с Т̣ха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ru","slug":"gaura-pahu-na-bhajiya-mainu"}}