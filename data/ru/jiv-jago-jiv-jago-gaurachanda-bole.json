egacy":true,"sort_order":9,"songsCount":23}],"nav":{"43":{"prev":{"path":"/ru/udilo-aruna-puraba-bhage/","title":"Арунодойа-киртан (часть 1)"},"next":{"path":"/ru/jaya-jaya-gurudever-arati-ujjvala/","title":"Шри Гуру Арати"}}},"song":{"meta":{"page":43,"first_line":"джӣв джа̄го, джӣв джа̄го, гаурача̄н̇да боле"},"title":["Арунодойа-киртан"],"author":["Ш́рӣла Бхактивинод Т̣ха̄кур"],"subtitle":[" Часть 2"],"verses":[{"number":"1","text":["джӣв джа̄го, джӣв джа̄го, гаурача̄н̇да боле","кота нидра̄ джа̄о ма̄йа̄-пиш́а̄чӣра коле"],"translation":["Господь Гауранга взывает: «Проснитесь, спящие души! Проснитесь, спящие души! Вы так долго спали на коленях у ведьмы Майи!»"],"isLong":false},{"number":"2","text":["бхаджибо болийа̄ эсэ сам̇са̄ра-бхитаре","бхулийа̄ рохиле туми авидйа̄ра бхоре"],"translation":["«Вы пришли в этот мир со словами: „Мой Господь, поверь, я буду поклоняться Тебе“, но, забыв об этом обещании, вы погрузились во тьму невежества!»"],"isLong":false},{"number":"3","text":["тома̄ре лоите а̄ми хоину авата̄ра","а̄ми бина̄ бандху а̄ра ке а̄чхе тома̄ра"],"translation":["«Я снизошел, чтобы спасти вас! Есть ли у вас друг, кроме Меня?»"],"isLong":false},{"number":"4","text":["энэчхи ауш̣адхи ма̄йа̄ на̄ш́иба̄ро ла̄ги’","хари-на̄ма маха̄-мантра лао туми ма̄ги’"],"translation":["«Я принес способ избавления от иллюзии (*майи*). Молитесь же об этой Харинама-*маха-мантре* и примите ее!»"],"isLong":false},{"number":"5","text":["бхакативинода прабху-чаран̣е под̣ийа̄","сэи хари-на̄ма-мантра лоило ма̄гийа̄"],"translation":["Тхакур Бхактивинод припал к лотосоподобным стопам Господа Гауранги и, моля о Святом Имени, получил *маха-мантру*!"],"isLong":false}],"resources":{"audio":[{"title":"Шрила Б.Б. Авадхут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Манаса Кришна Прабху","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Arunodoja-kirtan-02-22"},"head":{"canonical":"/ru/jiv-jago-jiv-jago-gaurachanda-bole/","description":"Арунодойа-киртан — вайшнавская песня с текстом, русским переводом и пословным разбором. Автор — Ш́рӣла Бхактивинод Т̣ха̄кур. Из сборника «Гаудия Гитанджали».","title":"Арунодойа-киртан.  Часть 2 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ru","slug":"jiv-jago-jiv-jago-gaurachanda-bole"}}