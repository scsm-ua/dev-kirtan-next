Count":23}],"nav":{"16":{"prev":{"path":"/en-pe/kali-kukkura-kadana-jadi-chao-he/","title":"Maṅgal Ārati"},"next":{"path":"/en-pe/jaya-shiachinandana-sura-muni-vandana/","title":"Śrī Śachīnandana-vandanā"}}},"song":{"meta":{"page":16,"first_line":"yaśomatī-nandana","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Śrī Nām-kīrtan"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["yaśomatī-nandana    vraja-vara-nāgara","    gokula-rañjana kāna","gopī-parāṇa-dhana    madana-manohara","    kāliya-damana vidhāna"],"translation":["Śrī Kṛṣṇa, who is known as Kān, is Yaśodā’s darling son, Vraja’s paramour, Gokula’s delight, the gopīs’ life and wealth, the enchanter of Cupid, and the conqueror of Kālīya."],"isLong":false},{"number":"2","text":["    amala hari-nāma amiya-vilāsā","vipina-purandara    navīna nāgara-vara","    vaṁśī-vadana suvāsā"],"translation":["His Names and nectarean Pastimes are all transcendental. He is the king of Vraja’s forests and the best of young paramours. He beautifully plays the flute."],"isLong":false},{"number":"3","text":["vraja-jana-pālana    asura-kula-nāśana","    nanda-godhana-rākhoyālā","govinda mādhava    navanīta-taṣkara","    sundara nanda-gopālā"],"translation":["He is the guardian of Vraja’s residents, the destroyer of the demons, and the keeper of Nanda’s cows. He is known as ‘Govinda’—He who nourishes the cows, senses, Vedas, and world—and ‘Mādhava’—Śrī Rādhā’s consort. He is Nanda’s beautiful cowherd boy and a butter thief."],"isLong":false},{"number":"4","text":["yamunā-taṭa-chara    gopī-vasana-hara","    rāsa-rasika kṛpāmaya","śrī-rādhā-vallabha    vṛndāvana-naṭa-vara","    bhakativinod-āśraya"],"translation":["He is a spy on the Yamunā’s banks and the stealer of the gopīs’ garments. He is the relisher of the rāsa-līlā and the embodiment of mercy. He is Śrī Rādhā’s beloved, Vṛndāvan’s great dancer, and Bhakti Vinod’s shelter."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-jasomati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati-2","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-yasomati","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-jasomati-nandana","personSlug":"nabadwip-temple"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-5","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-shri-nama","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.R. Madhusudan Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-day-programm-kisel","personSlug":"srila-b-r-madhusudan-maharaj"},{"title":"Srila B.S. Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/goswami-maharaj-yasomati","personSlug":"srila-b-s-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/yasomati-nandana","personSlug":"manasa-krishna-prabhu"},{"title":"Caracas temple","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-dzhashomati","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Nām-kīrtan-02-22"},"head":{"canonical":"/en-pe/jashomati-nandana-vraja-vara-nagara/","description":"Śrī Nām-kīrtan — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Śrī Nām-kīrtan. by Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"jashomati-nandana-vraja-vara-nagara"}}