va"}}},"song":{"meta":{"page":96,"first_line":"bhajahu̐ re mana","author":"Śrīla Govinda Dās Kavirāj"},"title":["Bhajahu̐ Re Mana"],"author":["by Śrīla Govinda Dās Kavirāj"],"verses":[{"number":"1","text":["bhajahu̐ re mana    śrī-nanda-nandana","    abhaya-charaṇāravinda re","durlabha mānava    janama sat-saṅge","    taraha e bhava-sindhu re"],"translation":["O mind, serve the son of Nanda’s lotus feet, which make one fearless. Having attained this rare human birth, cross over the ocean of material existence by associating with sādhus."],"isLong":false},{"number":"2","text":["śīta ātapa    vāta variṣaṇa","    e dina yāminī jāgi re","viphale sevinu    kṛpaṇa durajana","    chapala sukha-lava lāgi’ re"],"translation":["Day and night I remain awake, suffering from the heat and the cold, the wind and the rain. For a moment of flickering happiness I have uselessly served wicked and miserly men."],"isLong":false},{"number":"3","text":["e dhana, yauvana,    putra, parijana","    ithe ki āchhe paratīti re","kamala-dala-jala    jīvana ṭalamala","(ei āchhe ei nāi    jīvana ṭalamala)","    bhajahu̐ hari-pada niti re"],"translation":["What is there in having wealth, youth, sons, and family? Life is tottering like water on a lotus petal (it is here, and then it is gone). O mind, serve the Lord’s feet."],"isLong":false},{"number":"4","text":["śravaṇa, kīrtana,    smaraṇa, vandana","    pāda-sevana, dāsya re","pūjana, sakhī-jana,    ātma-nivedana","    govinda-dāsa-abhilāṣa re"],"translation":["Govinda Dās desires to engage in the nine practices of devotion: hearing about, glorifying, remembering, praying to, attending to, serving, worshipping, befriending, and surrendering to the Lord."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-bhajahu-re-1","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-bhajahu-re","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.K. Ashram Maharaj","embed_url":"https://soundcloud.com/scsmathcolombia/13-bhajahu-re-mana","personSlug":"srila-b-k-ashram-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/bhajahu-re-mana","personSlug":"manasa-krishna-prabhu"},{"title":"Bhakti Lalita Devi","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-bhajahu-re-mana","personSlug":"bhakti-lalita-devi"},{"title":"Caracas temple","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-bxadzhaxu-re","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Bhajahu-Re-Mana-02-22"},"head":{"canonical":"/en-pe/bhajahu-re-mana-shri-nanda-nandana/","description":"Bhajahu̐ Re Mana — a Vaiṣṇava song by Śrīla Govinda Dās Kavirāj with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Bhajahu̐ Re Mana. by Śrīla Govinda Dās Kavirāj | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"bhajahu-re-mana-shri-nanda-nandana"}}