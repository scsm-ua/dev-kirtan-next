Count":23}],"nav":{"29":{"prev":{"path":"/en-pe/jayare-jayare-jaya-gaura-sarasvati/","title":"Śrī Sāraswat Ārati"},"next":{"path":"/en-pe/udilo-aruna-puraba-bhage/","title":"Aruṇodoya-kīrtan, Part 1"}}},"song":{"meta":{"page":29,"first_line":"gurudeva! kṛpā-bindu diyā","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Gurudeva"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["gurudeva!","kṛpā-bindu diyā    kara’ ei dāse","    tṛṇāpekṣā ati dīna","sakala-sahane    bala diyā kara","    nija-māne spṛhā-hīna"],"translation":["O Gurudev! Give this servant a drop of your mercy, and make me more humble than a blade of grass. Give me the strength to tolerate everything, and make me free from any desire for personal honour."],"isLong":false},{"number":"2","text":["sakale sammāna    karite śakati","    deha nātha! yathā yatha","tabe ta’ gāiba    hari-nāma sukhe","    aparādha habe hata"],"translation":["O master! Give me the ability to befittingly honour everyone. Then I will sing the Lord’s Name happily, and all my offences will be eradicated."],"isLong":false},{"number":"3","text":["kabe hena kṛpā    labhiyā e jana","    kṛtārtha ha-ibe, nātha!","śakti-buddhi-hīna    āmi ati dīna","    kara more ātma-sātha"],"translation":["When will this soul attain such mercy and become fulfilled? O master! I am devoid of ability and intelligence, and greatly distressed. Please accept me."],"isLong":false},{"number":"4","text":["yogyatā-vichāre    kichhu nāhi pāi","    tomāra karuṇā-sāra","karuṇā nā ha-ile    kā̐diyā kā̐diyā","    prāṇa nā rākhiba āra"],"translation":["When I examine myself for qualifications, I find none. Your mercy is everything. If you are not merciful to me, then, crying, I will no longer maintain my life."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.R. Sridhar Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-6","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Sril