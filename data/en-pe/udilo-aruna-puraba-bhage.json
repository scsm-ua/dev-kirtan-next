Count":23}],"nav":{"30":{"prev":{"path":"/en-pe/gurudeva-kripa-bindu-diya-kara-ei-dase/","title":"Gurudeva"},"next":{"path":"/en-pe/jiv-jago-jiv-jago-gaurachanda-bole/","title":"Aruṇodoya-kīrtan, Part 2"}}},"song":{"meta":{"page":30,"first_line":"udila aruṇa pūrava-bhāge","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Aruṇodoya-kīrtan"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Part 1"],"verses":[{"number":"1","text":["udila aruṇa pūrava-bhāge","dvija-maṇi gorā amani jāge","bhakata-samūha la-iyā sāthe","    (gorā) gelā nagara-vrāje"],"translation":["The sun arises in the east, and the jewel of the brāhmaṇs, Śrī Gorāchā̐d, awakes. Taking His devotees with Him, He goes out about the town."],"isLong":false},{"number":"2","text":["‘tāthai tāthai’ bājala khola","ghana ghana tāhe jhā̐jera rola","preme ḍhala ḍhala sonāra aṅga","    (gorār) charaṇe nūpura bāje"],"translation":["The mṛdaṅgas resound ‘tāthai tāthai’ to the beat of the cymbals as Gaurasundar’s golden form sways with ecstatic love and His footbells jingle."],"isLong":false},{"number":"3","text":["mukunda mādhava yādava hari","balena bala re vadana bhari’","michhe nida-vaśe gela re rāti","    divasa śarīra sāje"],"translation":["He calls out, “Chant aloud Mukunda, Mādhava, Yādava, Hari! Uselessly you pass the night asleep and the day decorating your body."],"isLong":false},{"number":"4","text":["emana durlabha mānava-deha","pāiyā ki kara bhāvanā keha","ebe nā bhajile yaśodā-suta","    charame paḍibe lāje"],"translation":["“Having attained this rare human body, what are you thinking? If you do not serve Kṛṣṇa now, lastly you will fall into shame."],"isLong":false},{"number":"5","text":["udita tapana ha-ile asta","dina gela bali’ ha-ibe vyasta","tabe kena ebe alasa ha-i’","    nā bhaja hṛdaya-rāje"],"translation":["“When the shining sun sets, you become busy, considering that the day has passed. So why are you being lazy now? Why don’t you serve the Lord of your heart?"],"isLong":false},{"number":"6","text":["jīvana anitya jānaha sāra","tāhe nānā-vidha vipada-bhāra","nāmāśraya kari’ yatane tumi","    thākaha āpana kāje"],"translation":["“Understand the essence: life is temporary and filled with all sorts of adversity. Carefully taking shelter of the Name, engage in your work.”"],"isLong":false},{"number":"7","text":["kṛṣṇa-nāma-sudhā kariyā pāna","juḍāo bhakati-vinoda-prāṇa","nāma vinā kichhu nāhika āra","    chaudda-bhuvana-mājhe"],"translation":["Drink the nectar of Kṛṣṇa’s Name and soothe Bhakti Vinod’s soul. There is nothing to be had but the Name in all the fourteen worlds."],"isLong":false},{"number":"8","text":["jīvera kalyāṇa-sādhana-kāma","jagate āsi’ e madhura nāma","avidyā-timira-tapana-rūpe","    hṛd-gagane virāje"],"translation":["Desiring to bless all souls, the Lord’s sweet Name comes to this world and arises like the Sun within the sky of the heart to dispel the darkness of ignorance."],"isLong":false}],"resources":{"audio":[{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-udilo-aruna-jiv","personSlug":"nabadwip-temple"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-1","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Aruṇodoya-kīrtan-02-22-2"},"head":{"canonical":"/en-pe/udilo-aruna-puraba-bhage/","description":"Aruṇodoya-kīrtan — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Aruṇodoya-kīrtan. Part 1 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"udilo-aruna-puraba-bhage"}}