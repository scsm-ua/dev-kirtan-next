}},"song":{"meta":{"page":93,"author":"Śrīla Bhakti Vinod Ṭhākur","first_line":"hari he dayāla mora"},"title":["Dainya O Prapatti"],"verses":[{"number":"1","text":["hari he dayāla mora jaya rādhā-nātha","bāra bāra ei-bāra laha nija sātha"],"translation":["O merciful Lord! All glory to You, Rādhā’s Lord! Again and again I pray to You. This time take me as Your own."],"isLong":false},{"number":"2","text":["bahu yoni bhrami’ nātha! la-inu śaraṇa","nija-guṇe kṛpā kara adhama tāraṇa"],"translation":["O Lord! After wandering through many wombs, I have taken shelter of You. Be merciful and deliver this fallen soul by Your divine power."],"isLong":false},{"number":"3","text":["jagata-kāraṇa tumi jagata-jīvana","tomā chhāḍā kāro na’hi he rādhā-ramaṇa"],"translation":["You are the world’s cause and life. Without You, no one has anything, O Lover of Rādhā!"],"isLong":false},{"number":"4","text":["bhuvana-maṅgala tumi bhuvanera pati","tumi upekṣile nātha! ki ha-ibe gati"],"translation":["You are the world’s auspiciousness and master. O Lord! If You neglect me, what will be my fate?"],"isLong":false},{"number":"5","text":["bhāviyā dekhinu ei jagata mājhāre","tomā vinā keha nāhi e dāse uddhāre"],"translation":["I have understood that in this world there is no one but You to deliver this servant."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-hari-he-doyala","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/hari-he-doyala-mora","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Dainya-O-Prapatti-02-22"},"head":{"canonical":"/en-pe/hari-he-dayala-mora-jaya-radha-natha/","description":"Dainya O Prapatti — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Dainya O Prapatti | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"hari-he-dayala-mora-jaya-radha-natha"}}