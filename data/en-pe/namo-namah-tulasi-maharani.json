am/","title":"Vandanā"}}},"song":{"meta":{"page":36,"first_line":"namo namaḥ tulasī mahārāṇī","author":"Śrīla Chandraśekhar Āchārya"},"title":["Śrī Tulasī-parikramā-gīti"],"author":["by Śrīla Chandraśekhar Āchārya"],"verses":[{"text":["namo namaḥ tulasī mahārāṇī","vṛnde mahārāṇī namo namaḥ"],"translation":["O Tulasī Mahārāṇī, O Vṛndā Devī, I offer my obeisance unto you again and again."],"isLong":false},{"number":"1","text":["namo re namo re mā̐iyā namo nārāyaṇī"],"translation":["O Nārāyaṇī, I offer my obeisance unto you again and again."],"isLong":false},{"number":"2","text":["yā̐ko daraśe paraśe agha-nāśa hoi","mahimā veda-purāṇe vākhāni"],"translation":["By seeing or touching you, all sins are destroyed. Your glories are sung in the Vedas and Purāṇas."],"isLong":false},{"number":"3","text":["yā̐ko patra mañjarī komala","śrī-pati-charaṇa-kamale lepaṭāni"],"translation":["Your leaves and soft mañjarīs are twined around the lotus feet of Lakṣmī’s Lord."],"isLong":false},{"number":"4","text":["dhanya tulasī pūraṇa tapa kiye","śrī-śālagrāma-mahā-pāṭarāṇī"],"translation":["O fortunate Tulasī, by your performance of austerity you have become Śrī Śālagrām’s worshippable consort."],"isLong":false},{"number":"5","text":["dhūpa, dīpa, naivedya, ārati","phulanā kiye varakhā varakhāni"],"translation":["You shower mercy upon one who offers you incense, lamps, foods, worship, and flowers."],"isLong":false},{"number":"6","text":["chhāppānna bhoga, chhatriśa vyañjana","vinā tulasī prabhu eka nāhi māni"],"translation":["The Lord does not accept even one of fifty-six grain offerings or thirty-six vegetable offerings without tulasī leaves."],"isLong":false},{"number":"7","text":["śiva śuka nārada ā-ura brahmādika","ḍhu̐ḍata phirata mahā-muni jñānī"],"translation":["Śiva, Śukadev, Nārad, Brahmā, the other demigods, and the great learned sages all circumambulate you."],"isLong":false},{"number":"8","text":["chandraśekhara māiyā, terā yaśa gāoye","bhakati dāna dījiye mahārāṇī"],"translation":["O Tulasī Mahārāṇī, Chandraśekhar sings your glories. Give him the gift of devotion."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/05-namo-namah-tulasi-maharani-13","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-shri-tulasi","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/025-namonamahtulasimaharani-2","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/namo-namah-tulasi-maharani","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Tulasī-parikramā-gīti-02-22"},"head":{"canonical":"/en-pe/namo-namah-tulasi-maharani/","description":"Śrī Tulasī-parikramā-gīti — a Vaiṣṇava song by Śrīla Chandraśekhar Āchārya with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Śrī Tulasī-parikramā-gīti. by Śrīla Chandraśekhar Āchārya | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"namo-namah-tulasi-maharani"}}