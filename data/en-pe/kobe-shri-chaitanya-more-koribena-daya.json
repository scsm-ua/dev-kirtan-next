{"build":"6c7a310@16/11/2026, 18:43:24","data":{"book":{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":7,"songsCount":80},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":71},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":7,"songsCount":80},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":8,"hidden":true,"songsCount":166}],"nav":{"34":{"prev":{"path":"/en-pe/jiv-jago-jiv-jago-gaurachanda-bole/","title":"Aruṇodoya-kīrtan, Part 2"},"next":{"path":"/en-pe/namo-namah-tulasi-maharani/","title":"Śrī Tulasī-parikramā-gīti"}}},"song":{"meta":{"page":34,"first_line":"kabe śrī chaitanya more karibena dayā","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Dainya Prārthanā Gīti"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["kabe śrī chaitanya more karibena dayā","kabe āmi pāiba vaiṣṇava-pada-chhāyā"],"translation":["When will Śrī Chaitanya be merciful to me? When will I reach the shade of the Vaiṣṇavas’ feet?"],"isLong":false},{"number":"2","text":["kabe āmi chhāḍiba e viṣayābhimāna","kabe viṣṇu-jane āmi kariba sammāna"],"translation":["When will I give up this mundane ego? When will I honour the Lord’s devotees?"],"isLong":false},{"number":"3","text":["gala-vastra kṛtāñjali vaiṣṇava-nikaṭe","dante tṛṇa kari’ dā̐ḍāiba niṣkapaṭe"],"translation":["With a cloth around my neck, joined palms, and straw between my teeth, I will sincerely submit myself at the Vaiṣṇava’s feet."],"isLong":false},{"number":"4","text":["kā̐diyā kā̐diyā jānāiba duḥkha-grāma","saṁsāra-anala haite māgiba viśrāma"],"translation":["Weeping, I will convey my sorrows to the Vaiṣṇava and pray for shelter from the fire of material existence."],"isLong":false},{"number":"5","text":["śuniyā āmāra duḥkha vaiṣṇava ṭhākura","āmā’ lāgi’ kṛṣṇe āvedibena prachura"],"translation":["Hearing of my sorrow, the worshippable Vaiṣṇava will thoroughly pray to Kṛṣṇa on my behalf."],"isLong":false},{"number":"6","text":["vaiṣṇavera āvedane kṛṣṇa dayāmaya","e hena pāmara prati habena sadaya"],"translation":["Satisfied by the Vaiṣṇava’s prayer, Kṛṣṇa will be merciful to this sinner."],"isLong":false},{"number":"7","text":["vinodera nivedana vaiṣṇava-charaṇe","kṛpā kari’ saṅge laha ei akiñchane"],"translation":["Bhakti Vinod prays at the feet of the Vaiṣṇavas: “Mercifully take this lowly soul with you.”"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-kobe-sri","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-kobe-sri","personSlug":"nabadwip-temple"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/kobe-sri-chaitanya","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Dainya-Prārthanā-Gīti-02-22"},"head":{"canonical":"/en-pe/kobe-shri-chaitanya-more-koribena-daya/","description":"Dainya Prārthanā Gīti — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Dainya Prārthanā Gīti. by Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"kobe-shri-chaitanya-more-koribena-daya"}}