tle":["Siddhi-Lālasā"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["kabe gaura-vane    suradhunī-taṭe","    ‘hā rādhe hā kṛṣṇa’ ba’le","kā̐diyā beḍāba    deha-sukha chhāḍi’","    nānā latā-taru-tale"],"translation":["When will I abandon all bodily pleasures and wander along the banks of the Ganges beneath the trees and creepers in Śrī Gaurasundar’s forests, crying and calling out, “O Rādhā! O Kṛṣṇa!”?"],"isLong":false},{"number":"2","text":["śva-pacha-gṛhete    māgiyā khāiba","    piba sarasvatī-jala","puline puline    gaḍāgaḍi diba","    kari’ kṛṣṇa-kolāhala"],"translation":["When will I eat by begging food from the houses of dogeating outcasts and drink the water of the river Saraswatī? When will I roll about on the banks of the Ganges and uproariously call out, “Kṛṣṇa!”?"],"isLong":false},{"number":"3","text":["dhāma-vāsī jane    praṇati kariyā","    māgiba kṛpāra leśa","vaiṣṇava-charaṇa-    reṇu gāya mākhi","    dhari’ avadhūta-veśa"],"translation":["When will I bow down before the residents of Śrī Gaurasundar’s abode and beg for a particle of their mercy? When will I wear the garb of an avadhūt and smear my body with the dust of the devotees’ feet?"],"isLong":false},{"number":"4","text":["gauḍa-vraja-vane    bheda nā heriba","    ha-iba varaja-vāsī","dhāmera svarūpa    sphuribe nayane","    ha-iba rādhāra dāsī"],"translation":["When will I see no difference between the residents of Gauḍa and the residents of Vraja, and become a resident of Vraja? When will the true nature of the Lord’s abode manifest before my eyes? When will I become Śrī Rādhā’s maidservant?"],"isLong":false}],"resources":{"audio":[{"title":"Kamal Krishna Prabhu","embed_url":"https://soundcloud.com/jayasri-sound/46-kabe-gaura-vane","personSlug":"kamal-krishna-prabhu"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/kabe-gora-vane","personSlug":"manasa-krishna-prabhu"},{"title":"Sudarshan Prabhu","embed_url":"https://soundcloud.com/bharatimaharaj/sudarshan-prabhu-siddhi-lalasa","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Siddhi-Lālasā-02-22"},"head":{"canonical":"/en-pe/kobe-gaura-vane-suradhuni-tate/","description":"Siddhi-Lālasā — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Siddhi-Lālasā. by Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"kobe-gaura-vane-suradhuni-tate"}}