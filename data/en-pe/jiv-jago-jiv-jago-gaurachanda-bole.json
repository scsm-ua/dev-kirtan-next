rt_order":9,"songsCount":23}],"nav":{"32":{"prev":{"path":"/en-pe/udilo-aruna-puraba-bhage/","title":"Aruṇodoya-kīrtan, Part 1"},"next":{"path":"/en-pe/kobe-shri-chaitanya-more-koribena-daya/","title":"Dainya Prārthanā Gīti"}}},"song":{"meta":{"page":32,"first_line":"jīva jāga, jīva jāga","author":"Śrīla Bhakti Vinod Ṭhākur"},"title":["Aruṇodoya-kīrtan"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"subtitle":["Part 2"],"verses":[{"number":"1","text":["jīva jāga, jīva jāga, gorāchā̐da bale","kata nidrā yāo māyā-piśāchīra kole"],"translation":["Śrī Gorāchā̐d calls, “O souls, awake! O souls, awake! How long will you sleep in the clutches of the witch Māyā?"],"isLong":false},{"text":["(ār kata kāl ghumāibe?)","(māyā-piśāchīra kole ār kata kāl ghumāibe?)","(uṭha jīva, kṛṣṇa bhaja ār kata kāl ghumāibe?)"],"translation":["\"How much longer will you sleep? How much longer will you sleep in the lap of the witch Māyā? Arise soul! Serve Kṛṣṇa! How much longer will you sleep?"],"isLong":false},{"number":"2","text":["bhajiba baliyā ese saṁsāra-bhitare","bhuliyā rahile tumi avidyāra bhare"],"translation":["“You came into this world saying, ‘O Lord, I will serve You’, but, having forgotten this promise, you have remained in ignorance."],"isLong":false},{"text":["(bhuliyā rahile)","(avidyāra mohe paḍe tumi bhuliyā rahile)"],"translation":["“You forgot and remained. You fell into illusion’s bewilderment, forgot (your promise), and remained there."],"isLong":false},{"number":"3","text":["tomāre la-ite āmi ha-inu avatāra","āmi vinā bandhu āra ke āchhe tomāra"],"translation":["“I have descended to save you. Other than Me, who is your friend?"],"isLong":false},{"text":["(eman bandhu ār ke āchhe?)","(māyā-ha-ite uddhārite eman bandhu ār ke āchhe?)"],"translation":["“Who else is such a friend? Who else is there to rescue you from Māyā?"],"isLong":false},{"number":"4","text":["enechhi auṣadhi māyā nāśibāra lāgi’","hari-nāma mahā-mantra lao tumi māgi’"],"translation":["“I have brought the medicine to dispel Māyā. Pray for this Hari-nām mahāmantra and take it."],"isLong":false},{"text":["(māgiyā lao re)","(sudhā-mākhā ei hari-nām māgiyā lao re)"],"translation":["“Pray and take it. Pray for the Holy Name, which is dripping with nectar, and take it.”"],"isLong":false},{"number":"5","text":["bhakativinoda prabhura-charaṇe paḍiyā","sei hari-nāma-mantra la-ila māgiyā"],"translation":["Bhakti Vinod falls at the Lord’s feet, prays for the Hari-nām mahāmantra, and takes it."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Aruṇodoya-kīrtan-02-22"},"head":{"canonical":"/en-pe/jiv-jago-jiv-jago-gaurachanda-bole/","description":"Aruṇodoya-kīrtan — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Aruṇodoya-kīrtan. Part 2 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"jiv-jago-jiv-jago-gaurachanda-bole"}}