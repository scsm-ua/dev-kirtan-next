"title":["Sarvasva tomāra"],"author":["by Śrīla Bhakti Vinod Ṭhākur"],"verses":[{"number":"1","text":["sarvasva tomāra,    charaṇe sa̐piyā,","    paḍechhi tomāra ghare","tumi ta’ ṭhākura,    tomāra kukkura,","    baliyā jānaha more"],"translation":["I have offered everything at Your feet and taken shelter in Your home. You are my Master. Consider me Your dog."],"isLong":false},{"number":"2","text":["bā̐dhiyā nikaṭe,    āmāre pālibe,","    rahiba tomāra dvāre","pratīpa-janere,    āsite nā diba,","    rākhiba gaḍera pāre"],"translation":["You will tie me up nearby and maintain me. I will remain at Your doorstep. I will not allow any inimical persons to enter; I will keep them on the far side of Your moat."],"isLong":false},{"number":"3","text":["tava nija-jana,    prasāda seviyā,","    uchchhiṣṭa rākhibe yāhā","āmāra bhojana,    parama-ānande,","    prati-dina habe tāhā"],"translation":["Whatever remnants Your devotees leave behind after honouring Your prasād I will eat every day with great joy."],"isLong":false},{"number":"4","text":["basiyā śuiyā,    tomāra charaṇa,","    chintiba satata āmi","nāchite nāchite,    nikaṭe yāiba,","    yakhana ḍākibe tumi"],"translation":["While sitting up or lying down, I will always think of Your feet. I will come to You whenever You call me, dancing all the way."],"isLong":false},{"number":"5","text":["nijera poṣana,    kabhu nā bhāviba,","    rahiba bhāvera bhare","bhakati-vinoda,    tomāre pālaka,","    baliyā varaṇa kare"],"translation":["I will never think about my own maintenance; I will always remain within the shelter of loving attachment to You. Bhakti Vinod embraces You as his maintainer."],"isLong":false}],"resources":{"audio":[{"title":"Srila B.R. Sridhar Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-4","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Kamal Krishna Prabhu","embed_url":"https://soundcloud.com/jayasri-sound/19-sarvvasva-tomara","personSlug":"kamal-krishna-prabhu"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/sarvasva-tomara","personSlug":"manasa-krishna-prabhu"},{"title":"Sudarshan Prabhu","embed_url":"https://soundcloud.com/bharatimaharaj/sudarshan-prabhu-sarvasva","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Sarvasva-tomāra-02-22"},"head":{"canonical":"/en-pe/sarvasva-tomara-charane-sanpiya/","description":"Sarvasva tomāra — a Vaiṣṇava song by Śrīla Bhakti Vinod Ṭhākur with lyrics, English translation and word-by-word meaning. From Pocket Kirtan Guide.","title":"Sarvasva tomāra. by Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"en-pe","slug":"sarvasva-tomara-charane-sanpiya"}}