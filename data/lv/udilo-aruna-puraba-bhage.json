{"build":"6c7a310@16/11/2026, 18:43:24","data":{"book":{"title":"Gaudija Gītandžalī","subtitle":"Vaišnavu dziesmas un lūgšanas","slug":"lv","sort_order":5,"songsCount":91},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Gaudija Gītandžalī","subtitle":"Vaišnavu dziesmas un lūgšanas","slug":"lv","sort_order":5,"songsCount":91},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":71},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":7,"songsCount":80},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":8,"hidden":true,"songsCount":166},{"title":"Колесница Джаганнатха","subtitle":"Утренняя программа","slug":"ru-kdm","language":"ru","hidden":true,"render":{"tg.contents.page_number":false},"sort_order":9,"songsCount":23}],"nav":{"42/2":{"prev":{"path":"/lv/jashomati-nandana-vraja-vara-nagara/","title":"Śrī Nām-kīrtan"},"next":{"path":"/lv/jiv-jago-jiv-jago-gaurachanda-bole/","title":"Aruṇodoya-kīrtan 2"}}},"song":{"meta":{"page":"42/2","first_line":"udilo aruṇa pūraba-bhāge"},"title":["Aruṇodoya-kīrtan"],"author":["Šrīla Bhaktivinoda Thākurs"],"subtitle":["I daļa"],"verses":[{"number":"1","text":["udilo aruṇa pūraba-bhāge,","dvija-maṇi gorā amani jāge,","bhakata-samūha loiyā sāthe,","gelā nagara-brāje"],"translation":["Pirms pašas saules ausmas, kad debesis austrumos sāk sārtoties, Šrī Gauraharī, dārgakmens divreiz dzimušo vidū, mostas no miega. Kopā ar saviem bhaktām viņš uzsāk *kīrtanu*, apstaigājot pilsētas un ciemus."],"isLong":false},{"number":"2","text":["‘tāthai tāthai’ bājalo khol,","ghana ghana tāhe jhāṅjera rol,","preme ḍhala ḍhala sonāra aṅga,","charaṇe nūpura bāje"],"translation":["Mridangas spēlē “tāthai tāthai” karatalu ritmā, Kunga zeltītais ķermenis dreb ekstāzē un Viņa kāju zvaniņi skan."],"isLong":false},{"number":"3","text":["mukunda mādhava jādava hari,","bolore bolore vadana bhori’,","miche nida-baśe gelo re rāti,","divasa śorīra sāje"],"translation":["Mahāprabhu sauc guļošajiem ļaudīm: “Neizniekojiet naktis bezjēdzīgajam miegam un dienas savu ķermeņu rotāšanai! Sauciet skaļi vārdus Mukunda, Mādhava, Jādava un Harī!”"],"isLong":false},{"number":"4","text":["emona durllabha mānava-deho,","pāiyā ki koro bhāva nā keho,","ebe nā bhajile jaśodā-suta,","charame poḍibe lāje"],"translation":["“Jūs esat ieguvuši tik ļoti reto dzimšanu par cilvēku! Taču ko gan jūs darāt? Vai jūs nemaz nenovērtējat šo reto dāvanu? Ja jūs nepielūgsiet mātes Jašodas mīļoto dēlu, milzu nelaime sagaidīs jūs nāves brīdī!”"],"isLong":false},{"number":"5","text":["udita tapana hoile asta,","dina gelo-boli’ hoibe byasta,","tobe keno ebe alasa hoy,","nā bhaja hṛdoya-rāje"],"translation":["“Ar katru saules ausmu un rietu paiet diena – to vairs neatgriezt! Tad kādēļ jūs esat tik slinki un atsakāties kalpot savas sirds Kungam?”"],"isLong":false},{"number":"6","text":["jīvana anitya jānaha sār,","tāhe nānā-vidha vipada-bhār,","nāmāśroya kori’ jatane tumi,","thākaha āpana kāje"],"translation":["“Jūs zināt, ka dzīve ir pilna ciešanu! Pieņemiet patvērumu Svētajā Vārdā – lai tiekšanās pie Tā kļūst par jūsu vienīgo nodarbi!”"],"isLong":false},{"number":"7","text":["kṛṣṇa-nāma-sudhā koriyā pān","juḍāo bhakativinoda-prāṇ,","nāma binā kichu nāhiko āro,","chaudda-bhuvana-mājhe"],"translation":["“Iemalkojiet Krišnas Svētā Vārda tīro nektāru un priecējiet ar to Thākura Bhaktivinoda dvēseli! Visās četrpadsmit pasaulēs nav nekā, pie kā būtu jātiecas, kā vienīgi pie Svētā Vārda!”"],"isLong":false},{"number":"8","text":["jīvera kalyāṇa-sādhana-kām,","jagate āsi’ e madhura nām,","avidyā-timira-tapana-rūpe,","hṛd-gagane birāje"],"translation":["Lai kliedētu neziņas tumsu un svētītu dvēseles visā Visumā, brīnišķais Krišnas Vārds uzausa līdzīgi mirdzošai saulei!"],"isLong":false}],"resources":{"audio":[{"title":"Nabadwip temple","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-udilo-aruna-jiv","personSlug":"nabadwip-temple"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-1","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/udilo-aruna-jiv-jago","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Aruṇodoya-kīrtan-02-22-5"},"head":{"canonical":"/lv/udilo-aruna-puraba-bhage/","description":"Aruṇodoya-kīrtan — vaišnavu dziesma ar vārdiem, tulkojumu latviešu valodā un skaidrojumu vārdu pa vārdam. Autors — Šrīla Bhaktivinoda Thākurs. No grāmatas «Gaudija Gītandžalī».","title":"Aruṇodoya-kīrtan. I daļa | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"lv","slug":"udilo-aruna-puraba-bhage"}}