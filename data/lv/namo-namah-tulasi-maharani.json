rst_line":"namo namaḥ tulasī mahārāṇī"},"title":["Śrī Tulasī-parikramā-gīti"],"author":["Šrīla Čandrašekhars Kavī"],"verses":[{"text":["namo namaḥ tulasī mahārāṇī,","vṛnde mahārāṇī namo namaḥ"],"translation":["Tulasī Mahārānī, Vrinda Dēvī, es klanos tavā priekšā atkal un atkal!"],"isLong":false},{"text":["namo re namo re māiyā namo nārāyaṇi"],"translation":["Ak, Narājanī, es klanos tavā priekšā atkal un atkal!"],"isLong":false},{"text":["jāko daraśe, paraśe agha-nāśa-hoi","mahimā veda-purāṇe bākhāni"],"translation":["Pietiek uzlūkot tevi vai tev pieskarties, lai visi grēki zustu. Vēdas un Purānas tevi slavē!"],"isLong":false},{"text":["jāko patra, mañjarī komala","śrī-pati-charaṇa-kamale lapaṭāni","dhanya tulasi, pūraṇa tapa kiye,","śrī-śālagrama-mahā-pāṭarāṇī"],"translation":["Tavas lapas un mīkstie ziedi — mandžārī apvij Kunga Narājanas lotosam līdzīgās pēdas. Ak, Tulasī, pateicoties tavām askēzēm, tu esi kļuvusi par Šrī Šalagrāma-Šīlas godājamo sievu."],"isLong":false},{"text":["dhūpa, dīpa, naivedya, āroti,","phulanā kiye varakhā varakhāni","chāppānna bhoga, chatriśa byañjana,","binā tulasī prabhu eka nāhi māni"],"translation":["Tu lej žēlsirdību pāri visiem, kas piedāvā tev vīraku, uguni, ēdienu, ziedus, pielūgsmi. Kungs nepieņem nevienu no piecdesmit sešiem dažādiem mielastiem vai trīsdesmit sešiem piedāvātajiem karijiem, ja tie tiek piedāvāti bez tulasī lapām."],"isLong":false},{"text":["śiva-śuka-nārada, āur brahmādiko,","ḍhuḍata phirata mahā-muni jñānī","chandraśekhara māiyā, terā jaśa gāoye","bhakati-dāna dījiye mahārāṇi"],"translation":["Kungs Šiva, Šukadēvs Gosvāmī, Nārada Mūnī, visi debesu iemītnieki ar Kungu Brahmu priekšgalā, mistiķi un diženie mūnī cieņpilni apiet apkārt tev. Ak, Tulasī Mahārānī, tā tevi slavē Čandrašekhars! Dāvā viņam šo velti — sevis pilnīgu veltīšanu Dievam!"],"isLong":false}],"resources":{"audio":[{"title":"Srila B.S. Govinda Dev-Goswami Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/05-namo-namah-tulasi-maharani-13","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Srila B.B. Avadhut Maharaj","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-shri-tulasi","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Srila B.N. Acharya Maharaj","embed_url":"https://soundcloud.com/kostya-netrebenko/025-namonamahtulasimaharani-2","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Manasa Krishna Prabhu","embed_url":"https://soundcloud.com/huron/namo-namah-tulasi-maharani","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Śrī-Tulasī-parikramā-gīti-03-14"},"head":{"canonical":"/lv/namo-namah-tulasi-maharani/","description":"Śrī Tulasī-parikramā-gīti — vaišnavu dziesma ar vārdiem, tulkojumu latviešu valodā un skaidrojumu vārdu pa vārdam. Autors — Šrīla Čandrašekhars Kavī. No grāmatas «Gaudija Gītandžalī».","title":"Śrī Tulasī-parikramā-gīti. Šrīla Čandrašekhars Kavī | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"lv","slug":"namo-namah-tulasi-maharani"}}