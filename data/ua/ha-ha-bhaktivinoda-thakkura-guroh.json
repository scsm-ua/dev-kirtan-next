вімшятіс те сама̄","дīрга̄д-духкха-бгара̄д-ашєша-віраха̄д-","    духстхīкрита̄ бгӯріям","джīва̄на̄м баху-джанма-пунья-ніваха̄","    кришто махī-мандале","а̄вірбга̄ва-крипа̄м чака̄ра ча бгава̄н","    шрī-ґаура-шяктіх сваям"],"isLong":false},{"number":"2","text":["дīно ’хам чіра-душкритір на хі бгават-","    па̄да̄бджа-дгӯлі-кана̄-","сна̄на̄нанда-нідгім прапанна-шюбгадам","    лабдгум самартхо ’бгавам","кінтв ауда̄рʼя-ґуна̄т-тава̄ті-яшясах","    ка̄рунья-шяктіх сваям","шрī-шрī-ґаура-маха̄прабгох пракатіта̄","    вішвам саманваґрахīт"],"isLong":false},{"number":"3","text":["хе дева! ставане тава̄кхіла-ґуна̄на̄м","    те віріньча̄дайо","дева̄ вʼяртха-мано-ратха̄х кім у ваям","    мартьядгама̄х курмахе","етан но вібудгайх када̄пй атішяяланка̄ра","    ітй учʼята̄м","шястрешв ева “на па̄рає ’хам” іті яд","    ґа̄там мукундена тат"],"isLong":false},{"number":"4","text":["дгармаш-чарма-ґато ’ґʼятайва сатата̄","    йоґаш ча бгоґа̄тмако","ґʼяне шюнья-ґатір джапена тапаса̄","    кхʼятір джіга̄мсайва ча","да̄не да̄мбгіката̄ ’нура̄ґа-бгаджане","    душта̄пача̄ро яда̄","буддгім буддгі-мата̄м вібгеда хі тада̄","    дга̄тра̄ бгава̄н прешитах"],"isLong":false},{"number":"5","text":["вішве ’смін кіранайр ятха̄ хіма-карах","    саньджīваянн ошадгīр","накшатра̄ні ча раньджаян ніджа-судга̄м","    віста̄раян ра̄джате","сач-ча̄стра̄ні ча тошаян будга-ґанам","    саммодаямс те татха̄","нӯнам бгӯмі-тале шюбгодая іті","    хла̄до бахух са̄твата̄м"],"isLong":false},{"number":"6","text":["лока̄на̄м хіта-ка̄мʼяя бгаґавато","    бгакті-прача̄рас твая","ґрантха̄на̄м рачанайх сата̄м абгіматайр","    на̄на̄-відгайр даршітах","а̄ча̄рʼяйх крита-пӯрвам ева кіла тад","    ра̄ма̄нуджа̄дьяйр будгайх","према̄мбго-нідгі-віґрахасья бгавато","    ма̄ха̄тмʼя-сīма̄ на тат"],"isLong":false},{"number":"7","text":["яд дга̄мнах кхалу дга̄ма чайва ніґаме","    брахметі самґʼяяте","ясьямшясья калайва духкха-нікарайр","    йоґешварайр мриґʼяте","вайкунтхе пара-мукта-бгринґа-чарано","    на̄ра̄яно ях сваям","тасьямші бгаґава̄н сваям раса-вапух","    кришно бгава̄н тат прадах"],"isLong":false},{"number":"8","text":["сарва̄чінтьямає пара̄тпара-пуре","    ґолока-вринда̄ване","чіл-лīла̄-раса-ранґінī паріврита̄","    са̄ ра̄дгіка̄ шрī-харех","ва̄тсальяді-расайш ча севіта-танор-","    ма̄дгурʼя-сева̄-сукхам","нітьям ятра муда̄ таноті хі бгава̄н","    тад дга̄ма-сева̄-прадах"],"isLong":false},{"number":"9","text":["шрī-ґаура̄нуматам сварӯпа-відітам","    рӯпа̄ґраджена̄дритам","рӯпа̄дьяйх парівешітам рагу-ґанайр","    а̄сва̄дітам севітам","джīва̄дьяйр абгіракшитам шюка-шіва-","    брахма̄ді-самма̄нітам","шрī-ра̄дга̄-пада-севана̄мритам ахо","    тад да̄тум īшо бгава̄н"],"isLong":false},{"number":"10","text":["ква̄хам манда-матіс тв атīва-патітах","    ква твам джаґат-па̄ванах","бго сва̄мін крипаяпара̄дга-нічайо","    нӯнам твая кшамʼята̄м","яче ’хам каруна̄-нідге! варам імам","    па̄да̄бджа-мӯле бгават-","сарвасва̄вадгі-ра̄дгіка̄-даїта-да̄са̄на̄м","    ґане ґаньята̄м"],"isLong":false}],"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrīmad-Bgaktі-Vіnod-vіraha-Dashyakam-01-02"},"head":{"canonical":"/ua/ha-ha-bhaktivinoda-thakkura-guroh/","description":"Шрīмад Бгакті Вінод-віраха Дашякам — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгакті Ракшак Шрīдгар Дев-Ґосва̄мī Маха̄ра̄дж. Зі збірки «Ґаудія Ґітанджалі».","title":"Шрīмад Бгакті Вінод-віраха Дашякам. Prayer in Separation of Śrīla Bhakti Vinod Ṭhākur | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"ha-ha-bhaktivinoda-thakkura-guroh"}}