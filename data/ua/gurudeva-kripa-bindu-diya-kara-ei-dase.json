mber":false},"sort_order":9,"songsCount":23}],"nav":{"68":{"prev":{"path":"/ua/jaya-shiachinandana-sura-muni-vandana/","title":"Шрī Шячīнандана-вандана̄"},"next":{"path":"/ua/udilo-aruna-puraba-bhage/","title":"Арунодоя-кīртан 1"}}},"song":{"meta":{"page":68,"first_line":"ґурудева! крипа̄-бінду дія, кара’ еі да̄се","translator":"Krishna Chaitanya Das","version":"draft1"},"title":["Ґурудева"],"author":["Шрīла Бгактівінод Тха̄кур"],"verses":[{"number":"1","text":["ґурудева!","крипа̄-бінду дія,    кара’ еі да̄се,","    трина̄пекша̄ аті дīна","сакала-сахане,    бала дія кара,","    ніджа-ма̄не сприха̄-хīна"],"translation":["Ґурудеве, цей слуга благає в тебе хоча б одну краплю милості. Я менш значущий, ніж травинка. Допоможи мені всебічно, даруй мені наснагу. Нехай я буду, так само як ти, вільним від власних бажань та прагнень."],"isLong":false},{"number":"2","text":["сакале самма̄н,    коріте шякаті,","    дехо на̄тха! ятха̄ ятха","тобе то’ ґа̄ібо,    харіна̄ма-сукхе,","    апара̄дга хобе хото"],"translation":["Навчи мене щиро поважати і шанувати будь-кого. Лише тоді я радо зможу оспівувати Святе Імʼя та звільнюся від усіх зневаг."],"isLong":false},{"number":"3","text":["кобе хено крипа̄,    лобгія е джана,","    крита̄ртха хоібе, на̄тха!","шякті-буддгі-хīн,    а̄мі аті дīн,","    кара море а̄тма-са̄тха"],"translation":["Володарю мій! Коли вже мені, слабкому, убогому та нетямущому, випаде така милість? Прошу, дозволь мені бути з тобою."],"isLong":false},{"number":"4","text":["джоґʼята̄-віча̄ре,    кічху на̄хі па̄і,","    тома̄ра каруна̄-са̄ра","каруна̄ на̄ хоіле,    ка̄ндія ка̄ндія,","    пра̄на на̄ ра̄кхібо а̄ра"],"translation":["Поглянувши на мене, ти не знайдеш жодної чесноти. Я повністю залежу від твоєї ласки. Без твоєї прихильності я буду змушений гірко стогнати та втрачу всі життєві сили."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Р. Шрідгар Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-6","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Шріла Б.С. Ґовінда Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-gurudev-kripa","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Навадвіпський храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-gurudev-morning","personSlug":"nabadwip-temple"},{"title":"Навадвіпський храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-gurudev","personSlug":"nabadwip-temple"},{"title":"Шріла Б.Б. Авадгут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-2","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Камал Крішна Прабгу","embed_url":"https://soundcloud.com/jayasri-sound/43-gurudeva-krpa-bindu-diya","personSlug":"kamal-krishna-prabhu"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/gurudev-kripa-bindu-diya","personSlug":"manasa-krishna-prabhu"},{"title":"Храм м.Каракас","embed_url":"https://soundcloud.com/bharatimaharaj/shchsm-karakas-gurudev","personSlug":"caracas-temple"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Gurudeva-02-22-3"},"head":{"canonical":"/ua/gurudeva-kripa-bindu-diya-kara-ei-dase/","description":"Ґурудева — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Ґурудева. Шрīла Бгактівінод Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"gurudeva-kripa-bindu-diya-kara-ei-dase"}}