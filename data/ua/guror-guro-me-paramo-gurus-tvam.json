","варенья! ґаура̄нґа-ґана̄ґраґаньє","прасīда бгритьє даїта̄шріте те","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"2","text":["сарасватī-на̄ма-джаґат-прасіддгам","прабгум джаґатьям патітайка-бандгум","твам ева дева! пракатī-чака̄ра","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"3","text":["квачід-враджа̄ранья-вівікта-ва̄сī","хриді враджа-двандва-рахо-віла̄сī","бахір віра̄ґī тв авадгӯта-веши","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"4","text":["квачіт пунар ґаура-вана̄нтача̄рī","сура̄паґа̄-тīра-раджо-віха̄рī","павітра-каупīна-каранка-дга̄рī","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"5","text":["сада̄ харер на̄ма муда̄ ратантам","ґрихе ґрихе ма̄дгукарīм атантам","наманті дева̄ апі ям маха̄нтам","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"6","text":["квачід-рудантань ча хасан натантам","ніджешта-дева-пранаябгібгӯтам","наманті ґа̄янтам алам джана̄ тва̄м","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"7","text":["маха̄яшо-бгактівінода-бандго!","маха̄прабгу-према-судгайка-сіндго!","ахо джаґанна̄тха-даяспадендо!","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"8","text":["сама̄пʼя ра̄дга̄-вратам уттамам твам","ава̄пʼя да̄модара-джа̄ґара̄хам","ґато ’сі ра̄дга̄дара-сакхʼя-ріддгім","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"9","text":["віха̄я санґам кулія-лаяна̄м","праґрихʼя сева̄м даїта̄нуґасья","вібга̄сі ма̄япура-мандіра-стхо","намо намо ґаура-кішора тубгʼям"],"isLong":false},{"number":"10","text":["сада̄ німаґно ’пй апара̄дга-панке","хй ахайтукīм еша крипа̄нь ча яче","даям самуддгритья відгехі дīнам","намо намо ґаура-кішора тубгʼям"],"isLong":false}],"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrī-SHrīmad-Gaura-Kіshora--namaskara-Dashyakam-01-02"},"head":{"canonical":"/ua/guror-guro-me-paramo-gurus-tvam/","description":"Шрī Шрīмад Ґаура-Кішора- намаска̄ра Дашякам — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгакті Ракшак Шрīдгар Дев-Ґосва̄мī Маха̄ра̄дж. Зі збірки «Ґаудія Ґітанджалі».","title":"Шрī Шрīмад Ґаура-Кішора- намаска̄ра Дашякам. Homage unto Śrīmad Gaura Kiśora Bābājī Mahārāj | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"guror-guro-me-paramo-gurus-tvam"}}