umber":false},"is_legacy":true,"sort_order":9,"songsCount":23}],"nav":{"38":{"prev":{"path":"/ua/jaya-guru-maharaja-jati-rajeshvara/","title":"Шрī Ґуру А̄раті-стуті"},"next":{"path":"/ua/jashomati-nandana-vraja-vara-nagara/","title":"Шрī На̄м-кīртан"}}},"song":{"meta":{"page":38,"first_line":"калі-куккура-кадана джаді ча̄о хе","translator":"Krishna Chaitanya Das","version":"draft1"},"title":["Прабга̄ті Ґīті"],"author":["Шрīла Бгактівінод Тха̄кур"],"verses":[{"number":"1","text":["    калі-куккура-кадана джаді ча̄о хе","каліюґа-па̄вана    калі-бгая-на̄шяна,","    шрī шячī-нандана ґа̄о хе"],"translation":["Якщо ти хочеш приборкати собаку Калі - оспівуй Імена Шрі Шячі Нандана! Він спаситель кожного. Він руйнує страх, яким пронизана ця темна доба."],"isLong":false},{"number":"2","text":["ґада̄дгара-ма̄дана    ніта̄і-ера пра̄надгана,","    адвайтера прапӯджіта ґора̄","німай вішвамбгара    шрīніва̄са-īшвара,","    бгаката самӯха-чітачора̄"],"translation":["Він — радість Ґададгара, а також багатство та життя Нітая. Йому шанобливо поклоняється Адвайта Ачарʼя. Він відомий як Німай - Той, хто народився під деревом *нім*, а також як Вішвамбгар, бо завдяки Йому тримається всесвіт. Він — повелитель Шріваса Тхакура. Він краде серця відданих."],"isLong":false},{"number":"3","text":["надīя-шяшядгара    ма̄япура-īшвара,","    на̄ма-прабартана-шюра","ґрихīджана-шікшака    ньясікула-на̄яка,","    ма̄дгава-ра̄дга̄бга̄ва пӯра"],"translation":["Шріман Махапрабгу - світоч земель Надії та Господь Маяпуру. Він започаткував релігію Харінама-*санкіртани*. Він - наставник для сімейних людей та лідер серед *санньясі*. Його сутність - Господь Мадгава із серцем Шрі Радги."],"isLong":false},{"number":"4","text":["са̄рвабгаума-шодгана    ґаджапаті-та̄рана,","    ра̄ма̄нанда-пошана-вīра","рӯпа̄нанда-вардгана    сана̄тана па̄лана,","    харіда̄са-модана-дгīра"],"translation":["Він очистив Сарвабгауму Бгаттачарʼю та визволив Махараджа Пратапарудру. Він вберігає Рамананду Рая і є героєм для всіх відданих. Він захищає Санатану Ґосвамі та надихає Рупу Ґосвамі. Ним зачарований розсудливий Тхакур Харідас."],"isLong":false},{"number":"5","text":["враджа раса-бга̄вана    душтамата-шятана,","    капатī-віга̄тана-ка̄ма","шюддга бгакта-па̄лана    шюшка ґʼяна-та̄дана,","    чоло бгакті-дӯшана-ра̄ма"],"translation":["Шрі Крішна Чайтанья поглинутий *расами* Враджі. Він відкидає безживне розумування, яке затьмарює красу чистої відданості. Він опора та прихисток Своїх відданих."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Б. Авадгут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-utrennee-6","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Шріла Б.К. Ашрам Махарадж","embed_url":"https://soundcloud.com/scsmathcolombia/5-prabhati-giti","personSlug":"srila-b-k-ashram-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/kali-kukkura-kadana","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Prabgatі-Gītі-02-22"},"head":{"canonical":"/ua/kali-kukkura-kadana-jadi-chao-he/","description":"Прабга̄ті Ґīті — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Прабга̄ті Ґīті. Шрīла Бгактівінод Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"kali-kukkura-kadana-jadi-chao-he"}}