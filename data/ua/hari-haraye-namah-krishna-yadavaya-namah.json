mber":false},"sort_order":9,"songsCount":23}],"nav":{"55":{"prev":{"path":"/ua/thakura-vaishnava-gana-kori-ei-nivedana/","title":"Тха̄кура-вайшнава-ґана"},"next":{"path":"/ua/bhaja-bhakata-vatsala-shri-gaurahari/","title":"Шрī Бгоґ А̄раті Ґīті"}}},"song":{"meta":{"page":55,"first_line":"харі харає намах кришна ядава̄я намах","translator":"nazar","version":"draft1"},"title":["На̄м-санкīртан"],"author":["Шрīла Нароттам Да̄с Тха̄кур"],"verses":[{"number":"1","text":["харі харає намах кришна ядава̄я намах","ядава̄я ма̄дгава̄я кешява̄я намах"],"translation":["Господь Харі, Господь Крішна, прийми мої поклони! Відомий як Ядава, Мадгава, Кешава - Тобі мої поклони!"],"isLong":false},{"number":"2","text":["ґопа̄ла ґовінда ра̄ма шрī мадгусӯдана","ґірідга̄рī ґопīна̄тха мадана-мохана"],"translation":["О! Ґопал, Ґовінда, Рама, Шрі Мадгусудана Ґірідгарі, Ґопінатх, Мадана-Мохан!"],"isLong":false},{"number":"3","text":["шрī-чайтанья нітьянанда шрī адвайта-чандра","ґада̄дгара шрīва̄са̄ді ґаура-бгакта-вринда"],"translation":["Вся слава Шрі Чайтаньї, Слава Нітьянанді, Слава Шрі Адвайта Ачарʼї! Слава Ґададгару Пандіту, Шрівасу Тхакуру, Слава всім відданим Шрі Чайтаньї!"],"isLong":false},{"number":"4","text":["джая рӯпа сана̄тана бгатта рагуна̄тха","шрī-джīва-ґопа̄ла-бгатта да̄са рагуна̄тха"],"translation":["Вся слава Шрі Рупі Ґосвамі, Санатані Ґосвамі, Рагунатху Бгатта Ґосвамі! Слава Шрі Дживі Ґосвамі, Ґопалу Бгатта Ґосвамі, Рагунатху Дасу Ґосвамі!"],"isLong":false},{"number":"5","text":["еі чхой ґоса̄ір корі чарана вандана","джа̄ха̄ хоіте бігна-на̄ш абгīшта пӯрана"],"translation":["Стопам цих шести ґосвамі, я пропоную свої поклони. Це усуває всі перешкоди до відданості та сповнює всі духовні чаяння."],"isLong":false},{"number":"6","text":["еі чхой ґоса̄ір джа̄нра муі та̄нра да̄са","та̄н-саба̄ра пада-рену мора паньча-ґра̄са"],"translation":["Я слуга слуги цих шести ґосвамі. Пил з їх стоп - пʼять видів моєї їжі."],"isLong":false},{"number":"7","text":["та̄ндера чарана себі бгакта сане ва̄са","джанаме джанаме мора еі абгіла̄ша"],"translation":["Я бажаю життя за життям жити біля тих відданих, що служать стопам цих шести ґосвамі."],"isLong":false},{"number":"8","text":["еі чхой ґоса̄і джабе врадже коіла̄ ва̄са","ра̄дга̄-кришна-нітья-лīла̄ коріла̄ прака̄шя"],"translation":["Коли ці шість ґосвамі жили у Враджі, вони проявили та пояснили вічні ігри Радги та Крішни."],"isLong":false},{"number":"9","text":["а̄нанде боло харі бгаджа вринда̄вана","шрī-ґуру-вайшнава-паде маджа̄ія мана"],"translation":["Націливши ум на лотосові стопи Духовного Вчителя та святих Вайшнавів, з радістю співай імена Господа Харі та поклоняйся неосяжній дійсності Вриндавана."],"isLong":false},{"number":"10","text":["шрī-ґуру-вайшнава-па̄да-падма корі а̄шя","(харі) на̄ма-санкīртана кохе нароттама да̄са"],"translation":["Уповаючи на лотосові стопи Шрі Ґуру та Вайшнавів, Нароттам Дас співає *санкіртану* Святого Імені."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.С. Ґовінда Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-hari-haraye","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Навадвіпський храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-hari-haraye","personSlug":"nabadwip-temple"},{"title":"Шріла Б.Б. Авадгут Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/avadxut-maxaradzh-xari-xaraje","personSlug":"srila-b-b-avadhut-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/hari-haraye-namah-krishna","personSlug":"manasa-krishna-prabhu"},{"title":"Бгакті Лаліта Деві","embed_url":"https://soundcloud.com/bhakti-lalita-devi/bhakti-lalita-devi-nama-sankirttan-hari-haraye-namah-krishna","personSlug":"bhakti-lalita-devi"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Nam-sankīrtan-02-22"},"head":{"canonical":"/ua/hari-haraye-namah-krishna-yadavaya-namah/","description":"На̄м-санкīртан — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Нароттам Да̄с Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"На̄м-санкīртан. Шрīла Нароттам Да̄с Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"hari-haraye-namah-krishna-yadavaya-namah"}}