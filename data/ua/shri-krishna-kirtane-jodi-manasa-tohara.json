р"],"subtitle":["Song 3"],"verses":[{"text":["трина̄д апі сунīчена","тарор іва сахішнуна̄","ама̄ніна̄ ма̄надена","кīртанīях сада̄ харіх"],"isLong":false},{"number":"1","text":["шрī-кришна-кīртане джоді ма̄наса тоха̄ра","парама джатане та̄нгі лобго адгіка̄ра"],"isLong":false},{"number":"2","text":["трина̄дгіка хīна, дīна, акіньчана чха̄ра","а̄пане ма̄нобі сада̄ чха̄ді’ аханка̄ра"],"isLong":false},{"number":"3","text":["врикша-сама кшама̄-ґуна карабі са̄дгана","пратіхімса̄ тьяджі аньє карабі па̄лана"],"isLong":false},{"number":"4","text":["джīвана-нірва̄хе а̄не удвеґа на̄ дібе","пара-упака̄ре ніджа-сукха па̄сарібе"],"isLong":false},{"number":"5","text":["хоіле-о сарва-ґуне ґунī маха̄шоя","пратіштха̄шя чха̄ді кара ама̄нī хридоя"],"isLong":false},{"number":"6","text":["кришна-адгіштха̄н сарва-джīве джа̄ні сада̄","карабі самма̄на собе а̄даре сарвада̄"],"isLong":false},{"number":"7","text":["доінья, дая, аньє ма̄н, пратіштха̄-варджан","ча̄рі ґуне ґунī хоі карахо кīртан"],"isLong":false},{"number":"8","text":["бгакатівінода ка̄нді боле прабгу-па̄я","хено адгіка̄ра кобе дібе хе а̄ма̄я"],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Н. Ачарʼя Махарадж","embed_url":"https://soundcloud.com/kostya-netrebenko/102-srisrisiksastakam3-7","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/sri-krishna-kirttane-jodi","personSlug":"manasa-krishna-prabhu"},{"title":"Бгакті Лаліта Деві","embed_url":"https://soundcloud.com/bhakti-lalita-devi/sri-krishna-kirtane-jodi-manasa-tohara","personSlug":"bhakti-lalita-devi"},{"title":"Сударшан Прабгу","embed_url":"https://soundcloud.com/jayasri-sound/song-3-sri-krishna-kirttane","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrī-SHіkshashtakam-01-03-2"},"head":{"canonical":"/ua/shri-krishna-kirtane-jodi-manasa-tohara/","description":"Шрī Шік