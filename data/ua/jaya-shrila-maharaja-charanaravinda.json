},{"number":"6","text":["су-сіддга̄нта-дга̄ра̄дгара сатья суґамбгīра","шрī-ґуру-вайшнава-сева̄-ніштха маха̄дгīра"],"isLong":false},{"number":"7","text":["са̄дгу-прія саралата̄ тома̄ра бгӯшана","ама̄нī ма̄нада сада̄ міштха-самбга̄шана"],"isLong":false},{"number":"8","text":["ґуру-маха̄ра̄джа джатіра̄джа-ра̄джешвара","шрī-бгакті-ракшака дева-ґосва̄мī шрīдгара"],"isLong":false},{"number":"9","text":["парама сонтушта тава вішрамбга-сева̄я","ніджа-ха̄те вʼяса̄сане васа̄’ла тома̄я"],"isLong":false},{"number":"10","text":["сукхе манонīта коіла̄ уттара̄дгіка̄рī","ехена апӯрва снеха котха̄о на̄ хері"],"isLong":false},{"number":"11","text":["рӯпа-сарасватī-шрīдгар-дга̄ра̄-сротасвінī","тава хриде вахе сада̄ бгувана па̄ванī"],"isLong":false},{"number":"12","text":["шіва-ґуру-санкаршана каруна̄-нілая","нітьянанда-рӯпе тава хриде віласая"],"isLong":false},{"number":"13","text":["суджана судгīра-ґана тава ґуна-ґа̄я","дурбга̄ґа̄ ваньчіта апара̄дге море ха̄я"],"isLong":false},{"number":"14","text":["ґуру-ґаура-кришна-сева̄-саубга̄ґʼя-прака̄шє","са̄нанде адгама бга̄се санкīртана ра̄се"],"isLong":false}],"resources":{"audio":[{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/jaya-srila-maharaja","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Acharʼya-charana-vandana-01-02"},"head":{"canonical":"/ua/jaya-shrila-maharaja-charanaravinda/","description":"А̄ча̄рʼя-чарана-вандана — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīпа̄д Бгакті А̄нанда Са̄ґар Маха̄ра̄дж. Зі збірки «Ґаудія Ґітанджалі».","title":"А̄ча̄рʼя-чарана-вандана. Шрīпа̄д Бгакті А̄нанда Са̄ґар Маха̄ра̄дж | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"jaya-shrila-maharaja-charanaravinda"}}