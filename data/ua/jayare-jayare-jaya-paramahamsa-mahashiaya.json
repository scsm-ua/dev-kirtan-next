{"build":"643119f@21/11/2026, 18:18:32","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166}],"nav":{"221":{"prev":{"path":"/ua/bhayabhanjana-jayashiamsana/","title":"Шрī Даїта Да̄с Пранаті Паньчакам"},"next":{"path":"/ua/pralaya-payodhi-jale-dhritavan-asi-vedam/","title":"Шрī Дашявата̄р-стотрам"}}},"song":{"meta":{"page":221,"translation":"no","first_line":"джаяре джаяре джая парамахамса маха̄шяя"},"title":["А̄ча̄рʼя вандана"],"author":["Ґопа̄л Ґовінда Маханта"],"verses":[{"number":"1","text":["джаяре джаяре джая    парамахамса маха̄шяя","    шрī бгактісіддга̄нта сарасватī","ґосва̄мī тха̄кура джая    парама каруна̄моя","    дīнахīна аґатіра ґаті"],"isLong":false},{"number":"2","text":["    ніла̄чоле хоія удая","шрī ґаудамандале а̄сі’    према бгакті парака̄ші’","    джівера на̄шіла̄ бгава-бгая"],"isLong":false},{"number":"3","text":["тома̄ра махіма̄ ґа̄і    хено са̄дгʼя мора на̄і","    тобе па̄рі джоді дехо шякті","вішвахіте авірата    а̄ча̄ра-прача̄ре рата","    вішюддга шрī рӯпа̄нуґа бгакті"],"isLong":false},{"number":"4","text":["шрīпа̄т кхетарі дга̄ма    тха̄кура шрī нароттама","    тома̄те та̄нга̄ра ґуна декхі","шястрера сіддга̄нта-са̄ра    шюні ла̄ґе чаматка̄ра","    кута̄ркіка діте на̄ре пха̄нкі"],"isLong":false},{"number":"5","text":["шюддга бгакті-мата джата    упадгарма-каваліта","    херія локера моне тра̄са","ха̄ні’ сусіддга̄нта-ва̄на    упадгарма кха̄на кха̄на","    саджджанера ва̄да̄ле улла̄са"],"isLong":false},{"number":"6","text":["сма̄ртамата джаладгара    шюддга бгакті робі-кара","    а̄ча̄діла бга̄вія антаре","шястра сіндгу мантханете    сусіддга̄нта джганьджга̄ва̄те","    уда̄іла̄ діґ діґантаре"],"isLong":true},{"number":"7","text":["стха̄не стха̄не кото мотх    стха̄піяча нішкапот","    према сева̄ шікха̄іте джīве","мотхера вайшнава ґон    коре сада̄ вітарон","    харі ґуна-катха̄мрита бгаве"],"isLong":false},{"number":"8","text":["шюддга-бгакті-манда̄кінī    вімала права̄ха а̄ні","    шітала коріла̄ таптапра̄на","дешє дешє нішкіньчан    преріла̄ вайшнава ґон","    віста̄ріте харіґуна ґа̄на"],"isLong":false},{"number":"9","text":["пӯрве ятха̄ ґаурахарі    ма̄ява̄да чеда корі","    вайшнава коріла̄ ка̄шіва̄сī","вайшнава даршяна-сукшма    віча̄ре тумі хе дакша","    тематі тошила̄ ва̄ра̄насī"],"isLong":false},{"number":"10","text":["дайва-варна̄шрама-дгарма    харі бгакті джа̄ра марма","    шястра джукте коріла̄-нішчой","ґʼяна-джоґа-карма чхой    мӯлья та̄ра кічху ной","    бгактіра віродгī джоді хой"],"isLong":false},{"number":"11","text":["шрī ґаудамандала бгӯмі    бгакта санґе парікрамі","    сукīрті стха̄піла̄ маха̄шой","абгінна враджа мандала    ґаудабгӯмі премоджвала","    прача̄ра хоіло вішвамой"],"isLong":false},{"number":"12","text":["куліяте па̄шандīра̄    атьяча̄ра коіло джа̄’ра̄","    та̄ саба̄ра доша кшома̄ корі","джаґате коіле гошана̄    ‘тароріва сахішнуна̄’","    хон ‘кīртанīях сада̄ харіх’"],"isLong":false},{"number":"13","text":["шрī вішва-вайшнава-ра̄джа    сабга̄-мадгʼє ‘па̄трара̄джа’","    упа̄дгі-бгӯшане вібгӯшита","вішвера манґала ла̄ґі’    хоіячо сарва’ тьяґī","    вішвава̄сī джон-хіте рата"],"isLong":true},{"number":"14","text":["корітечо упака̄ра    джа̄те пара упака̄ра","    лобге джīва шрī кришна-сева̄я","дӯре джа̄я бгава-роґа    кханде джа̄хе карма бгоґа","    харі па̄да падма джа̄’те па̄я"],"isLong":false},{"number":"15","text":["джīва моха-нідра̄ ґата    джа̄ґа̄’те вайкунтха дӯта","    ‘ґаудīя’ па̄тха̄о горе горе","утхоре утхоре бга̄і    а̄ро то самоя на̄і","    ‘кришна бгаджа’ боле учайхсваре"],"isLong":false},{"number":"16","text":["тома̄ра мукха̄равінда-    віґаліта макаранда","    сіньчіта ачʼюта-ґуна-ґа̄тха̄","шюніле джуда̄я пра̄на    тамо моха антардга̄на","    дӯре джа̄я хридоєра вʼятха̄"],"isLong":false},{"number":"17","text":["джа̄ні а̄мі маха̄шой    джашова̄ньча̄ на̄хі хой","    бінду ма̄тра тома̄ра антаре","тава ґуна вīна̄дга̄рī,    мора кантха-вīна̄ дгорі’","    авашєте бола̄я а̄ма̄ре"],"isLong":false},{"number":"18","text":["вайшнавера ґуна-ґа̄на    коріле джīвера тра̄на","    шюніячі са̄дгу ґуру мукхе","кришна бгакті-самудой    джанама сапхала хой","    е бгава-са̄ґара торе сукхе"],"isLong":false},{"number":"19","text":["те-ка̄ране праяса    ятха̄ ва̄манера а̄шя","    ґаґанера ча̄нда дгорі ба̄ре","адоша-дараші тумі    адгама патіта а̄мі","    ніджа ґуне кшоміва̄ а̄ма̄ре"],"isLong":false},{"number":"20","text":["шрī ґаура̄нґа-па̄рішада    тха̄кура бгактівінода","    дīнахīна патітера бандгу","калі-тамах віна̄шіте    а̄нілена аванīте","    тома’ акаланка пӯрна інду"],"isLong":false},{"number":"21","text":["кара крипа̄ вітарана    премасудга̄ анукшана","    ма̄тія утхука джīва ґон","харіна̄ма-санкīртане    на̄чука джаґата-джане","    вайшнава-да̄сера ніведан"],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Р. Шрідгар Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/sridhar-maharaj-and-govinda-8","personSlug":"srila-b-r-sridhar-dev-goswami-maharaj"},{"title":"Шріла Б.С. Ґовінда Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-acharya","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/jayare-jayare-jaya-paramahamsa","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Acharʼya-vandana-01-02"},"head":{"canonical":"/ua/jayare-jayare-jaya-paramahamsa-mahashiaya/","description":"А̄ча̄рʼя вандана — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Ґопа̄л Ґовінда Маханта. Зі збірки «Ґаудія Ґітанджалі».","title":"А̄ча̄рʼя вандана. Ґопа̄л Ґовінда Маханта | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"jayare-jayare-jaya-paramahamsa-mahashiaya"}}