{"build":"d2d3291@22/11/2026, 17:23:59","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"240":{"prev":{"path":"/ua/shri-hari-vasare-hari-kirtana-vidhana/","title":"Шрī Харі-ва̄сара-ґīті"},"next":{"path":"/ua/chaudda-shiata-sata-shiake-masa-je-phalgun/","title":"Шрī Ґаура Пурнīма̄"}}},"song":{"meta":{"page":240,"translation":"auto","first_line":"шюддга-бгаката-чарана-рену","version":"draft-v8","translator":"Alokananda Devi Dasi"},"title":["Шюддга-бгаката"],"author":["Шрīла Бгактівінод Тха̄кур"],"verses":[{"number":"1","text":["шюддга-бгаката-    чарана-рену,","    бгаджана-анукӯла","бгаката-сева̄,    парама-сіддгі,","    према-латіка̄ра мӯла"],"translation":["Пил зі стоп-лотосів чистих відданих веде до *бгакті*, а служіння *вайшнавам* саме по собі є найвищою досконалістю і коренем ніжної ліани божественної любові."],"isLong":false},{"number":"2","text":["ма̄дгава-тітхі,    бгакті-джананī,","    джатане па̄лана корі","кришна-басаті,    басаті болі’,","    парама а̄даре борі"],"translation":["Я з великою увагою дотримуюся святих днів, таких як Екадаші та Джанмаштамі, бо вони є матір’ю відданості. Місцем свого життя я з найглибшою шаною і любов’ю обираю надмирну обитель Шрі Крішни."],"isLong":false},{"number":"3","text":["ґаура а̄ма̄ра,    дже-саба стха̄не,","    корало бграмана ранґе","се-саба стха̄на,    херібо а̄мі,","    пранаї-бгаката-санґе"],"translation":["Разом з чистими відданими я відвідую усі місця, якими подорожував і де чинив Свої забави мій Господь Ґаурасундар."],"isLong":false},{"number":"4","text":["мриданґа-ба̄дья,    шюніте мон,","    абасара сада̄ джа̄че","ґаура-біхіта,    кīртана шюні’,","    а̄нанде хридоя на̄че"],"translation":["Мій ум невпинно благає про можливість слухати звуки *мриданґи*. Коли я чую *кіртан*, таким, яким його заповідав Господь Ґаурачандра, моє серце пускається у радісний танок."],"isLong":false},{"number":"5","text":["джуґала-мӯрті,    декхія мора,","    парама-а̄нанда хой","праса̄да-сева̄    коріте хоя,","    сакала прапаньча джай"],"translation":["Коли я споглядаю незбагненні форми Божественної Пари, Шрі Шрі Радги-Крішни, я відчуваю найвище блаженство. Приймаючи *прасадам* Господа, я долаю всі омани матеріального світу."],"isLong":false},{"number":"6","text":["дже-діна ґрихе,    бгаджана декхі,","    ґрихете ґолока бга̄я","чарана-сīдгу,    декхія ґанґа̄,","    сукха на̄ сīма̄ па̄я"],"translation":["Кожного разу, коли в моїй оселі відбувається поклоніння і служіння Господу Харі, для мене там постає Ґолока Вриндавана. Коли ж я споглядаю Ґанґу, ріку нектару, що витікає зі стоп-лотосів Господа, я відчуваю безмежну радість."],"isLong":false},{"number":"7","text":["туласī декхі’,    джуда̄я пра̄на,","    ма̄дгава-тошанī джа̄ні’","ґаура-прія,    шяка-севане,","    джīвана са̄ртхака ма̄ні"],"translation":["Погляд на священне деревце Туласі заспокоює мою душу, бо я знаю, що Туласі тішить Самого Господа Крішну. Коли я шаную *шак* — страву з зеленого листя, що так до вподоби Господу Чайтаньї, я відчуваю, що моє життя наповнюється змістом."],"isLong":false},{"number":"8","text":["бгакатівінода,    кришна-бгаджане,","    анукӯла па̄я джа̄ха̄","праті-дівасе,    парама-сукхе,","    свīка̄ра карає та̄ха̄"],"translation":["Усе, що приходить до Бгактівінода задля служіння Шрі Крішні, він щодня приймає як найбільшу радість."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Н. Ачарʼя Махарадж","embed_url":"https://soundcloud.com/kostya-netrebenko/083-suddhabhakatacharanarenu-11","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Камал Крішна Прабгу","embed_url":"https://soundcloud.com/jayasri-sound/31-suddha-bhakata","personSlug":"kamal-krishna-prabhu"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/suddha-bhakata-charana-renu","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHyuddga-bgakata-01-03"},"head":{"canonical":"/ua/shiuddha-bhakata-charana-renu/","description":"Шюддга-бгаката — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Шюддга-бгаката. Шрīла Бгактівінод Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"shiuddha-bhakata-charana-renu"}}