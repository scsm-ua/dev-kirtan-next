{"build":"d2d3291@22/11/2026, 17:23:59","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166}],"nav":{"177":{"prev":{"path":"/ua/durlabha-manava-janma-labhiya-samsare/","title":"Дурлабга ма̄нава-джанма"},"next":{"path":"/ua/pita-varana-kali-pavana-gora/","title":"1. Піта-варана калі"}}},"song":{"meta":{"page":177,"translation":"no","first_line":"анья-абгіла̄ша чха̄ді ґʼяна карма паріхарі"},"title":["Анья-абгіла̄ша чха̄ді"],"author":["Шрīла Нароттам Да̄с Тха̄кур"],"verses":[{"number":"1","text":["анья-абгіла̄ша чха̄ді    ґʼяна карма паріхарі","    ка̄я мане корібо бгаджана","са̄дгу-санґе кришна-сева̄    на̄ пӯджібо девī-дева̄","    еі бгакті парама-ка̄рана"],"isLong":false},{"number":"2","text":["маха̄джанера джеі патха    та̄’те хо’бе анурата","    пӯрва̄пара корія віча̄ра","са̄дгана-смарана-лīла̄    іха̄те на̄ кара хела̄","    ка̄я мане корія сӯса̄ра"],"isLong":false},{"number":"3","text":["асат-санґа сада̄ тьяґа    чха̄да анья ґīта-ра̄ґа","    кармī ґʼянī паріхарі дӯре","кевала бгаката-санґа    према-катха̄-раса-ранґа","    лīла̄-катха̄ враджа-раса-пуре"],"isLong":false},{"number":"4","text":["джоґī ньясī кармī ґʼянī    анья-дева-пӯджака дгʼянī","    іха-лока дӯре паріхарі","карма дгарма духкха шока    джеба̄ тха̄ке анья джоґа","    чха̄ді’ бгаджа ґірівара-дга̄рī"],"isLong":false},{"number":"5","text":["тīртха-джа̄тра̄ парішрама    кевала-манера-бграма","    сарва-сіддгі ґовінда-чарана","дридга-вішва̄са хриде дгорі    мада-ма̄тсарʼя паріхарі","    сада̄ кара ананья бгаджана"],"isLong":false},{"number":"6","text":["кришна-бгакта санґа корі    кришна-бгакта санґа хері","    шраддга̄нвіта шравана-кīртана","арчана вандана дгʼяна    нава-бгакті маха̄-ґʼяна","    еі бгакті парама-ка̄рана"],"isLong":false},{"number":"7","text":["хрисīке ґовінда-сева̄    на̄ пӯджібо девī-дева̄","    еі то’ ананья-бгакті-катха̄","а̄ра джата упа̄ламбга    вішєша сакалі дамбга","    декхіте ла̄ґає мане вʼятха̄"],"isLong":false},{"number":"8","text":["дехе байсе ріпӯ-ґана    джатека індрія-ґана","    кехо ка̄ра ва̄дгʼя на̄хі хой","шюніле на̄ шюне ка̄на    джа̄ніле на̄ джа̄не пра̄на","    дадга̄іте на̄ па̄ре нішчой"],"isLong":false},{"number":"9","text":["ка̄ма кродга моха лобга","        мада ма̄тсарʼя дамбга-саха","    стха̄не стха̄не ніджӯкта корібо","а̄нанда корі хридой    ріпу’ корі’ пара̄джая","    ана̄ясе ґовінда бгаджібо"],"isLong":false},{"number":"10","text":["ка̄ма кришна-карма̄рпане    кродга бгакта-двеші-джане","    лобга са̄дгу-санґе харі-катха̄","моха ішта-ла̄бга-біне    мада кришна-ґуна-ґа̄не","    ніджӯкта корібо джатха̄ татха̄"],"isLong":false},{"number":"11","text":["аньятха̄ сватантра ка̄ма    анартха̄ді джа̄ра дга̄ма","    бгакті-патхе сада̄ дея бганґа","кіба̄ ба̄ коріте па̄ре    ка̄ма-кродга са̄дгакере","    джаді хой са̄дгу-джана̄ра санґа"],"isLong":false},{"number":"12","text":["кродга ба̄ на̄ коре кіба̄    кродга-тьяґа сада̄ діба̄","    лобга моха еі то’ катхана","чоя ріпӯ сада̄ хīна    корібо манер адгīна","    кришначандра корія смарана"],"isLong":false},{"number":"13","text":["а̄пані пала̄бе саба    шюнія ґовінда раба","    сімга-рабе джена корі-ґана","сакалі віпатті джа̄бе    маха̄нанда сӯкха па̄бе","    джа̄ра хой ека̄нта бгаджана"],"isLong":false},{"number":"14","text":["на̄ коріхо асат-чешта    ла̄бга пӯджа̄ пратіштха̄","    сада̄ чінта ґовінда-чарана","сакала санта̄па джа̄бе    пара̄нанда сукха па̄бе","    према-бгакті парама-ка̄рана"],"isLong":false},{"number":"15","text":["асат-крія кутіна̄ті    чха̄да анья паріпа̄тī","    анья деве на̄ коріхо раті","а̄пана а̄пана стха̄не    пірīті саба̄і та̄не","    бгакті-патхе падає біґаті"],"isLong":false},{"number":"16","text":["а̄пана бгаджана-патха    та̄хе хобо анӯрата","    ішта-дева-стха̄не-лīла̄-ґа̄на","найштхіка бгаджана еі    тома̄ре кохінӯ бга̄і","    ханума̄н та̄ха̄те прама̄на"],"isLong":false}],"resources":{"audio":[{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/anya-abhilasa","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Anya-abgіlasha-chhadі-01-02"},"head":{"canonical":"/ua/anya-abhilasha-chadi-jniana-karma-parihari/","description":"Анья-абгіла̄ша чха̄ді — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Нароттам Да̄с Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Анья-абгіла̄ша чха̄ді. Шрīла Нароттам Да̄с Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"anya-abhilasha-chadi-jniana-karma-parihari"}}