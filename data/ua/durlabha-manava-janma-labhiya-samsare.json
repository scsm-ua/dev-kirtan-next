anslation":"no","first_line":"дурлабга ма̄нава-джанма лабгія самса̄ре"},"title":["Дурлабга ма̄нава-джанма"],"author":["Шрīла Бгактівінод Тха̄кур"],"verses":[{"number":"1","text":["дурлабга ма̄нава-джанма лабгія самса̄ре","кришна на̄ бгаджіну духка кохібо ка̄ха̄ре?"],"isLong":false},{"number":"2","text":["‘самса̄р’ ‘самса̄р’, корі мічхе ґело ка̄л","ла̄бга на̄ коіло кічху, гатіло джаньджа̄л"],"isLong":false},{"number":"3","text":["кісера самса̄р еі чха̄яба̄джі пра̄й","іха̄те мамата̄ корі вритха̄ діна джа̄й"],"isLong":false},{"number":"4","text":["е дехо патана хо’ле кі робе а̄ма̄р?","кехо сукха на̄хі дібе путра паріба̄р"],"isLong":false},{"number":"5","text":["ґардабгер мата а̄мі корі парішрам","ка̄ра ла̄ґі’ ето корі, на̄ гучіло бграм"],"isLong":false},{"number":"6","text":["діна джа̄й мічха̄ ка̄дже, нішя нідра̄-вашє","на̄хі бга̄ві марана нікате а̄чхе босе"],"isLong":false},{"number":"7","text":["бга̄ло манда кха̄і, хері, парі, чінта̄-хīна","на̄хі бга̄ві, е дехо чха̄дібо кон діна"],"isLong":false},{"number":"8","text":["дехо-ґехо-калатра̄ді-чінта̄ абірата","джа̄ґічхе хридоє мор буддгі корі хото"],"isLong":false},{"number":"9","text":["ха̄й, ха̄й! на̄хі бга̄ві—анітья е саба","джīвана біґоте котха̄ рохібе вайбгава?"],"isLong":false},{"number":"10","text":["шмашяне шорīра мама подія рохібе","біханґа-патанґа та̄й біха̄ра корібе"],"isLong":false},{"number":"11","text":["куккур сриґа̄л соб а̄нандіта хо’є","махотсава корібе а̄ма̄р дехо ло’є"],"isLong":false},{"number":"12","text":["дже дехер еі ґаті, та̄ра ануґата","самса̄р-вайбгава а̄ро бондгу-джон джата"],"isLong":false},{"number":"13","text":["атаева ма̄я-моха чха̄ді буддгіма̄н","нітья-таттва кришна-бгакті коруна сандга̄н"],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.С. Ґовінда Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/kostya-netrebenko/16-durlabha-manava-janma-9","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/dur