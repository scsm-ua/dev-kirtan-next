{"build":"49908b2@26/11/2026, 08:56:03","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166}],"nav":{"149":{"prev":{"path":"/ua/e-ghora-samsare-podiya-manava/","title":"Е гора самсаре"},"next":{"path":"/ua/emona-durmati-samsara-bhitore/","title":"Дайньятміка̄"}}},"song":{"meta":{"page":149,"translation":"no","first_line":"душта мана! тумі кісера вайшнава?"},"title":["Вайшнава Ке?"],"author":["Шрīла Бгактісіддга̄нта Сарасватī Тха̄кур"],"subtitle":["“Who is a Real Vaiṣṇava?”"],"verses":[{"number":"1","text":["    душта мана!    тумі кісера вайшнава?","пратіштха̄ра торе,    нірджанера горе,","    тава ‘харіна̄ма’ кевала ‘кайтава’"],"isLong":false},{"number":"2","text":["джадера пратіштха̄,    шюкарер біштха̄,","    джа̄но на̄ кі та̄ха̄ ма̄яр вайбгава","канака ка̄мінī,    діваса-джа̄мінī,","    бга̄вія кі ка̄джа, анітья се саба"],"isLong":false},{"number":"3","text":["тома̄ра канака,    бгоґера джанака,","    канакера два̄ре севахо ма̄дгава","ка̄мінīр ка̄ма,    нахе тава дга̄ма,","    та̄ха̄р—ма̄ліка кевала джа̄дава"],"isLong":false},{"number":"4","text":["пратіштха̄шя-тару,    джада-ма̄я-мару,","    на̄ пела ра̄вана джуджгія ра̄гава","вайшнавī пратіштха̄,    та̄те кара ніштха̄,","    та̄ха̄ на̄ бгаджіле лабгібе раурава"],"isLong":false},{"number":"5","text":["харіджана-двеша,    пратістха̄шя-клешя,","    кара кено тобе та̄ха̄ра ґаурава","вайшнавер па̄чхе,    пратістха̄шя а̄чхе,","    та̄’те кабгу нахе анітья-вайбгава"],"isLong":false},{"number":"6","text":["се харі-самбандга,    шюнья-ма̄я-ґандга,","    та̄ха̄ кобгу ной джадер кайтава","пратіштха̄-чанда̄лī,    нірджаната̄-джа̄лі,","    убгає джа̄ніхо ма̄їка раурава"],"isLong":false},{"number":"7","text":["кīртана чха̄дібо,    пратіштха̄ ма̄ґібо,","    кі ка̄джа дгудія та̄дришя ґаурава","ма̄дгавендра пурī,    бга̄ва-горе чурі,","    на̄ коріло кобгу сада̄і джа̄набо"],"isLong":false},{"number":"8","text":["тома̄ра пратіштха̄,—    шюкарера біштха̄,","    та̄р-саха сама кабгу на̄ ма̄нава","матсарата̄-вашє,    тумі джада-расе,","    ма’джечо чха̄дія кīртана-сауштава"],"isLong":false},{"number":"9","text":["та̄і душта мана,    нірджана бгаджан,","    прача̄річо чхоле куйоґī-вайбгава","прабгу сана̄тане,    парама джатане,","    шікша̄ діло джа̄ха̄, чінто сеі саба"],"isLong":false},{"number":"10","text":["сеі дуті катха̄,    бгуло’ на̄ сарватха̄,","    учайх-сваре кара харі-на̄ма-рава","пхалґу а̄ро джукта,    баддга а̄ро мукта,","    кабгу на̄ бга̄віхо, ‘ека̄ка̄р’ саба"],"isLong":false},{"number":"11","text":["канака-ка̄мінī,    пратіштха̄-ба̄гінī,","    ча̄діяче джа̄ре, сеі то’ вайшнава","сеі ана̄сакта,    сеі шюддга-бгакта,","    самса̄ра татха̄ па̄й пара̄бгава"],"isLong":false},{"number":"12","text":["ятха̄-джоґʼя бгоґа,    на̄хі татха̄ роґа,","    ана̄сакта сеі, кі а̄ро кахабо","а̄сакті-рохіта,    самбандга-сохіто,","    вішоя-самӯха сакалі ма̄дгава"],"isLong":false},{"number":"13","text":["се джукта-вайра̄ґʼя,    та̄ха̄ то’ саубга̄ґʼя,","    та̄ха̄і джадете харір вайбгава","кīртане джа̄ха̄р,    пратіштха̄-самбга̄р,","    та̄ха̄р сампатті кевала кайтава"],"isLong":false},{"number":"14","text":["вішоя-мумукшу,    бгоґер бубгукшу,","    ду’є тьяджо мана, дуі авайшнава","кришнер самбандга,    апра̄крита-скандга,","    кобгу на̄хе та̄ха̄ джадер самбгава"],"isLong":false},{"number":"15","text":["ма̄ява̄дī джана,    кришнетара мана,","    мукта абгіма̄не се нінде вайшнава","вайшнавера да̄са,    тава бгакті-а̄шя,","    кено ва̄ да̄кічо нірджана-а̄хава"],"isLong":false},{"number":"16","text":["дже пхалґу-вайра̄ґī,    кохе нідже тьяґī,","    се на̄ па̄ре кобгу хоіте вайшнава","харі-пада чха̄ді’,    нірджаната̄ ба̄ді,","    лабгія кі пхол, пхалґу се вайбгава"],"isLong":false},{"number":"17","text":["ра̄дга̄-да̄сьє рохі,    чха̄ді бгоґа-ахі,","    пратіштха̄шя нахе кīртана-ґаурава","ра̄дга̄-нітья-джана,    та̄ха̄ чха̄ді мана,","    кено ва̄ нірджана-бгаджана-кайтава"],"isLong":false},{"number":"18","text":["враджа-ва̄сī-ґана,    прача̄рака-дгана,","    пратіштха̄-бгікшука та̄ра̄ нахе шява","пра̄на а̄чхе та̄ра,    се-хету прача̄ра,","    пратіштха̄шя-хīна-‘кришна-ґа̄тха̄’ саба"],"isLong":false},{"number":"19","text":["шрī-даїта-да̄са,    кīртанете а̄шя,","    кара учайх-сваре харіна̄ма рава","кīртана-прабга̄ве,    смарана свабга̄ве,","    се ка̄ле бгаджана-нірджана самбгава"],"isLong":false}],"resources":{"audio":[{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/dusta-mana-tumi-kisera","personSlug":"manasa-krishna-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/Vajshnava-Ke-01-02"},"head":{"canonical":"/ua/dushta-mana-tumi-kisera-vaishnava/","description":"Вайшнава Ке? — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактісіддга̄нта Сарасватī Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Вайшнава Ке?. “Who is a Real Vaiṣṇava?” | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"dushta-mana-tumi-kisera-vaishnava"}}