ext":["дгана-яувана-джīвана-ра̄джʼя-сукхам","а хі нітьям анукшана-на̄шя-парам","тьяджа ґра̄мʼя-катха̄-сакалам віпхалам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"3","text":["раманī-джана-санґа-сукхам ча сакхе","чараме бгая-дам пуруша̄ртха-харам","харі-на̄ма-судга̄-раса-матта-матір","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"4","text":["джада-ка̄вʼя-расо на хіквʼя-расах","калі-па̄вана-ґаура-расо хі расах","алам анья-катха̄дй-анушіланая","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"5","text":["вришабга̄ну-сута̄нвіта-ва̄ма-танум","ямуна̄-тата-на̄ґара-нанда-сутам","муралī-кала-ґīта-вінода-парам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"6","text":["харі-кīртана-мадгʼя-ґатам сва-джанайх","парівештіта-джамбунада̄бга-харім","ніджа-ґауда-джанайка-крипа̄-джаладгім","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"7","text":["ґіріра̄джа-сута̄-парівīта-ґрихам","нава-кханда-патім яті-чітта-харам","сура-санга-нутам пріяя сахітам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"8","text":["калі-куккура-мудґара-бга̄ва-дгарам","харі-на̄ма-махаушадга-да̄на-парам","патіта̄рта-даярдра-сумӯрті-дгарам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"9","text":["ріпу-ба̄ндгава-бгеда-віхīна-дая","яд абгīкшнам удеті мукха̄бджа-татау","там акришнам іха враджа-ра̄джа-сутам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"10","text":["іха чопанішат-паріґīта-вібгур","двіджа-ра̄джа-сутах пурата̄бга-харіх","ніджа-дга̄мані кхелаті бандгу-юто","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"11","text":["авата̄ра-варам паріпӯрна-калам","пара-таттвам іха̄тма-віла̄сам аям","враджа-дга̄ма-раса̄мбудгі-ґупта-расам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"12","text":["шруті-варна-дгана̄ді на ясья крипа̄-","джанане балавад-бгаджанена віна̄","там ахайтука-бга̄ва-патхена сакхе","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"13","text":["апі накра-ґатау храда-мадгʼя-ґатам","кам амочаяд а̄рта-джанам там аджам","авічінтья-балам шіва-калпа-тарум","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"14","text":["сурабгīндра-тапах парітушта-мана̄","вара-варина-дгаро харір а̄вірабгӯт","там аджасра-сукхам муні-дгайрʼя-харам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"15","text":["абгіла̄ша-чаям тад-абгеда-дгіям","ашюбгам ча шюбгам тьяджа сарвам іда","анукӯлатая прія-севаная","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"16","text":["харі-севака-севана-дгарма-паро","харі-на̄ма-раса̄мрита-па̄на-ратах","наті-дайнья-дая-пара-ма̄на-юто","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"17","text":["вада ядава ма̄дгава кришна харе","вада ра̄ма джана̄рдана кешява хе","вришабга̄нусута̄-прія-на̄тха сада̄","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"18","text":["вада ямуна-тīра-вана̄дрі-пате","вада ґокула-ка̄нана-пуньджа-раве","вада ра̄са-раса̄яна ґаура-харе","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"19","text":["чхала ґаура-ванам нава-кханда-маям","патха ґаура-хареш чаріта̄ні муда̄","лутха ґаура-пада̄нкіта-ґа̄нґа-татам","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false},{"number":"20","text":["смара ґаура-ґада̄дгара-келі-кала̄м","бгава ґаура-ґада̄дгара-пакша-чарах","шрину ґаура-ґада̄дгара-ча̄ру-катха̄м","бгаджа ґодрума-ка̄нана-куньджа-відгум"],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Р. Мадгусудан Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/madhusudan-maharaj-jadite","personSlug":"srila-b-r-madhusudan-maharaj"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":false,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrī-Godrumachandra-bgadzhanopadeshya-01-03"},"head":{"canonical":"/ua/yadi-te-hari-pada-saroja-sudha/","description":"Шрī Ґодрумачандра-бгаджанопадешя — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Шрī Ґодрумачандра-бгаджанопадешя. Шрīла Бгактівінод Тха̄кур (1893) | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"yadi-te-hari-pada-saroja-sudha"}}