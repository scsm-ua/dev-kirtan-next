{"build":"643119f@21/11/2026, 18:18:32","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Gaudija Gītandžalī","subtitle":"Vaišnavu dziesmas un lūgšanas","slug":"lv","sort_order":5,"songsCount":91},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166},{"title":"Pocket Kirtan Guide","subtitle":"Nabadwip, 2013","slug":"en-pe","language":"en","sort_order":8,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":80}],"nav":{"64":{"prev":{"path":"/ua/bhai-re-shorira-avidya-jal-jodendriya-tahe-kal/","title":"Шрī Праса̄да-сева̄я Ґīті"},"next":{"path":"/ua/jayare-jayare-jaya-gaura-sarasvati/","title":"Шрī Са̄расват-а̄раті"}}},"song":{"meta":{"page":64,"first_line":"(кіба) джая джая ґаура̄ча̄ндер а̄ротіко шобга̄","translator":"Alokananda Devi Dasi","version":"draft0"},"title":["Шрī Ґаура-а̄раті"],"author":["Шрīла Бгактівінод Тха̄кур"],"verses":[{"number":"1","text":["(кіба) джая джая ґаура̄ча̄ндер а̄ротіко шобга̄","        джа̄хнавī-тата-ване джаґамана-лобга̄","        (джаґа джанер мана-лобга̄)","        (ґаура̄нґер а̄роті шобга̄ джаґа джанер мана-лобга̄)","        (ніта̄і ґаура харібол)"],"translation":["Слава, слава прекрасному *араті* Шрі Ґаурачандри, яке відбувається у гаю на березі Ґанґи, адже воно вабить серця душ усього світу!"],"isLong":false},{"number":"2","text":["(кіба) дакшине ніта̄іча̄нд ба̄ме ґада̄дгара","        нікате адвайта шрīніва̄са чхатра-дгара"],"translation":["Праворуч від Господа Ґаурачандри — Нітьянанда, ліворуч — Ґададгар, подалі — Адвайта, а Шрівас тримає парасольку."],"isLong":false},{"number":"3","text":["(кіба) босіячхе ґаура̄ча̄нд ратна-сімга̄сане","        (ратна-сімга̄сана ало корере","        босіячхен ґаура̄ча̄нд ратна-сімга̄сане)","        а̄раті корена брахма̄ а̄ді-дева ґане","        (ґаура̄нґер а̄роті коре)","        (брахма̄ а̄ді-дева ґане ґаура̄нґер а̄роті коре)","        (ніта̄і ґаура харібол)"],"translation":["Господь Ґаурачандра сидить на троні, всіяному коштовним камінням. Брахма разом зі своїми відданими та рештою напівбогів, шанує Його."],"isLong":false},{"number":"4","text":["(кіба) нарахарі-а̄ді корі ча̄мара дгула̄я","        саньджая-мукунда-ва̄су-гоша-а̄ді ґа̄я"],"translation":["Нарахарі так само, як і інші, овіює Господа *чамарою*, а решта разом із Санджаєм, Мукундою, Васудевом Гошем співають."],"isLong":false},{"number":"5","text":["(кіба) шянкха ба̄дже ганта̄ ба̄дже ба̄дже карата̄ла","        мадгура мриданґа ба̄дже парама раса̄ла","        (мадгур мадгур мадгур ба̄дже)","        (ґаура̄нґер а̄роті ка̄ле мадгур мадгур мадгур ба̄дже)","        (шянкха ба̄дже ганта̄ ба̄дже мадгур мадгур мадгур ба̄дже)","        (мадгура мриданґа ба̄дже мадгур мадгур мадгур ба̄дже)","        (ніта̄і ґаура харібол)"],"translation":["Спів мушель, дзвоників, *каратал* та *мриданґ* зливається у пʼянкий передзвін. То дивовижно солодкий *кіртан*."],"isLong":false},{"number":"6","text":["(кіба) баху-коті чандра джіні вадана уджджвала","        ґала-дешє бона-ма̄ла̄ коре джгаламала","        (джгалмол джгалмол джгалмол коре)","        (ґаура ґоле бона пхулер ма̄ла̄ джгалмол джгалмол джгалмол коре)","        (ніта̄і ґаура харібол)"],"translation":["Лице Господа променіє мільйоном ясних місяців. А плетеничка з лісових квітів сяє на Його шиї."],"isLong":false},{"number":"7","text":["(кіба) шіва-шюка-на̄рада преме ґада-ґада","        бгакатівінода декхе ґора̄ра сампада"],"translation":["Шіва, Шюкадев та Нарада затинаються у нестямі від божественної любові. Такою Бгактівінодові постає слава Шрі Ґаурачанди."],"isLong":false},{"text":["    (еі ба̄р а̄ма̄й дая кара)","    (тха̄кура шрī бгактівінода еі ба̄р а̄ма̄й дая кара)","    (тха̄кура шрī сарасватī еі ба̄р а̄ма̄й дая кара)","    (патіт-па̄ван шрī ґурудев еі ба̄р а̄ма̄й дая кара)","    (сапа̄ршада ґаурахарі еі ба̄р а̄ма̄й дая кара)","    (ніта̄і ґаура харібол)"],"translation":["Цього разу, будь ласка, будь прихильним до мене, о Шріла Бгактівінод Тхакур, о Шріла Сарасваті Тхакур, о Ґурудев — рятівник негідних! О Ґаурахарі, я звертаюсь до Тебе та до усіх Твоїх наближених, будь ласка, обдаруйте мене своєю милістю."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.С. Ґовінда Дев-Ґосвамі Махарадж","embed_url":"https://soundcloud.com/bharatimaharaj/govinda-maharaj-kiba-jaya-jaya","personSlug":"srila-b-s-govinda-dev-goswami-maharaj"},{"title":"Навадвіпський храм","embed_url":"https://soundcloud.com/bharatimaharaj/navadwip-scsm-kiba-jaya-jaya","personSlug":"nabadwip-temple"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/sri-gaura-arati","personSlug":"manasa-krishna-prabhu"},{"title":"Сударшан Прабгу","embed_url":"https://soundcloud.com/bharatimaharaj/sudarshan-prabhu-sri-gaura","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrī-Gaura-aratі-02-22"},"head":{"canonical":"/ua/jaya-jaya-gaurachander-arotiko-shobha/","description":"Шрī Ґаура-а̄раті — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Шрī Ґаура-а̄раті. Шрīла Бгактівінод Тха̄кур | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"jaya-jaya-gaurachander-arotiko-shobha"}}