{"build":"49908b2@26/11/2026, 08:56:03","data":{"book":{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},"descriptions":[{"title":"Kirtan Guide","title_full_short":"Kīrtan Guide 12th Ed","subtitle":"London, Twelfth Edition, 2026","slug":"en","sort_order":1,"shortcuts":[{"icon":"clock","title":"The Daily Programme","slug":"003-programme"}],"audio":{"filter":{"by_title":["Srila B.S. Govinda Dev-Goswami Maharaj","Srila B.R. Sridhar Dev-Goswami Maharaj","Nabadwip temple","Kamal Krishna Prabhu","Manasa Krishna Prabhu"]}},"songsCount":194},{"title":"Гаудия Гитанджали","subtitle":"Cборник вайшнавских песен и молитв","slug":"ru","sort_order":2,"render":{"tg.contents.first_line":false,"tg.a-z.title.words":3},"songsCount":178},{"title":"Guía de Kīrtan","subtitle":"Edición Detallada. Con traducción palabra por palabra y explicación de estilo","slug":"es","sort_order":3,"songsCount":146},{"title":"Livro de Kirtan","subtitle":"Seva Ashram, Campos do Jordão","slug":"pt","language":"pt-BR","sort_order":4,"songsCount":112},{"title":"Gaudija Gītandžalī","subtitle":"Vaišnavu dziesmas un lūgšanas","slug":"lv","sort_order":5,"songsCount":91},{"title":"Ґаудія Ґітанджалі","subtitle":"Вайшнавський пісенник українскою мовою","slug":"ua","sort_order":6,"language":"uk","render":{"tg.contents.first_line":false,"tg.a-z.title.words":4},"songsCount":74},{"title":"Kirtan Guide","subtitle":"Chiang Mai English Edition, 2022","slug":"en-2022","sort_order":7,"hidden":false,"is_legacy":{"show_micro_thumbnail_on_main":true},"songsCount":166}],"nav":{"185/1":{"prev":{"path":"/ua/pita-varana-kali-pavana-gora/","title":"1. Піта-варана калі"},"next":{"path":"/ua/shri-krishna-kirtane-jodi-manasa-tohara/","title":"3. Шрī-Кришна-кīртане джоді"}}},"song":{"meta":{"page":"185/1","author":"Шрīла Бгактівінод Тха̄кур","translation":"auto","first_line":"туху дая-са̄ґара та̄раїте пра̄нī","version":"draft-v8","translator":"Alokananda Devi Dasi","alt_first_lines":["Шрī Шікша̄штакам – Пісня 2","на̄мна̄м ака̄рі бахудга̄ ніджа-сарва-шяктіс"]},"title":["Шрī Шікша̄штакам"],"author":["Шрі Чайтаньї Махапрабгу санскритом"],"subtitle":["Вірш 2"],"verses":[{"text":["на̄мна̄м ака̄рі бахудга̄ ніджа-сарва-шяктіс","татра̄рпіта̄ ніямітах смаране на ка̄лах","ета̄дриші тава крипа̄ бгаґаван мама̄пі","дурдайвам īдришям іха̄джані на̄нура̄ґах"],"translation":["«О мій Господи, Твоє Святе Імʼя дарує благо кожному. Ти маєш незліченну кількість Імен, таких як Крішна і Ґовінда, через які Ти являєш Себе. У Свої численні Святі Імена Ти милостиво вклав усю Свою духовну силу. Немає ніяких строгих правил, які б обмежували молитву до цих Імен часом та місцем. Зі Своєї безпричинної милості Ти зійшов у образі божественного звуку, але моє велике нещастя полягає в тому, що я не маю жодної прихильності до Твого Святого Імені».","---","*Пісня Шрīли Бгактівінода Тха̄кура бенгальською за мотивом цього вірша:*"],"isLong":false},{"number":"1","text":["туху дая-са̄ґара та̄раїте пра̄нī","на̄ма анека туя шікха̄олі а̄ні"],"translation":["О Господи, Ти є океан милості. Щоб визволити усі душі цього світу, Ти показав, як славити Твої незліченні Святі Імена."],"isLong":false},{"number":"2","text":["сакала шякаті деі на̄ме тоха̄ра̄","ґрахане ра̄кхолі на̄хі ка̄ла-віча̄ра̄"],"translation":["Ти вклав усю Свою силу у Своє Ім’я. І немає жодних правил щодо належного часу чи місця для повторення Святого Імені."],"isLong":false},{"number":"3","text":["шрī-на̄ма-чінта̄мані тоха̄рі сама̄на̄","бішве біла̄олі каруна̄-ніда̄на̄"],"translation":["Святе Імʼя — це коштовний камінь *чінтамані*, божественний філософський камінь. Твоє Імʼя не відрізняється від Тебе. Із милості до всіх душ Ти розповсюдив Своє Святе Ім’я по цілому всесвіту."],"isLong":false},{"number":"4","text":["туя дая айчана парама уда̄ра̄","атішоя манда на̄тха! бга̄ґа ха̄ма̄ра̄"],"translation":["Це Твоя милість, о Господи, Ти — надзвичайно добрий. Але я, о Господи, вкрай занепалий і нещасний."],"isLong":false},{"number":"5","text":["на̄хі джанамало на̄ме анура̄ґа мора","бгактівінода-чітта духкхе бібгора"],"translation":["Я ніколи не мав жодного потягу до Святих Імен. Тому серце Бгактівіноди сповнене смутку."],"isLong":false}],"resources":{"audio":[{"title":"Шріла Б.Н. Ачарʼя Махарадж","embed_url":"https://soundcloud.com/kostya-netrebenko/101-srisrisiksastakam2-1","personSlug":"srila-b-n-acharya-maharaj"},{"title":"Манаса Крішна Прабгу","embed_url":"https://soundcloud.com/huron/tuhu-doya-sagara","personSlug":"manasa-krishna-prabhu"},{"title":"Бгакті Лаліта Деві","embed_url":"https://soundcloud.com/bhakti-lalita-devi/tuhu-doya-sagara-tarayite-prani","personSlug":"bhakti-lalita-devi"},{"title":"Сударшан Прабгу","embed_url":"https://soundcloud.com/jayasri-sound/song-2-tuhu-doya-sagara-mp3","personSlug":"sudarshan-prabhu"}]},"hasWbw":false,"hasVersesText":true,"hasVersesTranslations":true,"hasLongVerses":false,"fullInlineWbw":false},"telegraphUrl":"https://telegra.ph/SHrī-SHіkshashtakam-01-03-3"},"head":{"canonical":"/ua/tuhu-daya-sagara-tarayite-prani/","description":"Шрī Шікша̄штакам — вайшнавська пісня з текстом, українським перекладом і послівним розбором. Автор — Шрīла Бгактівінод Тха̄кур. Зі збірки «Ґаудія Ґітанджалі».","title":"Шрī Шікша̄штакам. Вірш 2 | Kirtan Site"},"kind":"song","route":{"kind":"item","bookId":"ua","slug":"tuhu-daya-sagara-tarayite-prani"}}